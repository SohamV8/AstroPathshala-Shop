{% doc %}
  @prompt
    create a marquee section in top of the table 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    padding: 0 {{ block.settings.item_spacing }}px;
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    margin: 0 {{ block.settings.item_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-marquee-separator-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.separator_size }}px;
    height: {{ block.settings.separator_size }}px;
    background-color: {{ block.settings.separator_color }};
    border-radius: 50%;
    margin: 0 {{ block.settings.item_spacing }}px;
  }

  .ai-marquee-container-{{ ai_gen_id }}:hover .ai-marquee-wrapper-{{ ai_gen_id }} {
    animation-play-state: {% if block.settings.pause_on_hover %}paused{% else %}running{% endif %};
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<marquee-block-{{ ai_gen_id }} class="ai-marquee-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <div class="ai-marquee-content-{{ ai_gen_id }}">
      {% for i in (1..block.settings.repeat_count) %}
        {% if block.settings.text_1 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_1 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_2 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_2 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_3 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_3 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_4 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_4 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_5 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_5 }}</span>
          {% if block.settings.show_separator and i < block.settings.repeat_count %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
    
    <div class="ai-marquee-content-{{ ai_gen_id }}" aria-hidden="true">
      {% for i in (1..block.settings.repeat_count) %}
        {% if block.settings.text_1 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_1 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_2 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_2 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_3 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_3 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_4 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_4 }}</span>
          {% if block.settings.show_separator %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
        
        {% if block.settings.text_5 != blank %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ block.settings.text_5 }}</span>
          {% if block.settings.show_separator and i < block.settings.repeat_count %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}"></span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</marquee-block-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustSpeed();
      }

      adjustSpeed() {
        const wrapper = this.querySelector('.ai-marquee-wrapper-{{ ai_gen_id }}');
        if (wrapper) {
          const contentWidth = wrapper.scrollWidth / 2;
          const speed = {{ block.settings.animation_speed }};
          wrapper.style.animationDuration = speed + 's';
        }
      }
    }

    customElements.define('marquee-block-{{ ai_gen_id }}', MarqueeBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Marquee",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text 1",
      "default": "Free shipping on orders over ₹500"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text 2",
      "default": "New arrivals every week"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text 3",
      "default": "Shop now and save 20%"
    },
    {
      "type": "text",
      "id": "text_4",
      "label": "Text 4"
    },
    {
      "type": "text",
      "id": "text_5",
      "label": "Text 5"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#262626"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show separator",
      "default": true
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 4,
      "max": 12,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "repeat_count",
      "label": "Repeat count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}