{% doc %}
  @prompt
    Please show payment method icon
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-payment-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-payment-icons-container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.icon_spacing }}px;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-payment-icons-heading-{{ ai_gen_id }} {
    width: 100%;
    text-align: {{ block.settings.alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-payment-icons-list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.icon_spacing }}px;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-payment-icon-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-payment-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: auto;
    display: block;
    opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-payment-icon-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-payment-icons-container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-payment-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-payment-icons-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<payment-icons-{{ ai_gen_id }} class="ai-payment-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-payment-icons-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
