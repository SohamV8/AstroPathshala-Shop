<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <!-- Google Tag Manager (deferred so it does not block first paint) -->
    <script>
      window.addEventListener('load', () => {
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-PPJ3659G');
      });
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    <meta name="msapplication-TileColor" content="#000000">
    {%- comment -%}
      Canonical stays Shopify-native to avoid route regressions.
      Query-heavy utility/filter/search URLs are controlled with robots directives below.
    {%- endcomment -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- liquid
      assign lux_academy_on_page = false
      if request.path contains '/pages/astrology-course' or page.handle == 'astrology-course' or page.handle == 'astrology-courses'
        assign lux_academy_on_page = true
      endif

      capture academy_page_url
        render 'lux-academy-page-url'
      endcapture
      assign academy_page_url = academy_page_url | strip

      assign academy_courses_redirect = false
      if request.path == '/pages/courses' or request.path == '/pages/courses/'
        assign academy_courses_redirect = true
      endif

      assign academy_has_correct_template = false
      if template.suffix == 'astrology-course' or template.suffix == 'courses'
        assign academy_has_correct_template = true
      endif

      assign academy_courses_fallback = false
      if lux_academy_on_page and academy_courses_redirect == false
        if request.page_type == '404'
          assign academy_courses_fallback = true
        elsif request.page_type == 'page' and academy_has_correct_template == false
          assign academy_courses_fallback = true
        endif
      endif

      assign academy_show_page = false
      if lux_academy_on_page and academy_courses_redirect == false
        if academy_courses_fallback or academy_has_correct_template
          assign academy_show_page = true
        endif
      endif

      if academy_show_page or academy_courses_redirect
        assign page_title = 'Astrology Courses'
        if page.title != blank
          assign page_title = page.title
        endif
        assign page_description = 'Explore 38+ premium Vedic astrology, Lal Kitab, KP, palmistry, numerology and vastu courses. Live classes and bundles at Astro Pathshala Academy.'
      endif

      assign should_noindex = false
      if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == '404'
        assign should_noindex = true
      endif
      if academy_show_page
        assign should_noindex = false
      endif
      if request.path contains '/account' or request.path contains '/orders' or request.path contains '/checkout' or request.path contains '/challenge'
        assign should_noindex = true
      endif
    -%}
    {%- if should_noindex -%}
      <meta name="robots" content="noindex,follow,noarchive">
    {%- else -%}
      <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    {%- endif -%}

    {%- liquid
      assign brand_logo_asset = 'astro-pathshala-Logo-Black-New.png'
      assign brand_logo_asset_url = brand_logo_asset | asset_url
    -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="16x16" href="{{ settings.favicon | image_url: width: 16, height: 16 }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="icon" type="image/png" sizes="512x512" href="{{ settings.favicon | image_url: width: 512, height: 512 }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
      <link rel="shortcut icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="mask-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}" color="#000000">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="any" href="{{ brand_logo_asset_url }}">
      <link rel="apple-touch-icon" href="{{ brand_logo_asset_url }}">
      <link rel="shortcut icon" type="image/png" href="{{ brand_logo_asset_url }}">
      <link rel="mask-icon" href="{{ brand_logo_asset_url }}" color="#000000">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
    >

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- if academy_show_page -%}
      {% render 'lux-academy-page-meta' %}
      <link rel="preload" href="{{ 'section-lux-academy.css' | asset_url }}" as="style">
    {%- endif -%}

    {% render 'meta-tags' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      (() => {
        if (!['127.0.0.1', 'localhost'].includes(window.location.hostname)) return;

        const PRIVATE_TOKEN_PATH = '/sf_private_access_tokens';

        if (window.fetch) {
          const nativeFetch = window.fetch.bind(window);
          window.fetch = (resource, init) => {
            const url = typeof resource === 'string' ? resource : resource?.url;
            if (url) {
              const parsedUrl = new URL(url, window.location.origin);
              if (parsedUrl.pathname === PRIVATE_TOKEN_PATH) {
                return Promise.resolve(
                  new Response('{}', {
                    status: 200,
                    headers: { 'content-type': 'application/json' },
                  })
                );
              }
            }

            return nativeFetch(resource, init);
          };
        }

        const removeShopAppFrames = () => {
          document.querySelectorAll('iframe[src*="shop.app"]').forEach((node) => node.remove());
        };

        removeShopAppFrames();
        const shopAppObserver = new MutationObserver(removeShopAppFrames);
        shopAppObserver.observe(document.documentElement, { childList: true, subtree: true });
        window.addEventListener('load', () => shopAppObserver.disconnect(), { once: true });
      })();
    </script>

    {%- comment -%} Organization schema for Google Knowledge Graph & rich results {%- endcomment -%}
    {%- liquid
      assign org_logo_url = brand_logo_asset_url
      if settings.favicon != blank
        assign org_logo_url = settings.favicon | image_url: width: 512, height: 512
      endif
      assign org_logo_prefix = org_logo_url | slice: 0, 2
      if org_logo_prefix == '//'
        assign org_logo_url = org_logo_url | prepend: 'https:'
      endif
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | json }},
        "logo": {{ org_logo_url | json }},
        "image": {{ org_logo_url | json }}{%- if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank -%},
        "sameAs": [
          {%- assign sep = '' -%}
          {%- if settings.social_facebook_link != blank -%}{{ sep }}{{ settings.social_facebook_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_instagram_link != blank -%}{{ sep }}{{ settings.social_instagram_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}{{ sep }}{{ settings.social_youtube_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_twitter_link != blank -%}{{ sep }}{{ settings.social_twitter_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}{{ sep }}{{ settings.social_pinterest_link | json }}{%- assign sep = ',' -%}{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}{{ sep }}{{ settings.social_tiktok_link | json }}{%- endif -%}
        ]{%- endif -%}
      }
    </script>

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      {% for scheme in settings.color_schemes -%}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        {% if scheme.settings.background_gradient != empty %}
          --gradient-background: {{ scheme.settings.background_gradient }};
        {% else %}
          --gradient-background: {{ scheme.settings.background }};
        {% endif %}

        {% liquid
          assign background_color = scheme.settings.background
          assign background_color_brightness = background_color | color_brightness
          if background_color_brightness <= 26
            assign background_color_contrast = background_color | color_lighten: 50
          elsif background_color_brightness <= 65
            assign background_color_contrast = background_color | color_lighten: 5
          else
            assign background_color_contrast = background_color | color_darken: 25
          endif
        %}

        --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
        --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
        --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
        --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
        --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
      }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), 0.75);
        background-color: rgb(var(--color-background));
      }

