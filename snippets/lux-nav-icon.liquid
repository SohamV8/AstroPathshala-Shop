{%- comment -%}
  Maps menu link to lux-icon name for bottom navigation.
  Accepts: link (link object)
{%- endcomment -%}
{%- liquid
  assign icon_name = 'sparkles'
  assign h = link.handle | downcase
  assign t = link.title | downcase

  if h == 'home' or t contains 'home'
    assign icon_name = 'home'
  elsif h contains 'course' or t contains 'course' or t contains 'e-book' or t contains 'ebook'
    assign icon_name = 'book-open'
  elsif h contains 'consult' or t contains 'consult'
    assign icon_name = 'message-circle'
  elsif h contains 'report' or t contains 'report' or t contains 'kundli'
    assign icon_name = 'file-text'
  elsif h contains 'gem' or t contains 'gem' or t contains 'rudraksha' or t contains 'stone'
    assign icon_name = 'diamond'
  elsif h contains 'remedy' or t contains 'remedy' or h contains 'lal-kitab' or t contains 'lal kitab'
    assign icon_name = 'leaf'
  elsif h contains 'puja' or t contains 'puja' or h contains 'pooja' or t contains 'pooja'
    assign icon_name = 'flame'
  elsif h contains 'combo'
    assign icon_name = 'layers'
  elsif h contains 'blog' or t contains 'blog' or t contains 'insight' or t contains 'workshop'
    assign icon_name = 'newspaper'
  elsif h contains 'contact' or t contains 'contact' or t contains 'about'
    assign icon_name = 'map-pin'
  elsif h contains 'cart' or t contains 'cart'
    assign icon_name = 'shopping-bag'
  elsif h contains 'wishlist' or t contains 'wishlist'
    assign icon_name = 'heart'
  elsif h contains 'account' or t contains 'account' or t contains 'login'
    assign icon_name = 'user'
  elsif h contains 'search'
    assign icon_name = 'search'
  endif
-%}
{%- render 'lux-icon', name: icon_name, class: class -%}
