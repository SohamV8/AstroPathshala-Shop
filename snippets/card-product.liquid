{% comment %}
  Luxury product card.

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} 'square' | 'portrait' | 'adapt'. Default 'portrait'
  - image_shape: {String} Optional image mask (kept for theme compatibility)
  - show_secondary_image: {Boolean} Hover-swap to second image
  - show_vendor: {Boolean} Show vendor / collection eyebrow
  - show_rating: {Boolean} Show product rating
  - extend_height: {Boolean} (kept for theme compatibility)
  - lazy_load: {Boolean} Default true
  - skip_styles: {Boolean} Suppress stylesheet imports for batched grids
  - quick_add: {String} 'standard' | 'bulk' | false
  - section_id: {String}
  - placeholder_image: {String}
{% endcomment %}

{%- unless skip_styles -%}
  {{ 'premium-cards.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
  {{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- liquid
  assign aspect = media_aspect_ratio | default: 'portrait'
  assign aspect_ratio = '4 / 5'
  assign img_display_w = 600
  assign img_display_h = 750
  if aspect == 'square'
    assign aspect_ratio = '1 / 1'
    assign img_display_h = 600
  elsif aspect == 'adapt' and card_product.featured_media != blank
    assign raw_ratio = card_product.featured_media.aspect_ratio | default: 1
    if raw_ratio < 0.72
      assign aspect_ratio = '3 / 4'
      assign img_display_h = 800
    elsif raw_ratio > 1.15
      assign aspect_ratio = '1 / 1'
      assign img_display_h = 600
    else
      assign aspect_ratio = raw_ratio | append: ' / 1'
      assign img_display_h = 675
    endif
  endif

  assign card_id = section_id | default: 'card'
  if card_product
    assign card_id = card_id | append: '-' | append: card_product.id
  endif
-%}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign on_sale = false
    if card_product.compare_at_price > card_product.price and card_product.available
      assign on_sale = true
    endif

    assign discount_percent = 0
    if on_sale
      assign price_diff = card_product.compare_at_price | minus: card_product.price
      assign discount_percent = price_diff | times: 100.0 | divided_by: card_product.compare_at_price | round
    endif

    assign primary_image = card_product.featured_media
    assign secondary_image = card_product.media[1]

    assign show_quick_add = false
    if quick_add == 'standard' or quick_add == 'bulk'
      assign show_quick_add = true
    endif

    assign needs_options_modal = false
    assign first_variant = card_product.selected_or_first_available_variant
    if card_product.variants_count > 1
      assign needs_options_modal = true
    endif
    if first_variant.quantity_rule.min > 1
      assign needs_options_modal = true
    endif
    if first_variant.quantity_rule.max != null
      assign needs_options_modal = true
    endif
    if first_variant.quantity_rule.increment > 1
      assign needs_options_modal = true
    endif

    assign rating_value = card_product.metafields.reviews.rating.value
    assign rating_count = card_product.metafields.reviews.rating_count
    assign show_rating_block = false
    if show_rating and rating_value != blank
      assign show_rating_block = true
    endif
  -%}

  <div
    class="lux-card-wrapper card-wrapper product-card-wrapper"
    data-product-card
    data-product-id="{{ card_product.id }}"
    data-product-handle="{{ card_product.handle }}"
  >
    <article class="lux-card card card--standard{% if image_shape and image_shape != 'default' %} lux-card--shape lux-card--shape-{{ image_shape }}{% endif %}">
      <div class="lux-card__media-frame" style="--lux-card-ratio: {{ aspect_ratio }};">
        <a
          class="lux-card__media-link full-unstyled-link"
          href="{{ card_product.url }}"
          aria-labelledby="lux-title-{{ card_id }}"
          tabindex="0"
        >
          {%- if primary_image != blank -%}
            <img
              class="lux-card__img lux-card__img--primary"
              src="{{ primary_image | image_url: width: 600 }}"
              srcset="
                {%- if primary_image.width >= 220 -%}{{ primary_image | image_url: width: 220 }} 220w,{%- endif -%}
                {%- if primary_image.width >= 360 -%}{{ primary_image | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if primary_image.width >= 540 -%}{{ primary_image | image_url: width: 540 }} 540w,{%- endif -%}
                {%- if primary_image.width >= 720 -%}{{ primary_image | image_url: width: 720 }} 720w,{%- endif -%}
                {%- if primary_image.width >= 900 -%}{{ primary_image | image_url: width: 900 }} 900w,{%- endif -%}
                {%- if primary_image.width >= 1080 -%}{{ primary_image | image_url: width: 1080 }} 1080w,{%- endif -%}
                {{ primary_image | image_url }} {{ primary_image.width }}w
              "
              sizes="(min-width: 1280px) 320px, (min-width: 990px) 26vw, (min-width: 750px) 32vw, 46vw"
              alt="{{ primary_image.alt | default: card_product.title | escape }}"
              width="{{ img_display_w }}"
              height="{{ img_display_h }}"
              loading="{% if lazy_load == false %}eager{% else %}lazy{% endif %}"
              decoding="async"
            >
            {%- if show_secondary_image and secondary_image != blank -%}
              <img
                class="lux-card__img lux-card__img--secondary"
                src="{{ secondary_image | image_url: width: 600 }}"
                srcset="
                  {%- if secondary_image.width >= 360 -%}{{ secondary_image | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if secondary_image.width >= 540 -%}{{ secondary_image | image_url: width: 540 }} 540w,{%- endif -%}
                  {%- if secondary_image.width >= 720 -%}{{ secondary_image | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if secondary_image.width >= 900 -%}{{ secondary_image | image_url: width: 900 }} 900w,{%- endif -%}
                  {{ secondary_image | image_url }} {{ secondary_image.width }}w
                "
                sizes="(min-width: 1280px) 320px, (min-width: 990px) 26vw, (min-width: 750px) 32vw, 46vw"
                alt=""
                width="{{ img_display_w }}"
                height="{{ img_display_h }}"
                loading="lazy"
                decoding="async"
                aria-hidden="true"
              >
            {%- endif -%}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'lux-card__img lux-card__img--placeholder' }}
          {%- endif -%}
        </a>

        <div class="lux-card__badges" aria-hidden="true">
          {%- if card_product.available == false -%}
            <span class="lux-badge lux-badge--soldout">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif on_sale -%}
            {%- if discount_percent > 0 -%}
              <span class="lux-badge lux-badge--sale">−{{ discount_percent }}%</span>
            {%- else -%}
              <span class="lux-badge lux-badge--sale">{{ 'products.product.on_sale' | t }}</span>
            {%- endif -%}
          {%- endif -%}
          {%- if card_product.tags contains 'new' or card_product.tags contains 'New' -%}
            <span class="lux-badge lux-badge--new">New</span>
          {%- elsif card_product.tags contains 'bestseller' or card_product.tags contains 'Bestseller' -%}
            <span class="lux-badge lux-badge--best">Bestseller</span>
          {%- elsif card_product.tags contains 'limited' or card_product.tags contains 'Limited' -%}
            <span class="lux-badge lux-badge--limited">Limited</span>
          {%- endif -%}
        </div>

        <button
          type="button"
          class="lux-card__wishlist"
          data-wishlist
          data-product-id="{{ card_product.id }}"
          aria-label="Add {{ card_product.title | escape }} to wishlist"
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M12 20s-7-4.4-7-9.6A4 4 0 0 1 9 6c1.7 0 2.7.9 3 1.7C12.3 6.9 13.3 6 15 6a4 4 0 0 1 4 4.4c0 5.2-7 9.6-7 9.6Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        {%- if show_quick_add -%}
          <div class="lux-card__actions">
            {%- assign product_form_id = 'lux-quick-' | append: card_id -%}
            {%- if quick_add == 'bulk' and card_product.variants_count == 1 and card_product.available -%}
              <quick-add-bulk
                data-min="{{ first_variant.quantity_rule.min }}"
                id="quick-add-bulk-{{ first_variant.id }}-{{ section_id }}"
                class="lux-card__bulk"
                data-index="{{ first_variant.id }}"
              >
                {% render 'quantity-input', variant: first_variant, min: 0 %}
              </quick-add-bulk>
            {%- elsif card_product.available == false -%}
              <button class="lux-action lux-action--quick is-disabled" type="button" disabled>
                {{ 'products.product.sold_out' | t }}
              </button>
            {%- elsif needs_options_modal or quick_add == 'bulk' -%}
              <modal-opener data-modal="#LuxQuickAdd-{{ card_product.id }}-{{ section_id }}">
                <button
                  id="{{ product_form_id }}-submit"
                  type="button"
                  class="lux-action lux-action--quick"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit lux-title-{{ card_id }}"
                  data-product-url="{{ card_product.url }}"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  </svg>
                  <span>{{ 'products.product.choose_options' | t }}</span>
                </button>
              </modal-opener>
            {%- else -%}
              <product-form data-section-id="{{ section_id }}">
                {%- form 'product',
                  card_product,
                  id: product_form_id,
                  class: 'lux-card__form',
                  novalidate: 'novalidate',
                  data-type: 'add-to-cart-form'
                -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ first_variant.id }}"
                    class="product-variant-id"
                  >
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="lux-action lux-action--quick"
                    aria-labelledby="{{ product_form_id }}-submit lux-title-{{ card_id }}"
                    aria-live="polite"
                    data-sold-out-message="true"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M5 6h2.2l1.4 9.4h9.2L19.5 8H8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="10" cy="19" r="1.4"/>
                      <circle cx="17" cy="19" r="1.4"/>
                    </svg>
                    <span>{{ 'products.product.add_to_cart' | t }}</span>
                    <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                    {%- render 'loading-spinner' -%}
                  </button>
                {%- endform -%}
              </product-form>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="lux-card__body">
        {%- if show_vendor and card_product.vendor != blank -%}
          <p class="lux-card__vendor">
            <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
            {{ card_product.vendor | escape }}
          </p>
        {%- endif -%}

        <h3 class="lux-card__title card__heading" id="lux-title-{{ card_id }}">
          <a class="lux-card__title-link full-unstyled-link" href="{{ card_product.url }}">
            {{ card_product.title | escape }}
          </a>
        </h3>

        {%- if show_rating_block -%}
          {%- liquid
            assign rating_decimal = 0
            assign decimal = rating_value.rating | modulo: 1
            if decimal >= 0.3 and decimal <= 0.7
              assign rating_decimal = 0.5
            elsif decimal > 0.7
              assign rating_decimal = 1
            endif
          -%}
          <div class="lux-card__rating">
            <span
              class="lux-card__stars rating-star"
              role="img"
              aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_value.scale_max }}"
              style="--rating: {{ rating_value.rating | floor }}; --rating-max: {{ rating_value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
            ></span>
            {%- if rating_count and rating_count > 0 -%}
              <span class="lux-card__rating-text">
                <span aria-hidden="true">{{ rating_value }}</span>
                <span class="lux-card__rating-count">({{ rating_count }})</span>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="lux-card__price-row">
          {% render 'price', product: card_product, price_class: 'lux-card__price', show_compare_at_price: true %}
          {%- if on_sale and discount_percent > 0 -%}
            <span class="lux-card__save">Save {{ discount_percent }}%</span>
          {%- endif -%}
        </div>
      </div>
    </article>

    {%- if show_quick_add and needs_options_modal -%}
      <quick-add-modal
        id="LuxQuickAdd-{{ card_product.id }}-{{ section_id }}"
        class="quick-add-modal"
      >
        <div
          role="dialog"
          aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
          aria-modal="true"
          class="quick-add-modal__content global-settings-popup"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ card_product.id }}"
            type="button"
            class="quick-add-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
        </div>
      </quick-add-modal>
    {%- endif -%}
  </div>

{%- else -%}
  <div class="lux-card-wrapper card-wrapper product-card-wrapper">
    <article class="lux-card card card--standard">
      <div class="lux-card__media-frame" style="--lux-card-ratio: {{ aspect_ratio }};">
        <div class="lux-card__media-link">
          {%- if placeholder_image -%}
            {{ placeholder_image | placeholder_svg_tag: 'lux-card__img lux-card__img--placeholder' }}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'lux-card__img lux-card__img--placeholder' }}
          {%- endif -%}
        </div>
      </div>
      <div class="lux-card__body">
        <h3 class="lux-card__title card__heading">
          <a class="lux-card__title-link full-unstyled-link" role="link" aria-disabled="true">
            {{ 'onboarding.product_title' | t }}
          </a>
        </h3>
        <div class="lux-card__price-row">
          {% render 'price', placeholder: true, price_class: 'lux-card__price', show_compare_at_price: true %}
        </div>
      </div>
    </article>
  </div>
{%- endif -%}

<script>
  (() => {
    if (window.__luxWishlistInit) return;
    window.__luxWishlistInit = true;
    const KEY = 'lux:wishlist';
    const load = () => {
      try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch { return new Set(); }
    };
    const save = (set) => {
      try { localStorage.setItem(KEY, JSON.stringify([...set])); } catch {}
    };
    const sync = () => {
      const set = load();
      document.querySelectorAll('[data-wishlist]').forEach((btn) => {
        const id = btn.dataset.productId;
        const active = id && set.has(id);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('is-active', !!active);
      });
    };
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-wishlist]');
      if (!btn) return;
      e.preventDefault();
      const id = btn.dataset.productId;
      if (!id) return;
      const set = load();
      if (set.has(id)) set.delete(id); else set.add(id);
      save(set);
      sync();
      btn.dispatchEvent(new CustomEvent('lux:wishlist:change', {
        bubbles: true,
        detail: { productId: id, active: set.has(id) }
      }));
    }, { passive: false });
    document.addEventListener('DOMContentLoaded', sync);
    sync();
  })();
</script>
