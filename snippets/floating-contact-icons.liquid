<style>
  .floating-contact-icons {
    position: fixed;
    right: 1.8rem;
    bottom: 2rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .floating-contact-icons__btn {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .floating-contact-icons__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  }

  .floating-contact-icons__btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .floating-contact-icons__btn svg {
    width: 2.8rem;
    height: 2.8rem;
  }

  .floating-contact-icons__btn--call {
    background: #4285f4;
  }

  .floating-contact-icons__btn--whatsapp {
    background: #25d366;
  }

  @media screen and (max-width: 749px) {
    .floating-contact-icons {
      right: 1.2rem;
      bottom: 1.2rem;
      gap: 1rem;
    }

    .floating-contact-icons__btn {
      width: 5.4rem;
      height: 5.4rem;
    }

    .floating-contact-icons__btn svg {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

