{%- comment -%}
  Resolves one banner URL by slot index (1-based). Uses shared manager pipeline.
  Params: slot — 1, 2, 3, …
{%- endcomment -%}
{%- liquid
  assign banner_slot = slot | default: 1 | plus: 0
  assign slot_index = banner_slot | minus: 1
  assign resolved_url = ''
-%}

{%- capture banner_bundle -%}
  {%- render 'product-banner-manager' -%}
{%- endcapture -%}
{%- assign banner_bundle = banner_bundle | strip -%}
{%- assign paths_raw = banner_bundle | split: '~~~' | first | strip -%}

{%- if paths_raw != blank -%}
  {%- assign banner_paths = paths_raw | split: '|' -%}
  {%- assign banner_file = banner_paths[slot_index] | strip -%}
  {%- if banner_file != blank -%}
    {%- assign resolved_url = banner_file | asset_url -%}
  {%- endif -%}
{%- endif -%}
{{- resolved_url -}}
