{%- comment -%}
  Smart product FAQ mapper
  - Maps FAQs from uploaded DOCX to the correct product pages only
  - Uses handle/title/tag/type keyword matching
  - Renders accessible accordion + FAQPage JSON-LD
{%- endcomment -%}
{%- capture faq_key_capture -%}{%- render 'product-faq-key', product: product -%}{%- endcapture -%}
{%- assign faq_key = faq_key_capture | strip -%}
{%- assign has_faq = false -%}
{%- if faq_key != blank -%}
  {%- assign has_faq = true -%}
{%- endif -%}

{%- if has_faq -%}
