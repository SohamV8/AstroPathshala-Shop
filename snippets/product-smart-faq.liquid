      {{ faq_items_markup }}
    </div>
  </section>

  {%- capture faq_schema_items -%}
    {%- assign faq_blocks = faq_items_markup | split: '</details>' -%}
    {%- assign faq_sep = '' -%}
    {%- for block in faq_blocks -%}
      {%- if block contains '<summary>' and block contains 'product-smart-faq__answer' -%}
        {%- assign q = block | split: '<summary>' | last | split: '</summary>' | first | strip_html | strip -%}
        {%- assign a = block | split: 'product-smart-faq__answer"><p>' | last | split: '</p>' | first | strip_html | strip -%}
        {%- if q != blank and a != blank -%}
          {{ faq_sep }}{"@type":"Question","name":{{ q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a | json }}}}
          {%- assign faq_sep = ',' -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if faq_schema_items != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{{ faq_schema_items }}]
      }
    </script>
  {%- endif -%}

  <style>
    .product-smart-faq{margin-top:clamp(24px,4vw,48px)}
    .product-smart-faq__wrap{max-width:980px;margin:0 auto;padding:clamp(18px,2.8vw,28px);border:1px solid rgba(17,17,17,.08);border-radius:18px;background:#fff}
    .product-smart-faq__heading{margin:0 0 12px;font-size:clamp(1.4rem,2.4vw,2rem);line-height:1.2;letter-spacing:-.02em}
    .product-smart-faq__item{border-top:1px solid rgba(17,17,17,.08)}
    .product-smart-faq__item:first-of-type{border-top:0}
    .product-smart-faq__item summary{list-style:none;cursor:pointer;padding:14px 0;font-size:1rem;font-weight:600;line-height:1.5}
    .product-smart-faq__item summary::-webkit-details-marker{display:none}
    .product-smart-faq__answer{padding:0 0 14px}
    .product-smart-faq__answer p{margin:0;color:rgba(20,20,20,.84);font-size:.97rem;line-height:1.65}
    @media (max-width:749px){
      .product-smart-faq__item summary{padding:13px 0;font-size:.96rem}
      .product-smart-faq__answer p{font-size:.94rem}
    }
  </style>
{%- endif -%}
