{%- comment -%}
  Lux Icon Library
  ----------------------------------------------------------------------
  Lucide-inspired, hand-tuned SVGs. Single source of truth for icons.

  Usage:
    {% render 'lux-icon', name: 'search' %}
    {% render 'lux-icon', name: 'whatsapp', class: 'lux-cta__icon', size: 22 %}

  Params:
    name  (string, required)  Icon name. See list below.
    class (string, optional)  Extra CSS class on the <svg>.
    size  (number, optional)  Pixel width+height. Falls back to CSS.
    title (string, optional)  Accessible label (use only for stand-alone icons
                              not labelled by aria-label on a parent button).

  Conventions:
    - viewBox 0 0 24 24, stroke-based, stroke-width 1.75
    - aria-hidden="true" by default (icons are presentational; the parent
      button/link carries aria-label).
    - currentColor everywhere so themes/states control color via CSS.
{%- endcomment -%}
{%- liquid
  assign cls = class | default: ''
  assign cls = 'lux-svg ' | append: cls | strip
  assign sz = size | default: ''
  assign attrs = ''
  if sz != ''
    assign attrs = attrs | append: ' width="' | append: sz | append: '" height="' | append: sz | append: '"'
  endif
  assign a11y = ' aria-hidden="true" focusable="false"'
  if title != blank
    assign a11y = ' role="img" aria-label="' | append: title | append: '" focusable="false"'
  endif
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg class="{{ cls }}"{{ attrs }} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"{{ a11y }}>
