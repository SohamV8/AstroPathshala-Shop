{% comment %}
  Editorial article card — optimized images, single clean markup, no duplicate content.

  Accepts:
  - blog: {Object} optional, for comments label
  - article: {Object}
  - media_aspect_ratio: {Number} used when media_height is 'adapt' or blank (fallback ratio)
  - media_height: {String} adapt | small | medium | large
  - show_image: {Boolean}
  - show_date: {Boolean}
  - show_author: {Boolean}
  - show_excerpt: {Boolean}
  - show_reading_time: {Boolean} optional, default true
  - show_badge: {Boolean}
  - lazy_load: {Boolean} default true
  - image_sizes: {String} optional responsive sizes attribute
  - featured_layout: {Boolean} larger typographic treatment
{% endcomment %}

{%- if article and article != empty -%}
  {%- liquid
    assign height_mode = media_height | default: 'medium'
    assign show_rt = true
    if show_reading_time == false
      assign show_rt = false
    endif

    assign words = article.content | strip_html | split: ' ' | size
    assign read_mins = words | times: 1 | divided_by: 200
    if read_mins < 1
      assign read_mins = 1
    endif

    assign alt_fallback = article.title | escape
    if article.image and article.image.alt != blank
      assign alt_text = article.image.alt | escape
    else
      assign alt_text = alt_fallback
    endif

    assign resp_sizes = image_sizes | default: '(min-width: 1200px) min(400px, 28vw), (min-width: 750px) min(50vw, 480px), calc(100vw - 2.4rem)'
  -%}

  <article
    class="editorial-post-card{% if featured_layout %} editorial-post-card--featured{% endif %}"
    data-article-card
  >
    <div class="editorial-post-card__inner">
      {%- if show_image and article.image -%}
        <div
          class="editorial-post-card__media editorial-post-card__media--{{ height_mode }}"
          {% if height_mode == 'adapt' %}
            style="aspect-ratio: {{ article.image.aspect_ratio }};"
          {% endif %}
        >
          <a
            href="{{ article.url }}"
            class="editorial-post-card__media-hit"
            tabindex="-1"
            aria-hidden="true"
          >
            <span class="visually-hidden">{{ article.title | escape }}</span>
          </a>
          <div class="editorial-post-card__img-wrap">
            <img
              srcset="
                {%- if article.image.width >= 200 -%}{{ article.image | image_url: width: 200 }} 200w,{%- endif -%}
                {%- if article.image.width >= 400 -%}{{ article.image | image_url: width: 400 }} 400w,{%- endif -%}
                {%- if article.image.width >= 600 -%}{{ article.image | image_url: width: 600 }} 600w,{%- endif -%}
                {%- if article.image.width >= 800 -%}{{ article.image | image_url: width: 800 }} 800w,{%- endif -%}
                {%- if article.image.width >= 1000 -%}{{ article.image | image_url: width: 1000 }} 1000w,{%- endif -%}
                {%- if article.image.width >= 1200 -%}{{ article.image | image_url: width: 1200 }} 1200w,{%- endif -%}
                {{ article.image | image_url }} {{ article.image.width }}w
              "
              src="{{ article.image | image_url: width: 800 }}"
              sizes="{{ resp_sizes }}"
              alt="{{ alt_text }}"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              decoding="async"
              class="editorial-post-card__img"
              {% if lazy_load == false %}
                loading="eager"
                fetchpriority="high"
              {% else %}
                loading="lazy"
              {% endif %}
            >
          </div>
        </div>
      {%- endif -%}

      <div class="editorial-post-card__body">
        {%- if show_badge -%}
          <p class="editorial-post-card__eyebrow">
            <span class="editorial-post-card__badge">{{ 'blogs.article.blog' | t }}</span>
          </p>
        {%- endif -%}

        <h3 class="editorial-post-card__title">
          <a href="{{ article.url }}" class="editorial-post-card__title-link">{{ article.title | escape }}</a>
        </h3>

        <div class="editorial-post-card__meta">
          {%- if show_date -%}
            <span class="editorial-post-card__time">{{ article.published_at | time_tag: format: 'date' }}</span>
          {%- endif -%}
          {%- if show_author and article.author != blank -%}
            <span class="editorial-post-card__author">{{ article.author | escape }}</span>
          {%- endif -%}
          {%- if show_rt -%}
            <span class="editorial-post-card__read" aria-label="{{ read_mins }} minute read">
              {{ read_mins }} min read
            </span>
          {%- endif -%}
        </div>

        {%- if show_excerpt -%}
          {%- if article.excerpt != blank or article.content != blank -%}
            <p class="editorial-post-card__excerpt">
              {%- if article.excerpt != blank -%}
                {{ article.excerpt | strip_html | truncatewords: 28 }}
              {%- else -%}
                {{ article.content | strip_html | truncatewords: 28 }}
              {%- endif -%}
            </p>
          {%- endif -%}
        {%- endif -%}

        {%- if blog != blank and blog.comments_enabled? and article.comments_count > 0 -%}
          <p class="editorial-post-card__comments">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </article>
{%- endif -%}
