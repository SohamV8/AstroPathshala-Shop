{%- liquid
  assign title = product.title | downcase
  assign gem_key = ''
  if title contains 'zircon'
    assign gem_key = 'zircon'
  elsif title contains 'tourmaline'
    assign gem_key = 'tourmaline'
  elsif title contains 'tiger eye' or title contains 'tiger-eye'
    assign gem_key = 'tiger-eye'
  elsif title contains 'citrine'
    assign gem_key = 'citrine'
  elsif title contains 'sulemani hakik' or title contains 'sulemani'
    assign gem_key = 'sulemani-hakik'
  elsif title contains 'peridot'
    assign gem_key = 'peridot'
  elsif title contains 'moonstone'
    assign gem_key = 'moonstone'
  elsif title contains 'mahe mariam' or title contains 'mariam'
    assign gem_key = 'mahe-mariam'
  elsif title contains 'lapis lazuli' or title contains 'lapis'
    assign gem_key = 'lapis-lazuli'
  elsif title contains 'kaka neeli' or title contains 'iolite'
    assign gem_key = 'kaka-neeli'
  endif
-%}

