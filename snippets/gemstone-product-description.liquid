  <div class="gemstone-product-description quick-add-hidden" data-gemstone-description="{{ gem_key }}">
    <style>
      .gemstone-product-description {
        margin-top: 2rem;
        display: grid;
        gap: 0.9rem;
      }
      .gemstone-product-description details {
        border: 1px solid rgba(17, 17, 17, 0.1);
        border-radius: 1.2rem;
        background: #fffefc;
        overflow: clip;
        transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
      }
      .gemstone-product-description details[open] {
        border-color: rgba(212, 175, 55, 0.32);
        box-shadow: 0 8px 24px rgba(17, 17, 17, 0.05);
      }
      .gemstone-product-description summary {
        list-style: none;
        cursor: pointer;
        padding: 1.35rem 1.4rem;
        font-family: Inter, var(--font-heading-family), sans-serif;
        font-size: clamp(1.45rem, 0.2vw + 1.35rem, 1.62rem);
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #111111;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: background 220ms ease;
      }
      .gemstone-product-description summary::-webkit-details-marker { display: none; }
      .gemstone-product-description summary:hover {
        background: rgba(255, 248, 238, 0.7);
      }
      .gemstone-product-description summary:focus-visible {
        outline: 2px solid rgba(212, 175, 55, 0.8);
        outline-offset: -2px;
      }
      .gemstone-product-description summary::after {
        content: '';
        width: 1rem;
        height: 1rem;
        border-right: 2px solid #8a8a8a;
        border-bottom: 2px solid #8a8a8a;
        transform: rotate(45deg) translateY(-1px);
        transition: transform 220ms ease, border-color 220ms ease;
      }
      .gemstone-product-description details[open] > summary::after {
        transform: rotate(-135deg) translateX(-1px);
        border-color: #d4af37;
      }
      .gemstone-product-description__content {
        padding: 0.15rem 1.4rem 1.4rem;
        animation: gemDropdown 240ms ease;
      }
      .gemstone-product-description__content ul {
        margin: 0;
        padding-left: 1.7rem;
      }
      .gemstone-product-description__content li {
        margin: 0.5rem 0;
        line-height: 1.72;
        color: #4b4b4b;
      }
      @keyframes gemDropdown {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @media (prefers-reduced-motion: reduce) {
        .gemstone-product-description details,
        .gemstone-product-description summary::after,
        .gemstone-product-description__content { transition: none !important; animation: none !important; }
      }
      @media screen and (max-width: 749px) {
        .gemstone-product-description {
          gap: 0.7rem;
        }
        .gemstone-product-description summary {
          padding: 1.2rem 1.1rem;
          font-size: clamp(1.35rem, 0.7vw + 1.2rem, 1.5rem);
        }
        .gemstone-product-description__content {
          padding: 0.1rem 1.1rem 1.2rem;
        }
      }
    </style>

    <details open>
      <summary>Product Specifications</summary>
      <div class="gemstone-product-description__content rte">{{ specs_html }}</div>
    </details>
    <details>
      <summary>Key Benefits</summary>
      <div class="gemstone-product-description__content rte">{{ benefits_html }}</div>
    </details>
    <details>
      <summary>Who Should Wear</summary>
      <div class="gemstone-product-description__content rte">{{ who_html }}</div>
    </details>
  </div>
{%- endif -%}
