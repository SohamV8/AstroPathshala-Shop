{% doc %}
  @prompt
    Create a variant selector with label "Select carat weight" above it. Show 3 pill buttons: 5 carat, 10 carat, 15 carat. Active button has blue border, blue text, light blue background. Inactive buttons have gray border and dark text.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carat-selector-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-carat-selector__label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 12px;
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: 500;
  }

  .ai-carat-selector__options-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-carat-selector__button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    background-color: {{ block.settings.inactive_bg_color }};
    color: {{ block.settings.inactive_text_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.inactive_border_color }};
    flex: 1;
    min-width: 80px;
    text-align: center;
  }

  .ai-carat-selector__button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-carat-selector__button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_bg_color }};
    color: {{ block.settings.active_text_color }};
    border-color: {{ block.settings.active_border_color }};
  }

  .ai-carat-selector__input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
{% endstyle %}

<carat-selector-{{ ai_gen_id }} class="ai-carat-selector-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <label class="ai-carat-selector__label-{{ ai_gen_id }}">
    {{ block.settings.label_text }}
  </label>
  
  <div class="ai-carat-selector__options-{{ ai_gen_id }}">
    {% for option in product.options_with_values %}
      {% if option.name == block.settings.option_name %}
        {% for value in option.values %}
          <label>
            <input
              type="radio"
              name="carat-option-{{ ai_gen_id }}"
              value="{{ value | escape }}"
              class="ai-carat-selector__input-{{ ai_gen_id }}"
              {% if option.selected_value == value %}checked{% endif %}
            >
            <span class="ai-carat-selector__button-{{ ai_gen_id }} {% if option.selected_value == value %}active{% endif %}">
              {{ value }}
            </span>
          </label>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </div>
</carat-selector-{{ ai_gen_id }}>

<script>
  (function() {
    class CaratSelector{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.inputs = this.querySelectorAll('.ai-carat-selector__input-{{ ai_gen_id }}');
        this.buttons = this.querySelectorAll('.ai-carat-selector__button-{{ ai_gen_id }}');
        
        this.inputs.forEach((input, index) => {
          input.addEventListener('change', () => {
            this.updateActiveState(index);
            this.updateProductVariant(input.value);
          });
          
          this.buttons[index].addEventListener('click', () => {
            input.checked = true;
            input.dispatchEvent(new Event('change'));
          });
        });
      }

      updateActiveState(activeIndex) {
        this.buttons.forEach((button, index) => {
          if (index === activeIndex) {
            button.classList.add('active');
          } else {
            button.classList.remove('active');
          }
        });
      }

      updateProductVariant(value) {
        const form = this.closest('form') || document.querySelector('form[action*="/cart/add"]');
        if (!form) return;

        const optionName = '{{ block.settings.option_name }}';
        const select = form.querySelector(`select[name="options[${optionName}]"]`);
        
        if (select) {
          select.value = value;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
    }

    customElements.define('carat-selector-{{ ai_gen_id }}', CaratSelector{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Carat weight selector",
  "settings": [
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Select carat weight"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "label": "Label font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#262626"
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "text",
      "id": "option_name",
      "label": "Product option name",
      "default": "Weight"
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Gap between buttons",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Active button"
    },
    {
      "type": "color",
      "id": "active_bg_color",
      "label": "Background color",
      "default": "#e3f2fd"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Text color",
      "default": "#1976d2"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Border color",
      "default": "#1976d2"
    },
    {
      "type": "header",
      "content": "Inactive button"
    },
    {
      "type": "color",
      "id": "inactive_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "inactive_text_color",
      "label": "Text color",
      "default": "#262626"
    },
    {
      "type": "color",
      "id": "inactive_border_color",
      "label": "Border color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Carat weight selector"
    }
  ]
}
{% endschema %}
