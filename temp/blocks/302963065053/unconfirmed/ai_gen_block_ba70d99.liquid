{% doc %}
  @prompt
    Add a small label above the product title with a shield icon and text "CERTIFIED NATURAL GEMSTONE" in blue uppercase letters with letter spacing.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cert-label-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-cert-label__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.label_color }};
  }

  .ai-cert-label__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-cert-label-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<certification-label-{{ ai_gen_id }}
  class="ai-cert-label-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <svg
    class="ai-cert-label__icon-{{ ai_gen_id }}"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
    <path d="M9 12l2 2 4-4"></path>
  </svg>
  <span class="ai-cert-label__text-{{ ai_gen_id }}">
    {{ block.settings.label_text }}
  </span>
</certification-label-{{ ai_gen_id }}>

<script>
  (function() {
    class CertificationLabel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('certification-label-{{ ai_gen_id }}', CertificationLabel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Certification label",
  "settings": [
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Certified Natural Gemstone"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#1e40af"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Certification label"
    }
  ]
}
{% endschema %}
