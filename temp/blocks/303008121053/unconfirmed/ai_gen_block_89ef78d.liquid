{% doc %}
  @prompt
    Create a clean "Text with Icons" section for the product page that displays three trust/shipping badges in a horizontal row: 1) Free Shipping with a shipping/truck icon, 2) Cash on Delivery with a cash/wallet icon, and 3) Ships in 3-4 Days with a calendar/clock icon. The section should match the existing theme's typography, colors, and spacing — use CSS variables or theme font/color settings where possible. Keep the design minimal and elegant, with small icons above or beside each label. Should fit naturally within the product page layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-badges-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-trust-badges__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.badge_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-trust-badges__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
    text-align: center;
  }

  .ai-trust-badges__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-trust-badges__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-trust-badges__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-trust-badges__container-{{ ai_gen_id }} {
      justify-content: center;
      gap: {{ block.settings.badge_spacing | times: 0.8 }}px;
    }

    .ai-trust-badges__item-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_text_gap | times: 0.8 }}px;
    }

    .ai-trust-badges__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-trust-badges__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-trust-badges-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-badges__container-{{ ai_gen_id }}">
    {% if block.settings.show_badge_1 %}
      <div class="ai-trust-badges__item-{{ ai_gen_id }}">
        <div class="ai-trust-badges__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <p class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</p>
      </div>
    {% endif %}

    {% if block.settings.show_badge_2 %}
      <div class="ai-trust-badges__item-{{ ai_gen_id }}">
        <div class="ai-trust-badges__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </div>
        <p class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_2_text }}</p>
      </div>
    {% endif %}

    {% if block.settings.show_badge_3 %}
      <div class="ai-trust-badges__item-{{ ai_gen_id }}">
        <div class="ai-trust-badges__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <p class="ai-trust-badges__text-{{ ai_gen_id }}">{{ block.settings.badge_3_text }}</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "checkbox",
      "id": "show_badge_1",
      "label": "Show badge 1",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Text",
      "default": "Free Shipping"
    },
    {
      "type": "header",
      "content": "Badge 2"
    },
    {
      "type": "checkbox",
      "id": "show_badge_2",
      "label": "Show badge 2",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Text",
      "default": "Cash on Delivery"
    },
    {
      "type": "header",
      "content": "Badge 3"
    },
    {
      "type": "checkbox",
      "id": "show_badge_3",
      "label": "Show badge 3",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Text",
      "default": "Ships in 3-4 Days"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Icon position",
      "options": [
        {
          "value": "column",
          "label": "Above text"
        },
        {
          "value": "row",
          "label": "Beside text"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "badge_spacing",
      "label": "Space between badges",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Space between icon and text",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#262626"
    }
  ],
  "presets": [
    {
      "name": "Trust badges"
    }
  ]
}
{% endschema %}
