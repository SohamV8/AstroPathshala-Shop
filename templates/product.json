ult.innerHTML = \"❌ Not Available\";\n            result.style.color = \"red\";\n        }\n\n    } catch (error) {\n        result.innerHTML = \"⚠️ Error checking pincode\";\n        result.style.color = \"red\";\n    }\n}\n</script>"
