    {%- comment -%} CONTACT FORM {%- endcomment -%}
    <div class="acp-form-wrap">
      <div class="acp-form-title">Send Us a Message</div>
      <div class="acp-form-sub">Fill in the form below and we'll get back to you within 24 hours.</div>

      {%- form 'contact', id: 'acp-contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="acp-success" style="display:block;">
            <div class="acp-success-icon">&#10003;</div>
            <div class="acp-success-title">Message Sent!</div>
            <div class="acp-success-desc">Thank you for reaching out. We'll get back to you within 24 hours.</div>
          </div>
        {%- else -%}
          <div class="acp-form">
            <div class="acp-form-row">
              <div class="acp-field">
                <label class="acp-label" for="contact-name">Your Name *</label>
                <input class="acp-input" type="text" id="contact-name" name="contact[name]" placeholder="Rahul Sharma" required>
              </div>
              <div class="acp-field">
                <label class="acp-label" for="contact-phone">Phone Number</label>
                <input class="acp-input" type="tel" id="contact-phone" name="contact[phone]" placeholder="+91 98765 43210">
              </div>
            </div>
            <div class="acp-field">
              <label class="acp-label" for="contact-email">Email Address *</label>
              <input class="acp-input" type="email" id="contact-email" name="contact[email]" placeholder="rahul@email.com" required>
            </div>
            <div class="acp-field">
              <label class="acp-label" for="contact-subject">What is your query about?</label>
              <select class="acp-select" id="contact-subject" name="contact[subject]">
                <option value="">Select a topic</option>
                <option value="Gemstone Query">Gemstone Query</option>
                <option value="Lal Kitaab Remedy">Lal Kitaab Remedy</option>
                <option value="E-Book Query">E-Book Query</option>
                <option value="Order Issue">Order Issue</option>
                <option value="Lab Certificate">Lab Certificate</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="acp-field">
              <label class="acp-label" for="contact-body">Your Message *</label>
              <textarea class="acp-textarea" id="contact-body" name="contact[body]" placeholder="Tell us how we can help you..." required></textarea>
            </div>
            <button type="submit" class="acp-submit">Send Message &#8594;</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  {%- comment -%} MAP {%- endcomment -%}
  <div class="acp-map-section">
    <div class="acp-map-header">
      <div>
        <div class="acp-map-label">Find Us</div>
        <div class="acp-map-title">Our Location</div>
      </div>
      <div class="acp-map-address">
        <strong>Astro PathShala</strong>
        {{ section.settings.address | default: '6-C, Block C, Old DLF Colony, Sector 14, Gurugram, Haryana 122007' }}
      </div>
    </div>
    <div class="acp-map-wrap">
      {%- if section.settings.map_embed != blank -%}
        {{ section.settings.map_embed }}
      {%- else -%}
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3464.307283629338!2d77.04732265547196!3d28.472047980437214!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390d198fa3f1b1e7%3A0x6c50eccf3e518447!2sAstro%20Pathshala!5e0!3m2!1sen!2sin!4v1774169991184!5m2!1sen!2sin"
          width="100%" height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Astro Pathshala Location">
        </iframe>
      {%- endif -%}
      <div class="acp-map-overlay">
        <div class="acp-map-overlay-name">Astro PathShala</div>
        <div class="acp-map-overlay-addr">{{ section.settings.address | default: '6-C, Block C, Old DLF Colony, Sector 14, Gurugram, Haryana 122007' }}<br>{{ section.settings.phone | default: '+91 98765 43210' }}</div>
        <a href="https://www.google.com/maps/search/?api=1&query=6-C+Block+C+Old+DLF+Colony+Sector+14+Gurugram+Haryana+122007" target="_blank" class="acp-map-directions">Get Directions &#8594;</a>
      </div>
    </div>
  </div>

  {%- comment -%} FAQ SECTION {%- endcomment -%}
  <div class="acp-faq">
    <div class="acp-faq-header">
      <span class="acp-faq-label">Quick Answers</span>
      <div style="font-family:var(--font-heading);font-size:36px;color:var(--black);font-weight:500;">Frequently Asked Questions</div>
    </div>
    <div class="acp-faq-grid">
      <div class="acp-faq-item" onclick="toggleFaq(this)">
        <div class="acp-faq-q">Are your gemstones certified? <span class="acp-faq-arrow">+</span></div>
        <div class="acp-faq-a">Yes, every gemstone comes with a lab certification from a trusted gemological laboratory. The certificate confirms it is 100% natural and untreated.</div>
      </div>
      <div class="acp-faq-item" onclick="toggleFaq(this)">
        <div class="acp-faq-q">How do I receive my e-book after purchase? <span class="acp-faq-arrow">+</span></div>
        <div class="acp-faq-a">As soon as your payment is confirmed, you will receive an email with a download link. The PDF can be downloaded instantly and read on any device.</div>
      </div>
      <div class="acp-faq-item" onclick="toggleFaq(this)">
        <div class="acp-faq-q">How long does gemstone delivery take? <span class="acp-faq-arrow">+</span></div>
        <div class="acp-faq-a">We ship within 24 hours of order confirmation. Delivery takes 3–7 business days across India depending on your location.</div>
      </div>
      <div class="acp-faq-item" onclick="toggleFaq(this)">
        <div class="acp-faq-q">Can I return a gemstone if I am not satisfied? <span class="acp-faq-arrow">+</span></div>
        <div class="acp-faq-a">Yes, we offer a 7-day easy return policy for gemstones. The stone must be in its original condition with the lab certificate. E-books are non-refundable once downloaded.</div>
      </div>
      <div class="acp-faq-item" onclick="toggleFaq(this)">
        <div class="acp-faq-q">How do I know which gemstone is right for me? <span class="acp-faq-arrow">+</span></div>
        <div class="acp-faq-a">The right gemstone depends on your birth chart (Kundali) and the planetary positions. You can WhatsApp us your birth details and our expert will suggest the right stone for you.</div>
      </div>
      <div class="acp-faq-item" onclick="toggleFaq(this)">
        <div class="acp-faq-q">Do you offer Cash on Delivery (COD)? <span class="acp-faq-arrow">+</span></div>
        <div class="acp-faq-a">Yes, COD is available for gemstone orders across India. E-books require prepayment as they are digital products delivered instantly.</div>
      </div>
    </div>
  </div>

  </div>

<script>
function toggleFaq(el){
  el.classList.toggle('open');
}
</script>

