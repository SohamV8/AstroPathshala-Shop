    { "type": "text", "id": "hours", "label": "Business hours", "default": "Monday – Saturday, 10am–7pm IST" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "6-C, Block C, Old DLF Colony, Sector 14, Gurugram, Haryana 122007" },
