      <div class="acp-info-label">Our Details</div>
      <div class="acp-info-title">We'd love to hear from you</div>
      <div class="acp-info-items">
        <div class="acp-info-item">
          <div class="acp-info-icon">&#9990;</div>
          <div>
            <div class="acp-info-item-title">Phone & WhatsApp</div>
            <div class="acp-info-item-val">
              <a href="tel:{{ section.settings.phone | default: '+919876543210' }}">{{ section.settings.phone | default: '+91 98765 43210' }}</a>
            </div>
          </div>
        </div>
        <div class="acp-info-item">
          <div class="acp-info-icon">&#9993;</div>
          <div>
            <div class="acp-info-item-title">Email</div>
            <div class="acp-info-item-val">
              <a href="mailto:{{ section.settings.email | default: 'support@astropathshala.com' }}">{{ section.settings.email | default: 'support@astropathshala.com' }}</a>
            </div>
          </div>
        </div>
        <div class="acp-info-item">
          <div class="acp-info-icon">&#9677;</div>
          <div>
            <div class="acp-info-item-title">Business Hours</div>
            <div class="acp-info-item-val">{{ section.settings.hours | default: 'Monday – Saturday<br>10:00 AM – 7:00 PM IST' }}</div>
          </div>
        </div>
        <div class="acp-info-item">
          <div class="acp-info-icon">&#128205;</div>
          <div>
            <div class="acp-info-item-title">Address</div>
            <div class="acp-info-item-val">{{ section.settings.address | default: '6-C, Block C, Old DLF Colony, Sector 14, Gurugram, Haryana 122007' }}</div>
          </div>
        </div>
      </div>
      <div class="acp-divider"></div>
      <div class="acp-social-title">Follow Us</div>
