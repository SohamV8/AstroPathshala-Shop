{% comment %}
  Astro PathShala — Contact Us Page
  File: sections/astro-contact.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.acp{font-family:var(--font-body);color:var(--black);background:transparent;}
.acp *{box-sizing:border-box;}

/* NAV */
.acp-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;min-height:80px;position:sticky;top:0;z-index:100;position:relative;}
.acp-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.acp-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.acp-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.acp-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.acp-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.acp-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.acp-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.acp-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.acp-nav-icon:hover{color:var(--black);}
.acp-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.acp-cart-btn:hover{background:var(--gold);}
.acp-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.acp-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.acp-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.acp-mob.open{display:block;}
.acp-mob ul{list-style:none;}
.acp-mob ul li{border-bottom:1px solid var(--border);}
.acp-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}

/* BREADCRUMB */
.acp-crumb{padding:14px 48px;background:var(--cream);border-bottom:1px solid var(--border);font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px;}
.acp-crumb a{color:var(--muted);text-decoration:none;}
.acp-crumb a:hover{color:var(--gold);}
.acp-crumb-sep{color:var(--border);}
.acp-crumb-cur{color:var(--gold);font-weight:500;}

/* PAGE HEADER */
.acp-header{padding:56px 48px 48px;text-align:center;border-bottom:1px solid var(--border);}
.acp-header-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:flex;align-items:center;justify-content:center;gap:10px;}
.acp-header-label::before,.acp-header-label::after{content:'';width:24px;height:1px;background:var(--gold);}
.acp-header-title{font-family:var(--font-heading);font-size:48px;font-weight:500;color:var(--black);line-height:1.1;margin-bottom:14px;}
.acp-header-desc{font-size:14px;color:var(--muted);font-weight:300;line-height:1.75;max-width:520px;margin:0 auto;}

/* MAIN GRID */
.acp-main{display:grid;grid-template-columns:1fr 1.4fr;gap:0;min-height:500px;}

/* INFO PANEL */
.acp-info{background:var(--dark);padding:56px 48px;}
.acp-info-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:flex;align-items:center;gap:10px;}
.acp-info-label::before{content:'';width:20px;height:1px;background:var(--gold-lt);}
.acp-info-title{font-family:var(--font-heading);font-size:34px;color:var(--gold-pale);font-weight:500;line-height:1.2;margin-bottom:32px;}
.acp-info-items{display:flex;flex-direction:column;gap:28px;}
.acp-info-item{display:flex;gap:18px;align-items:flex-start;}
.acp-info-icon{width:44px;height:44px;border-radius:50%;background:rgba(184,134,11,0.15);border:1px solid rgba(184,134,11,0.3);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.acp-info-item-title{font-size:13px;font-weight:500;color:var(--gold-pale);margin-bottom:4px;letter-spacing:0.3px;}
.acp-info-item-val{font-size:14px;color:var(--gold-lt);font-weight:300;line-height:1.6;}
.acp-info-item-val a{color:var(--gold-lt);text-decoration:none;}
.acp-info-item-val a:hover{color:var(--gold-pale);}
.acp-divider{height:1px;background:rgba(184,134,11,0.15);margin:32px 0;}
.acp-social-title{font-size:10px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;}
.acp-social-links{display:flex;gap:12px;}
.acp-social-link{width:40px;height:40px;border-radius:50%;border:1px solid rgba(184,134,11,0.3);display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--gold-lt);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.acp-social-link:hover{border-color:var(--gold);color:var(--gold-pale);}

/* CONTACT FORM */
.acp-form-wrap{padding:56px 48px;background:transparent;}
.acp-form-title{font-family:var(--font-heading);font-size:30px;color:var(--black);font-weight:500;margin-bottom:8px;}
.acp-form-sub{font-size:13px;color:var(--muted);font-weight:300;margin-bottom:36px;line-height:1.6;}
.acp-form{display:flex;flex-direction:column;gap:20px;}
.acp-form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.acp-field{display:flex;flex-direction:column;gap:6px;}
.acp-label{font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);}
.acp-input{padding:12px 14px;border:1px solid var(--border);background:var(--cream);font-size:13px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;transition:border-color 0.2s;width:100%;}
.acp-input:focus{border-color:var(--gold);}
.acp-textarea{padding:12px 14px;border:1px solid var(--border);background:var(--cream);font-size:13px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;transition:border-color 0.2s;width:100%;resize:vertical;min-height:130px;line-height:1.6;}
.acp-textarea:focus{border-color:var(--gold);}
.acp-select{padding:12px 14px;border:1px solid var(--border);background:var(--cream);font-size:13px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;cursor:pointer;width:100%;}
.acp-select:focus{border-color:var(--gold);}
.acp-submit{background:var(--black);color:var(--ivory);border:none;padding:14px 36px;font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);transition:background 0.2s;align-self:flex-start;}
.acp-submit:hover{background:var(--gold);}
.acp-success{display:none;background:var(--cream);border:1px solid var(--border);border-radius:4px;padding:20px 24px;text-align:center;}
.acp-success-icon{font-size:32px;margin-bottom:10px;}
.acp-success-title{font-family:var(--font-heading);font-size:22px;color:var(--black);margin-bottom:6px;}
.acp-success-desc{font-size:13px;color:var(--muted);font-weight:300;}

/* MAP */
.acp-map-section{border-top:1px solid var(--border);}
.acp-map-header{padding:40px 48px 28px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px;background:transparent;}
.acp-map-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;display:flex;align-items:center;gap:10px;}
.acp-map-label::before{content:'';width:20px;height:1px;background:var(--gold);}
.acp-map-title{font-family:var(--font-heading);font-size:32px;color:var(--black);font-weight:500;}
.acp-map-address{font-size:13px;color:var(--muted);font-weight:300;line-height:1.7;text-align:right;max-width:280px;}
.acp-map-address strong{color:var(--black);font-weight:500;display:block;margin-bottom:4px;}
.acp-map-wrap{position:relative;width:100%;height:420px;background:var(--cream);border-top:1px solid var(--border);}
.acp-map-wrap iframe{width:100%;height:100%;border:none;display:block;}
.acp-map-overlay{position:absolute;bottom:24px;left:48px;background:transparent;border:1px solid var(--border);border-radius:4px;padding:16px 20px;max-width:260px;box-shadow:0 4px 16px rgba(26,18,8,0.08);}
.acp-map-overlay-name{font-family:var(--font-heading);font-size:18px;color:var(--black);font-weight:500;margin-bottom:4px;}
.acp-map-overlay-addr{font-size:12px;color:var(--muted);font-weight:300;line-height:1.6;margin-bottom:12px;}
.acp-map-directions{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:500;letter-spacing:0.8px;text-transform:uppercase;color:var(--gold);text-decoration:none;border-bottom:1px solid var(--border);padding-bottom:1px;transition:border-color 0.2s;}
.acp-map-directions:hover{border-color:var(--gold);}

/* FAQ STRIP */
.acp-faq{padding:56px 48px;background:var(--cream);border-top:1px solid var(--border);}
.acp-faq-header{text-align:center;margin-bottom:40px;}
.acp-faq-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.acp-faq-title{font-family:var(--font-heading);font-size:36px;color:var(--black);font-weight:500;}
.acp-faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.acp-faq-item{background:transparent;border:1px solid var(--border);border-radius:4px;padding:20px 22px;cursor:pointer;transition:border-color 0.2s;}
.acp-faq-item:hover{border-color:var(--gold);}
.acp-faq-q{font-size:14px;font-weight:500;color:var(--black);display:flex;align-items:center;justify-content:space-between;gap:12px;}
.acp-faq-arrow{font-size:16px;color:var(--gold);flex-shrink:0;transition:transform 0.2s;}
.acp-faq-item.open .acp-faq-arrow{transform:rotate(45deg);}
.acp-faq-a{font-size:13px;color:var(--muted);font-weight:300;line-height:1.7;margin-top:12px;display:none;}
.acp-faq-item.open .acp-faq-a{display:block;}

/* FOOTER */
.acp-footer{background:transparent;}
.acp-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.acp-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.acp-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;}
.acp-footer-main{padding:56px 48px 40px;}
.acp-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.acp-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.acp-footer-social{display:flex;gap:10px;margin-top:20px;}
.acp-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--muted);text-decoration:none;transition:border-color 0.2s;}
.acp-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.acp-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.acp-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.acp-footer-col ul{list-style:none;}
.acp-footer-col ul li{margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.acp-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.6;}
.acp-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.acp-footer-col ul li a:hover{color:var(--gold);}
.acp-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.acp-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.acp-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.acp-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.acp-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.acp-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.acp-footer-legal{display:flex;gap:20px;}
.acp-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.acp-footer-legal a:hover{color:var(--gold);}

/* RESPONSIVE */
@media(max-width:1024px){
  .acp-nav,.acp-crumb,.acp-header,.acp-info,.acp-form-wrap,.acp-faq,.acp-footer-main,.acp-footer-topbar,.acp-footer-bottom{padding-left:28px;padding-right:28px;}
  .acp-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
}
@media(max-width:768px){
  .acp-map-header{padding:28px 20px 20px;flex-direction:column;align-items:flex-start;}
  .acp-map-address{text-align:left;}
  .acp-map-wrap{height:300px;}
  .acp-map-overlay{left:16px;bottom:16px;max-width:200px;}
  .acp-nav{padding:0 20px;min-height:68px;}
  .acp-nav-links{display:none;}
  .acp-burger{display:flex;}
  .acp-logo img{height:54px;}
  .acp-mob{top:68px;}
  .acp-nav,.acp-crumb,.acp-header,.acp-info,.acp-form-wrap,.acp-faq,.acp-footer-main,.acp-footer-topbar,.acp-footer-bottom{padding-left:20px;padding-right:20px;}
  .acp-main{grid-template-columns:1fr;}
  .acp-header-title{font-size:36px;}
  .acp-form-row{grid-template-columns:1fr;}
  .acp-faq-grid{grid-template-columns:1fr;}
  .acp-footer-grid{grid-template-columns:1fr 1fr;}
  .acp-footer-topbar{flex-direction:column;text-align:center;}
  .acp-footer-bottom{flex-direction:column;text-align:center;}
}
@media(max-width:480px){
  .acp-map-wrap{height:240px;}
  .acp-map-overlay{display:none;}
  .acp-map-header{padding:20px;}
  .acp-header-title{font-size:28px;}
  .acp-footer-grid{grid-template-columns:1fr;}
}
</style>

<div class="acp">

  {%- comment -%} BREADCRUMB {%- endcomment -%}
  <div class="acp-crumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="acp-crumb-sep">›</span>
    <span class="acp-crumb-cur">Contact Us</span>
  </div>

  {%- comment -%} PAGE HEADER {%- endcomment -%}
  <div class="acp-header">
    <div class="acp-header-label">Get in Touch</div>
    <h1 class="acp-header-title">{{ section.settings.title | default: 'Contact Astro PathShala' }}</h1>
    <p class="acp-header-desc">{{ section.settings.subtitle | default: "Have a question about a gemstone or need help choosing the right remedy? We are here to help. Reach out to us anytime." }}</p>
  </div>

  {%- comment -%} MAIN — INFO + FORM {%- endcomment -%}
  <div class="acp-main">

    {%- comment -%} INFO PANEL {%- endcomment -%}
