{% comment %}
  Astro PathShala — Rashi Guide Page
  File: sections/astro-rashi-guide.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.arg{font-family:var(--font-body);color:var(--black);background:transparent;}
.arg *{box-sizing:border-box;}

/* HERO */
.arg-hero{background:var(--dark);padding:80px 48px;text-align:center;position:relative;overflow:hidden;}
.arg-hero::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:560px;height:560px;border-radius:50%;border:1px solid rgba(184,134,11,0.07);pointer-events:none;}
.arg-hero::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:320px;height:320px;border-radius:50%;border:1px solid rgba(184,134,11,0.1);pointer-events:none;}
.arg-hero-inner{position:relative;z-index:1;}
.arg-hero-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:14px;display:block;}
.arg-hero-title{font-family:var(--font-heading);font-size:60px;font-weight:500;color:var(--gold-pale);line-height:1.08;margin-bottom:18px;}
.arg-hero-title em{font-style:italic;color:var(--gold);}
.arg-hero-desc{font-size:15px;color:var(--gold-lt);font-weight:300;line-height:1.8;max-width:580px;margin:0 auto 40px;}
.arg-hero-pills{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;}
.arg-hero-pill{padding:8px 20px;border:1px solid rgba(184,134,11,0.4);border-radius:20px;font-size:12px;color:var(--gold-lt);font-weight:400;}

/* WHAT IS RASHI */
.arg-intro{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid rgba(184,134,11,0.2);}
.arg-intro-img{background:var(--cream);min-height:440px;display:flex;align-items:center;justify-content:center;font-size:100px;}
.arg-intro-content{padding:64px 52px;display:flex;flex-direction:column;justify-content:center;}
.arg-intro-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:flex;align-items:center;gap:10px;}
.arg-intro-label::before{content:'';width:20px;height:1px;background:var(--gold);}
.arg-intro-title{font-family:var(--font-heading);font-size:40px;color:var(--black);font-weight:500;line-height:1.15;margin-bottom:18px;}
.arg-intro-text{font-size:14px;color:var(--muted);line-height:1.9;font-weight:300;margin-bottom:14px;}

/* ELEMENTS SECTION */
.arg-elements{padding:72px 48px;background:var(--cream);border-top:1px solid var(--border);}
.arg-elements-inner{max-width:1200px;margin:0 auto;}
.arg-elements-hdr{text-align:center;margin-bottom:52px;}
.arg-elements-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
.arg-elem-card{background:transparent;border:1px solid var(--border);border-radius:4px;padding:28px 20px;text-align:center;transition:border-color 0.2s,transform 0.2s;}
.arg-elem-card:hover{border-color:var(--gold);transform:translateY(-4px);}
.arg-elem-icon{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;margin:0 auto 16px;border:1px solid var(--border);}
.arg-elem-card.fire .arg-elem-icon{background:#FFF3E0;}
.arg-elem-card.earth .arg-elem-icon{background:#F1F8E9;}
.arg-elem-card.air .arg-elem-icon{background:#E3F2FD;}
.arg-elem-card.water .arg-elem-icon{background:#E8EAF6;}
.arg-elem-title{font-family:var(--font-heading);font-size:20px;color:var(--black);font-weight:500;margin-bottom:8px;}
.arg-elem-rashis{font-size:12px;color:var(--gold);font-weight:500;margin-bottom:8px;letter-spacing:.5px;}
.arg-elem-desc{font-size:12px;color:var(--muted);font-weight:300;line-height:1.7;}

/* 12 RASHIS GRID */
.arg-rashis{padding:72px 48px;background:var(--dark);border-top:1px solid rgba(184,134,11,0.2);}
.arg-rashis-inner{max-width:1200px;margin:0 auto;}
.arg-rashis-hdr{text-align:center;margin-bottom:52px;}
.arg-rashis-hdr-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block;}
.arg-rashis-hdr-title{font-family:var(--font-heading);font-size:42px;color:var(--gold-pale);font-weight:500;}
.arg-rashis-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.arg-rashi-card{background:rgba(255,253,245,0.05);border:1px solid rgba(184,134,11,0.2);border-radius:4px;padding:26px 22px;transition:border-color 0.2s;}
.arg-rashi-card:hover{border-color:var(--gold);}
.arg-rashi-top{display:flex;align-items:center;gap:14px;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid rgba(184,134,11,0.15);}
.arg-rashi-icon{font-size:30px;flex-shrink:0;}
.arg-rashi-name{font-family:var(--font-heading);font-size:20px;color:var(--gold-pale);font-weight:500;}
.arg-rashi-hindi{font-size:14px;color:var(--gold-lt);font-weight:300;margin-top:1px;}
.arg-rashi-lord{font-size:11px;color:var(--gold);font-weight:500;letter-spacing:.8px;text-transform:uppercase;margin-bottom:8px;}
.arg-rashi-dates{font-size:12px;color:var(--gold-lt);font-weight:300;margin-bottom:10px;}
.arg-rashi-traits{list-style:none;}
.arg-rashi-traits li{font-size:12px;color:var(--gold-lt);font-weight:300;padding:3px 0;display:flex;gap:8px;}
.arg-rashi-traits li::before{content:'✦';color:var(--gold);font-size:8px;flex-shrink:0;margin-top:3px;}
.arg-rashi-element{display:inline-flex;align-items:center;gap:5px;margin-top:12px;padding:3px 10px;border:1px solid rgba(184,134,11,0.25);border-radius:20px;font-size:10px;color:var(--gold-lt);font-weight:400;}

/* COMPATIBILITY SECTION */
.arg-compat{padding:72px 48px;background:transparent;border-top:1px solid var(--border);}
.arg-compat-inner{max-width:1100px;margin:0 auto;}
.arg-compat-hdr{text-align:center;margin-bottom:52px;}
.arg-compat-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
.arg-compat-group{background:var(--cream);border:1px solid var(--border);border-radius:4px;padding:28px;}
.arg-compat-group-title{font-family:var(--font-heading);font-size:22px;color:var(--black);font-weight:500;margin-bottom:6px;display:flex;align-items:center;gap:10px;}
.arg-compat-group-icon{font-size:20px;}
.arg-compat-group-sub{font-size:12px;color:var(--muted);font-weight:300;margin-bottom:18px;line-height:1.6;}
.arg-compat-pairs{display:flex;flex-direction:column;gap:10px;}
.arg-compat-pair{display:flex;align-items:center;gap:12px;padding:10px 14px;background:transparent;border:1px solid var(--border);border-radius:3px;}
.arg-compat-signs{font-size:13px;font-weight:500;color:var(--black);}
.arg-compat-reason{font-size:11px;color:var(--muted);font-weight:300;margin-top:2px;}
.arg-compat-score{margin-left:auto;font-family:var(--font-heading);font-size:16px;color:var(--gold);font-weight:400;flex-shrink:0;}

/* HOW TO FIND YOUR RASHI */
.arg-find{padding:72px 48px;background:var(--cream);border-top:1px solid var(--border);}
.arg-find-inner{max-width:1100px;margin:0 auto;}
.arg-find-hdr{text-align:center;margin-bottom:52px;}
.arg-find-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.arg-find-step{text-align:center;padding:28px 20px;background:transparent;border:1px solid var(--border);border-radius:4px;}
.arg-find-num{width:44px;height:44px;border-radius:50%;background:var(--gold);color:var(--ivory);font-family:var(--font-heading);font-size:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
.arg-find-step-icon{font-size:28px;margin-bottom:12px;}
.arg-find-step-title{font-family:var(--font-heading);font-size:17px;color:var(--black);margin-bottom:8px;font-weight:500;}
.arg-find-step-text{font-size:12px;color:var(--muted);line-height:1.7;font-weight:300;}

/* NAKSHATRA SECTION */
.arg-nakshatra{padding:72px 48px;background:var(--dark);border-top:1px solid rgba(184,134,11,0.2);}
.arg-nakshatra-inner{max-width:1100px;margin:0 auto;}
.arg-nakshatra-hdr{text-align:center;margin-bottom:52px;}
.arg-nakshatra-hdr-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block;}
.arg-nakshatra-hdr-title{font-family:var(--font-heading);font-size:40px;color:var(--gold-pale);font-weight:500;margin-bottom:10px;}
.arg-nakshatra-hdr-sub{font-size:14px;color:var(--gold-lt);font-weight:300;max-width:520px;margin:0 auto;line-height:1.75;}
.arg-nakshatra-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.arg-nakshatra-item{padding:18px 20px;background:rgba(255,253,245,0.04);border:1px solid rgba(184,134,11,0.18);border-radius:3px;transition:border-color 0.2s;}
.arg-nakshatra-item:hover{border-color:var(--gold);}
.arg-nakshatra-name{font-size:14px;font-weight:500;color:var(--gold-pale);margin-bottom:3px;}
.arg-nakshatra-lord{font-size:11px;color:var(--gold);font-weight:400;letter-spacing:.5px;}
.arg-nakshatra-rashi{font-size:11px;color:var(--gold-lt);font-weight:300;margin-top:4px;}

/* FAQ */
.arg-faq{padding:72px 48px;background:transparent;border-top:1px solid var(--border);}
.arg-faq-inner{max-width:820px;margin:0 auto;}
.arg-faq-hdr{text-align:center;margin-bottom:48px;}
.arg-faq-item{border-bottom:1px solid var(--border);}
.arg-faq-q{display:flex;justify-content:space-between;align-items:center;padding:18px 0;cursor:pointer;user-select:none;}
.arg-faq-q-text{font-size:14px;font-weight:500;color:var(--black);}
.arg-faq-arrow{font-size:18px;color:var(--gold);transition:transform 0.2s;flex-shrink:0;}
.arg-faq-item.open .arg-faq-arrow{transform:rotate(45deg);}
.arg-faq-a{display:none;padding:0 0 18px;}
.arg-faq-item.open .arg-faq-a{display:block;}
.arg-faq-a p{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;}

/* CTA */
.arg-cta{padding:80px 48px;background:var(--dark);text-align:center;border-top:1px solid rgba(184,134,11,0.2);}
.arg-cta-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:block;}
.arg-cta-title{font-family:var(--font-heading);font-size:52px;color:var(--gold-pale);font-weight:500;margin-bottom:14px;}
.arg-cta-sub{font-size:15px;color:var(--gold-lt);font-weight:300;margin-bottom:36px;max-width:480px;margin-left:auto;margin-right:auto;line-height:1.7;}
.arg-cta-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.arg-cta-btn{padding:15px 36px;background:var(--gold);color:var(--ivory);border:none;font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.arg-cta-btn:hover{background:var(--saffron);}
.arg-cta-btn-outline{padding:15px 36px;background:transparent;color:var(--gold-pale);border:1px solid rgba(201,168,76,0.5);font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:all 0.2s;}
.arg-cta-btn-outline:hover{border-color:var(--gold);color:var(--gold);}

/* SHARED */
.arg-sec-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.arg-sec-title{font-family:var(--font-heading);font-size:40px;font-weight:500;color:var(--black);}
.arg-sec-sub{font-size:14px;color:var(--muted);font-weight:300;line-height:1.8;margin-top:10px;}

/* RESPONSIVE */
@media(max-width:1024px){
  .arg-hero,.arg-elements,.arg-rashis,.arg-compat,.arg-find,.arg-nakshatra,.arg-faq,.arg-cta{padding-left:28px;padding-right:28px;}
  .arg-rashis-grid{grid-template-columns:1fr 1fr;}
  .arg-elements-grid{grid-template-columns:1fr 1fr;}
  .arg-find-steps{grid-template-columns:1fr 1fr;}
  .arg-nakshatra-grid{grid-template-columns:1fr 1fr;}
}
@media(max-width:768px){
  .arg-hero{padding:56px 20px;}
  .arg-hero-title{font-size:40px;}
  .arg-intro{grid-template-columns:1fr;}
  .arg-intro-img{min-height:260px;}
  .arg-intro-content{padding:40px 20px;}
  .arg-elements,.arg-rashis,.arg-compat,.arg-find,.arg-nakshatra,.arg-faq,.arg-cta{padding:52px 20px;}
  .arg-rashis-grid{grid-template-columns:1fr;}
  .arg-elements-grid{grid-template-columns:1fr 1fr;}
  .arg-compat-grid{grid-template-columns:1fr;}
  .arg-find-steps{grid-template-columns:1fr 1fr;}
  .arg-nakshatra-grid{grid-template-columns:1fr 1fr;}
}
@media(max-width:480px){
  .arg-hero-title{font-size:32px;}
  .arg-cta-title{font-size:36px;}
  .arg-elements-grid{grid-template-columns:1fr;}
  .arg-find-steps{grid-template-columns:1fr;}
  .arg-nakshatra-grid{grid-template-columns:1fr;}
}
</style>

<div class="arg">

{%- comment -%} HERO {%- endcomment -%}
<div class="arg-hero">
  <div class="arg-hero-inner">
    <span class="arg-hero-label">{{ section.settings.hero_label | default: 'Vedic Astrology' }}</span>
    <h1 class="arg-hero-title">{{ section.settings.hero_title | default: 'The Complete' }} <em>{{ section.settings.hero_italic | default: 'Rashi Guide' }}</em></h1>
    <p class="arg-hero-desc">{{ section.settings.hero_desc | default: 'Discover your zodiac sign, its ruling planet, element, characteristics and compatibility — a complete guide to all 12 Rashis of Vedic astrology.' }}</p>
    <div class="arg-hero-pills">
      <span class="arg-hero-pill">&#9800; All 12 Rashis</span>
      <span class="arg-hero-pill">&#9654; Elements Guide</span>
      <span class="arg-hero-pill">&#10084; Compatibility</span>
      <span class="arg-hero-pill">&#127775; Nakshatras</span>
      <span class="arg-hero-pill">&#128142; Find Your Rashi</span>
    </div>
  </div>
</div>

{%- comment -%} WHAT IS RASHI {%- endcomment -%}
<div class="arg-intro">
  <div class="arg-intro-img">&#9728;</div>
  <div class="arg-intro-content">
    <span class="arg-intro-label">The Foundation</span>
    <h2 class="arg-intro-title">{{ section.settings.intro_title | default: 'What is a Rashi in Vedic Astrology?' }}</h2>
    <p class="arg-intro-text">{{ section.settings.intro_p1 | default: 'In Vedic astrology (Jyotish), a Rashi is your Moon sign — the zodiac sign that the Moon occupied at the exact moment of your birth. Unlike Western astrology which focuses on the Sun sign, Vedic astrology gives primary importance to the Rashi as it reflects your mind, emotions, instincts and inner nature.' }}</p>
    <p class="arg-intro-text">{{ section.settings.intro_p2 | default: 'The 12 Rashis are divided across the 360-degree zodiac wheel, each spanning 30 degrees. Every Rashi is ruled by one of the nine Navagrahas (planets) and belongs to one of four elements — Fire, Earth, Air or Water — which shapes its fundamental energy.' }}</p>
    <p class="arg-intro-text">{{ section.settings.intro_p3 | default: 'Your Rashi determines your personality traits, emotional responses, compatible partners, auspicious gemstones, lucky colours and much more. Knowing your Rashi is the first step to understanding your Vedic birth chart.' }}</p>
  </div>
</div>

{%- comment -%} FOUR ELEMENTS {%- endcomment -%}
<div class="arg-elements">
  <div class="arg-elements-inner">
    <div class="arg-elements-hdr">
      <span class="arg-sec-label">{{ section.settings.elem_label | default: 'The Building Blocks' }}</span>
      <div class="arg-sec-title">{{ section.settings.elem_title | default: 'Four Elements of the Zodiac' }}</div>
      <div class="arg-sec-sub">{{ section.settings.elem_sub | default: 'Every Rashi belongs to one of four elements that define its core energy' }}</div>
    </div>
    <div class="arg-elements-grid">
      <div class="arg-elem-card fire">
        <div class="arg-elem-icon">&#128293;</div>
        <div class="arg-elem-title">{{ section.settings.elem1_title | default: 'Fire (Agni)' }}</div>
        <div class="arg-elem-rashis">{{ section.settings.elem1_rashis | default: 'Aries · Leo · Sagittarius' }}</div>
        <div class="arg-elem-desc">{{ section.settings.elem1_desc | default: 'Passionate, dynamic and courageous. Fire signs are natural leaders filled with enthusiasm, confidence and a drive to achieve. They are bold, creative and highly motivated.' }}</div>
      </div>
      <div class="arg-elem-card earth">
        <div class="arg-elem-icon">&#127758;</div>
        <div class="arg-elem-title">{{ section.settings.elem2_title | default: 'Earth (Prithvi)' }}</div>
        <div class="arg-elem-rashis">{{ section.settings.elem2_rashis | default: 'Taurus · Virgo · Capricorn' }}</div>
        <div class="arg-elem-desc">{{ section.settings.elem2_desc | default: 'Practical, reliable and grounded. Earth signs are stable, patient and hardworking. They value security, are deeply loyal and build lasting foundations in all areas of life.' }}</div>
      </div>
      <div class="arg-elem-card air">
        <div class="arg-elem-icon">&#127744;</div>
        <div class="arg-elem-title">{{ section.settings.elem3_title | default: 'Air (Vayu)' }}</div>
        <div class="arg-elem-rashis">{{ section.settings.elem3_rashis | default: 'Gemini · Libra · Aquarius' }}</div>
        <div class="arg-elem-desc">{{ section.settings.elem3_desc | default: 'Intellectual, communicative and adaptable. Air signs are quick thinkers and great communicators. They love learning, socialising and exploring new ideas and perspectives.' }}</div>
      </div>
      <div class="arg-elem-card water">
        <div class="arg-elem-icon">&#128167;</div>
        <div class="arg-elem-title">{{ section.settings.elem4_title | default: 'Water (Jal)' }}</div>
        <div class="arg-elem-rashis">{{ section.settings.elem4_rashis | default: 'Cancer · Scorpio · Pisces' }}</div>
        <div class="arg-elem-desc">{{ section.settings.elem4_desc | default: 'Intuitive, emotional and deeply sensitive. Water signs are empathetic, imaginative and spiritually inclined. They feel deeply and often possess strong psychic instincts.' }}</div>
      </div>
    </div>
  </div>
</div>

{%- comment -%} 12 RASHIS {%- endcomment -%}
<div class="arg-rashis">
  <div class="arg-rashis-inner">
    <div class="arg-rashis-hdr">
      <span class="arg-rashis-hdr-label">{{ section.settings.rashis_label | default: 'All 12 Signs' }}</span>
      <div class="arg-rashis-hdr-title">{{ section.settings.rashis_title | default: 'Complete Rashi Guide' }}</div>
    </div>
    <div class="arg-rashis-grid">

