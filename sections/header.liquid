        if (!this.drawer || this.drawer.hidden) return;
        this.drawer.classList.remove('is-open');
        this.drawerOpen.setAttribute('aria-expanded', 'false');
        this.unlockScroll();
        const finalize = () => { this.drawer.hidden = true; };
        if (reducedMotion) {
          finalize();
        } else {
          const onEnd = (e) => {
            if (e.target !== this.drawerPanel || e.propertyName !== 'transform') return;
            finalize();
            this.drawerPanel.removeEventListener('transitionend', onEnd);
          };
          this.drawerPanel.addEventListener('transitionend', onEnd);
        }
        if (this.lastFocused && typeof this.lastFocused.focus === 'function') {
          this.lastFocused.focus({ preventScroll: true });
        } else {
          this.drawerOpen.focus({ preventScroll: true });
        }
      }

      onKeydown(e) {
        if (e.key === 'Escape') {
          if (this.drawer && !this.drawer.hidden) { this.closeDrawer(); return; }
          if (this.searchPanel && !this.searchPanel.hidden) { this.closeSearch(); return; }
          if (this.activeTrigger) { this.closeDropdown(this.activeTrigger); this.activeTrigger.focus(); return; }
        }
        if (e.key === 'Tab' && this.drawer && !this.drawer.hidden) this.trapFocus(e);
      }

      trapFocus(e) {
        const nodes = Array.from(this.drawerPanel.querySelectorAll(FOCUSABLE)).filter(n => n.offsetParent !== null);
        if (!nodes.length) return;
        const first = nodes[0];
        const last = nodes[nodes.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus({ preventScroll: true });
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus({ preventScroll: true });
        }
      }

      bindSearch() {
        if (!this.searchOpen || !this.searchPanel) return;
        this.searchOpen.addEventListener('click', () => this.toggleSearch());
        if (this.searchClose) this.searchClose.addEventListener('click', () => this.closeSearch());
      }

      toggleSearch() {
        if (this.searchPanel.hidden) this.openSearch();
        else this.closeSearch();
      }

      openSearch() {
        this.searchPanel.hidden = false;
        this.searchOpen.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => {
          if (this.searchInput) this.searchInput.focus({ preventScroll: true });
        });
      }

      closeSearch() {
        this.searchPanel.hidden = true;
        this.searchOpen.setAttribute('aria-expanded', 'false');
        this.searchOpen.focus({ preventScroll: true });
      }

      lockScroll() {
        const sw = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.classList.add('lux-locked');
        if (sw > 0) document.body.style.paddingInlineEnd = sw + 'px';
      }

      unlockScroll() {
        document.documentElement.classList.remove('lux-locked');
        document.body.style.paddingInlineEnd = '';
      }
    }

    const init = (root) => {
      (root || document).querySelectorAll(SELECTOR).forEach((el) => {
        if (el.dataset.luxInit === 'true') return;
        el.dataset.luxInit = 'true';
        new LuxHeader(el);
      });
    };

    init();
    document.addEventListener('shopify:section:load', (e) => init(e.target));
    document.addEventListener('shopify:section:unload', () => {
      document.documentElement.classList.remove('lux-locked');
      document.body.style.paddingInlineEnd = '';
    });
  })();
