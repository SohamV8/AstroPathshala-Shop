      <div class="premium-header__drawer-top">
        <a href="{{ routes.root_url }}" class="premium-header__drawer-logo" aria-label="{{ shop.name | escape }}">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {{ settings.logo | image_url: width: 320 | image_tag:
              width: settings.logo_width,
              alt: logo_alt,
              loading: 'eager'
            }}
          {%- else -%}
            <span class="premium-header__brand-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        <button class="premium-header__drawer-close" type="button" aria-label="Close menu" data-menu-close>
          <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <nav class="premium-header__drawer-nav" aria-label="Mobile navigation">
        <ul class="premium-header__drawer-list" role="list">
          {%- if has_menu -%}
            {%- for link in menu_links -%}
              <li class="premium-header__drawer-item">
                {%- if link.links != blank -%}
                  <details>
                    <summary class="premium-header__drawer-summary">
                      <span>{{ link.title | escape }}</span>
                      <svg class="premium-header__drawer-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </summary>

                    <ul class="premium-header__drawer-sublist" role="list">
                      {%- for childlink in link.links -%}
                        <li class="premium-header__drawer-subitem">
                          <a
                            href="{{ childlink.url }}"
                            class="premium-header__drawer-sublink{% if childlink.active %} is-active{% endif %}"
                            {% if childlink.active %}aria-current="page"{% endif %}
                          >
                            {{ childlink.title | escape }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a
                    href="{{ link.url }}"
                    class="premium-header__drawer-link{% if link.active %} is-active{% endif %}"
                    {% if link.active %}aria-current="page"{% endif %}
                  >
                    <span>{{ link.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>

      <div class="premium-header__drawer-footer">
        <a href="{{ routes.search_url }}" class="premium-header__utility" aria-label="Search">
          <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z" stroke="currentColor" stroke-width="1.8"/>
            <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span class="premium-header__utility-label">Search</span>
        </a>

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="premium-header__utility"
            rel="nofollow"
          >
            <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 21C20 17.6863 16.4183 15 12 15C7.58172 15 4 17.6863 4 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M12 12C14.2091 12 16 10.2091 16 8C16 5.79086 14.2091 4 12 4C9.79086 4 8 5.79086 8 8C8 10.2091 9.79086 12 12 12Z" stroke="currentColor" stroke-width="1.8"/>
            </svg>
            <span class="premium-header__utility-label">{% if customer %}Account{% else %}Log in{% endif %}</span>
          </a>
        {%- endif -%}

        {%- if show_whatsapp -%}
          <a
            href="{{ section.settings.whatsapp_url }}"
            class="premium-header__utility premium-header__utility--cta"
            target="_blank"
            rel="noopener"
          >
            <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20.5 11.5C20.5 16.1944 16.6944 20 12 20C10.5283 20 9.1141 19.6232 7.86777 18.9331L4 20L5.08535 16.2283C4.36137 14.9682 4 13.5435 4 12C4 7.30558 7.80558 3.5 12.5 3.5C17.1944 3.5 20.5 6.80558 20.5 11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M9.2 8.9C9.5 8.2 9.9 8.2 10.2 8.2H10.8C11.1 8.2 11.3 8.5 11.4 8.7L11.9 9.9C12 10.1 12 10.4 11.8 10.6L11.2 11.3C11.1 11.5 11.1 11.8 11.2 12C11.9 13.2 12.8 14.1 14 14.8C14.2 14.9 14.5 14.9 14.7 14.8L15.4 14.2C15.6 14.1 15.9 14.1 16.1 14.2L17.3 14.7C17.5 14.8 17.8 15 17.8 15.3V15.9C17.8 16.2 17.8 16.6 17.1 16.9C16.4 17.2 15.5 17.3 14.3 16.9C12.7 16.4 11.2 15.4 10 14.2C8.8 13 7.8 11.5 7.3 9.9C6.9 8.7 7 7.8 7.3 7.1C7.6 6.4 8 6.4 8.3 6.4H8.9C9.2 6.4 9.4 6.7 9.5 6.9L10 8.1C10.1 8.3 10.1 8.6 9.9 8.8L9.2 8.9Z" fill="currentColor"/>
            </svg>
            <span class="premium-header__utility-label">{{ section.settings.whatsapp_label | default: 'WhatsApp' }}</span>
          </a>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="premium-header__utility" aria-label="Cart">
          {% if cart == empty %}
            <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 7H20L18.5 14H8L6 7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M6 7L5.2 4H3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="9" cy="19" r="1.4" fill="currentColor"/>
              <circle cx="17" cy="19" r="1.4" fill="currentColor"/>
            </svg>
          {% else %}
            <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 7H20L18.5 14H8L6 7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M6 7L5.2 4H3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="9" cy="19" r="1.4" fill="currentColor"/>
              <circle cx="17" cy="19" r="1.4" fill="currentColor"/>
              <circle cx="18" cy="6" r="4" fill="#d4af37"/>
