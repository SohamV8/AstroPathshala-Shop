<style>
  :root {
    --premium-header-bg: rgba(5, 8, 22, 0.72);
    --premium-header-bg-solid: #050816;
    --premium-header-border: rgba(212, 175, 55, 0.14);
    --premium-header-text: #f8f5ee;
    --premium-header-text-muted: rgba(248, 245, 238, 0.72);
    --premium-header-accent: #d4af37;
    --premium-header-surface: rgba(255, 255, 255, 0.04);
    --premium-header-surface-strong: rgba(255, 255, 255, 0.08);
    --premium-header-shadow: 0 18px 60px rgba(0, 0, 0, 0.24);
    --premium-header-radius: 999px;
    --premium-header-radius-lg: 24px;
    --premium-header-max: 1440px;
  }

  .section-header {
    position: sticky;
    top: 0;
    z-index: 60;
    margin-bottom: {{ section.settings.margin_bottom | default: 0 }}px;
  }

  .premium-header-shell {
    position: relative;
    background: linear-gradient(180deg, rgba(5, 8, 22, 0.92), rgba(5, 8, 22, 0.72));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid transparent;
    transition: background 220ms ease, box-shadow 220ms ease, border-color 220ms ease, transform 220ms ease;
  }

  .premium-header-shell.is-scrolled {
    background: linear-gradient(180deg, rgba(5, 8, 22, 0.98), rgba(5, 8, 22, 0.9));
    border-bottom-color: var(--premium-header-border);
    box-shadow: var(--premium-header-shadow);
  }

  .premium-header {
    max-width: var(--premium-header-max);
    margin: 0 auto;
    min-height: clamp(92px, 9.2vw, 118px);
    padding: clamp(14px, 1.8vw, 20px) clamp(16px, 2.2vw, 34px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(14px, 1.6vw, 24px);
    color: var(--premium-header-text);
    font-family: Inter, var(--font-body-family, system-ui), sans-serif;
    transition: min-height 220ms ease, padding 220ms ease;
  }

  .premium-header-shell.is-scrolled .premium-header {
    min-height: clamp(82px, 7.4vw, 102px);
    padding-block: clamp(10px, 1.2vw, 14px);
  }

  .premium-header__left,
  .premium-header__right {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .premium-header__left {
    justify-content: flex-start;
  }

  .premium-header__right {
    justify-content: flex-end;
  }

  .premium-header__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    line-height: 0;
    min-width: 0;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .premium-header__logo:hover {
    transform: translateY(-1px);
    opacity: 0.96;
  }

  .premium-header__logo img {
    display: block;
    width: auto;
    max-height: clamp(58px, 5.4vw, 78px);
    object-fit: contain;
    transition: max-height 220ms ease;
    will-change: transform;
  }

  .premium-header-shell.is-scrolled .premium-header__logo img {
    max-height: clamp(50px, 4.4vw, 68px);
  }

  .premium-header__brand-text {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .premium-header__nav {
    display: flex;
    align-items: center;
  }

  .premium-header__nav-list {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 0;
    margin: 0;
  }

  .premium-header__nav-item {
    position: relative;
  }

  .premium-header__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 4px;
    text-decoration: none;
    color: var(--premium-header-text);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    position: relative;
    transition: color 180ms ease, opacity 180ms ease, transform 180ms ease;
    opacity: 0.92;
  }

  .premium-header__nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 8px;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--premium-header-accent), transparent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 220ms ease;
  }

  .premium-header__nav-link:hover,
  .premium-header__nav-link:focus-visible,
  .premium-header__nav-link.is-active {
    color: #ffffff;
    opacity: 1;
  }

  .premium-header__nav-link:hover::after,
  .premium-header__nav-link:focus-visible::after,
  .premium-header__nav-link.is-active::after {
    transform: scaleX(1);
  }

  .premium-header__nav-link:focus-visible,
  .premium-header__icon-button:focus-visible,
  .premium-header__menu-button:focus-visible,
  .premium-header__drawer-close:focus-visible,
  .premium-header__drawer-link:focus-visible,
  .premium-header__drawer-summary:focus-visible {
    outline: 2px solid rgba(212, 175, 55, 0.95);
    outline-offset: 3px;
    border-radius: 12px;
  }

  .premium-header__submenu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 230px;
    padding: 12px;
    margin: 0;
    list-style: none;
    border: 1px solid var(--premium-header-border);
    border-radius: 18px;
    background: rgba(8, 12, 28, 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: var(--premium-header-shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    z-index: 80;
  }

  .premium-header__nav-item:hover .premium-header__submenu,
  .premium-header__nav-item:focus-within .premium-header__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .premium-header__submenu-item + .premium-header__submenu-item {
    margin-top: 4px;
  }

  .premium-header__submenu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 14px;
    text-decoration: none;
    color: var(--premium-header-text);
    font-size: 0.92rem;
    line-height: 1.35;
    transition: background 180ms ease, transform 180ms ease, color 180ms ease;
  }

  .premium-header__submenu-link:hover,
  .premium-header__submenu-link:focus-visible {
    background: var(--premium-header-surface);
    transform: translateX(2px);
    color: #ffffff;
  }

  .premium-header__utility {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 16px;
    border-radius: var(--premium-header-radius);
    text-decoration: none;
    color: var(--premium-header-text);
    background: var(--premium-header-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: background 180ms ease, transform 180ms ease, border-color 180ms ease, color 180ms ease;
    white-space: nowrap;
  }

  .premium-header__utility:hover,
  .premium-header__utility:focus-visible {
    background: var(--premium-header-surface-strong);
    transform: translateY(-1px);
    border-color: rgba(212, 175, 55, 0.24);
    color: #fff;
  }

  .premium-header__utility--ghost {
    padding: 0;
    width: 46px;
    min-width: 46px;
  }

  .premium-header__utility--cta {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.22), rgba(246, 215, 167, 0.12));
    border-color: rgba(212, 175, 55, 0.22);
  }

  .premium-header__utility-label {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .premium-header__icon {
    width: 18px;
    height: 18px;
    display: inline-block;
  }

  .premium-header__menu-button {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--premium-header-radius);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--premium-header-surface);
    color: var(--premium-header-text);
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
    cursor: pointer;
  }

  .premium-header__menu-button:hover {
    transform: translateY(-1px);
    background: var(--premium-header-surface-strong);
    border-color: rgba(212, 175, 55, 0.24);
  }

  .premium-header__burger {
    position: relative;
    width: 18px;
    height: 14px;
    display: inline-block;
  }

  .premium-header__burger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.8px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 220ms ease, top 220ms ease, opacity 180ms ease;
  }

  .premium-header__burger span:nth-child(1) { top: 0; }
  .premium-header__burger span:nth-child(2) { top: 6px; }
  .premium-header__burger span:nth-child(3) { top: 12px; }

  .premium-header__menu-button[aria-expanded="true"] .premium-header__burger span:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }

  .premium-header__menu-button[aria-expanded="true"] .premium-header__burger span:nth-child(2) {
    opacity: 0;
  }

  .premium-header__menu-button[aria-expanded="true"] .premium-header__burger span:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  .premium-header__drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(2, 4, 10, 0.56);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 220ms ease, visibility 220ms ease;
    z-index: 70;
  }

  .premium-header__drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100vw, 420px);
    height: 100dvh;
    background:
      linear-gradient(180deg, rgba(5, 8, 22, 0.98), rgba(8, 12, 28, 0.98)),
      radial-gradient(circle at top, rgba(212, 175, 55, 0.12), transparent 50%);
    color: var(--premium-header-text);
    border-left: 1px solid var(--premium-header-border);
    transform: translateX(102%);
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 75;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .premium-header__drawer.is-open {
    transform: translateX(0);
  }

  .premium-header__drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .premium-header__drawer-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 18px;
  }

  .premium-header__drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .premium-header__drawer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .premium-header__drawer-logo img {
    max-height: 42px;
    width: auto;
  }

  .premium-header__drawer-close {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .premium-header__drawer-close:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(212, 175, 55, 0.24);
  }

  .premium-header__drawer-nav {
    padding: 18px 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    flex: 1;
  }

  .premium-header__drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .premium-header__drawer-item + .premium-header__drawer-item {
    margin-top: 10px;
  }

  .premium-header__drawer-link,
  .premium-header__drawer-summary {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 16px;
    border-radius: 18px;
    text-decoration: none;
    color: var(--premium-header-text);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease, border-color 180ms ease;
  }

  .premium-header__drawer-link:hover,
  .premium-header__drawer-summary:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-1px);
    border-color: rgba(212, 175, 55, 0.16);
  }

  .premium-header__drawer-summary {
    list-style: none;
  }

  .premium-header__drawer-summary::-webkit-details-marker {
    display: none;
  }

  .premium-header__drawer-chevron {
    width: 18px;
    height: 18px;
    transition: transform 180ms ease;
  }

  details[open] > .premium-header__drawer-summary .premium-header__drawer-chevron {
    transform: rotate(180deg);
  }

  .premium-header__drawer-sublist {
    list-style: none;
    padding: 10px 0 0 0;
    margin: 0;
  }

  .premium-header__drawer-subitem + .premium-header__drawer-subitem {
    margin-top: 8px;
  }

  .premium-header__drawer-sublink {
    display: flex;
    align-items: center;
    padding: 12px 16px 12px 22px;
    text-decoration: none;
    color: var(--premium-header-text-muted);
    font-size: 0.96rem;
    line-height: 1.4;
    border-radius: 14px;
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .premium-header__drawer-sublink:hover,
  .premium-header__drawer-sublink:focus-visible {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    transform: translateX(2px);
  }

  .premium-header__drawer-footer {
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: grid;
    gap: 10px;
  }

  .premium-header__drawer-footer .premium-header__utility {
    width: 100%;
    justify-content: center;
  }

  .premium-header__mobile-only {
    display: none;
  }

  .premium-header__sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  @media (max-width: 989px) {
    .premium-header {
      grid-template-columns: auto 1fr auto;
      min-height: clamp(78px, 13vw, 96px);
      gap: 12px;
    }

    .premium-header__nav {
      display: none;
    }

    .premium-header__menu-button {
      display: inline-flex;
    }

    .premium-header__utility--cta .premium-header__utility-label,
    .premium-header__utility--text {
      display: none;
    }

    .premium-header__utility {
      width: 46px;
      min-width: 46px;
      padding: 0;
    }

    .premium-header__utility--cta {
      background: var(--premium-header-surface);
    }

    .premium-header__mobile-only {
      display: inline-flex;
    }

    .premium-header__desktop-only {
      display: none;
    }

    .premium-header__logo img {
      max-height: clamp(44px, 10.4vw, 58px);
    }

    .premium-header-shell.is-scrolled .premium-header__logo img {
      max-height: clamp(40px, 9.6vw, 52px);
    }
  }

  @media (max-width: 540px) {
    .premium-header {
      padding-inline: 14px;
      min-height: clamp(74px, 15.5vw, 90px);
    }

    .premium-header__drawer {
      width: 100vw;
    }

    .premium-header__drawer-inner {
      padding: 14px;
    }

    .premium-header__drawer-link,
    .premium-header__drawer-summary {
      padding: 14px 14px;
      border-radius: 16px;
    }

    .premium-header__drawer-sublink {
      padding-left: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .premium-header-shell,
    .premium-header,
    .premium-header__logo,
    .premium-header__logo img,
    .premium-header__nav-link,
    .premium-header__submenu,
    .premium-header__utility,
    .premium-header__menu-button,
    .premium-header__drawer,
    .premium-header__drawer-backdrop,
    .premium-header__drawer-link,
    .premium-header__drawer-summary,
    .premium-header__drawer-sublink,
    .premium-header__drawer-close,
    .premium-header__burger span {
      transition: none !important;
    }
  }
</style>

{%- liquid
  assign has_menu = false
  if section.settings.menu != blank
    assign has_menu = true
  endif
  assign menu_links = section.settings.menu.links
  assign show_whatsapp = false
  if section.settings.show_whatsapp_cta and section.settings.whatsapp_url != blank
    assign show_whatsapp = true
  endif
-%}

<header class="section-header premium-header-shell" data-premium-header>
  <div class="premium-header" role="navigation" aria-label="Main navigation">
    <div class="premium-header__left">
      <button
        class="premium-header__menu-button"
        type="button"
        aria-label="Open menu"
        aria-controls="PremiumHeaderDrawer"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="premium-header__burger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      {%- if has_menu -%}
        <nav class="premium-header__nav premium-header__desktop-only" aria-label="Primary">
          <ul class="premium-header__nav-list" role="list">
            {%- for link in menu_links -%}
              <li class="premium-header__nav-item{% if link.links != blank %} has-submenu{% endif %}">
                <a
                  href="{{ link.url }}"
                  class="premium-header__nav-link{% if link.active %} is-active{% endif %}"
                  {% if link.active %}aria-current="page"{% endif %}
                >
                  <span>{{ link.title | escape }}</span>
                  {%- if link.links != blank -%}
                    <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </a>

                {%- if link.links != blank -%}
                  <ul class="premium-header__submenu" role="list" aria-label="{{ link.title | escape }}">
                    {%- for childlink in link.links -%}
                      <li class="premium-header__submenu-item">
                        <a
                          href="{{ childlink.url }}"
                          class="premium-header__submenu-link{% if childlink.active %} is-active{% endif %}"
                          {% if childlink.active %}aria-current="page"{% endif %}
                        >
                          <span>{{ childlink.title | escape }}</span>
                          <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    <div class="premium-header__center">
      {%- if request.page_type == 'index' -%}
        <h1 style="margin:0;">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="premium-header__logo" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
          {% capture sizes %}(max-width: 989px) 160px, {{ settings.logo_width }}px{% endcapture %}
          {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
          {{ settings.logo | image_url: width: 600 | image_tag:
            class: 'motion-reduce',
            widths: widths,
            height: logo_height,
            width: settings.logo_width,
            alt: logo_alt,
            sizes: sizes,
            preload: true
          }}
        {%- else -%}
          <span class="premium-header__brand-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    </div>

    <div class="premium-header__right">
      <a
        href="{{ routes.search_url }}"
        class="premium-header__utility premium-header__utility--ghost premium-header__desktop-only"
        aria-label="Search"
      >
        <svg class="premium-header__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M10.5 18C14.6421 18 18 14.6421 18 10.5C18 6.35786 14.6421 3 10.5 3C6.35786 3 3 6.35786 3 10.5C3 14.6421 6.35786 18 10.5 18Z" stroke="currentColor" stroke-width="1.8"/>
          <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
