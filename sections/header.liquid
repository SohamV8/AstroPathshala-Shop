{%- liquid
  assign main_menu = section.settings.menu
  assign brand_logo_asset = 'astro-pathshala-Logo-Black-New.png'
  assign brand_logo_asset_url = brand_logo_asset | asset_url
  assign use_asset_logo = true
  assign logo = settings.logo
  assign logo_mobile = settings.logo
  assign logo_alt = shop.name | escape
  if logo.alt != blank
    assign logo_alt = logo.alt | escape
  endif

  assign wishlist_url = section.settings.wishlist_url | default: '#'
  assign wishlist_label = section.settings.wishlist_label | default: 'Wishlist'
  assign drawer_footer_note = section.settings.drawer_footer_note | strip
  assign whatsapp_label = section.settings.whatsapp_label | default: 'WhatsApp'

  assign show_whatsapp = false
  if section.settings.show_whatsapp_cta
    if section.settings.whatsapp_url != blank
      assign show_whatsapp = true
    endif
  endif

  assign show_country_selector = false
  if section.settings.enable_country_selector
    if localization.available_countries.size > 1
      assign show_country_selector = true
    endif
  endif

  assign show_language_selector = false
  if section.settings.enable_language_selector
    if localization.available_languages.size > 1
      assign show_language_selector = true
    endif
  endif

  assign show_search = section.settings.show_search
  assign show_account = false
  if section.settings.show_account
    if shop.customer_accounts_enabled
      assign show_account = true
    endif
  endif
  assign show_wishlist = section.settings.show_wishlist

  assign mobile_logo_left = false
  if section.settings.mobile_logo_position == 'left'
    assign mobile_logo_left = true
  endif

  assign sticky_mode = 'always'
-%}

<header
  class="lux-header{% if section.settings.show_line_separator %} lux-header--with-border{% endif %}"
  data-lux-header
  data-sticky-mode="{{ sticky_mode }}"
  style="--lux-header-margin-bottom: {{ section.settings.margin_bottom }}px; --lux-header-pt: {{ section.settings.padding_top }}px; --lux-header-pb: {{ section.settings.padding_bottom }}px;"
>
  <a class="lux-skip-link" href="#MainContent">Skip to content</a>

  <div class="lux-header__bar">
    <div class="lux-header__container">

      <div class="lux-header__left">
        <button
          type="button"
          class="lux-icon-btn lux-header__menu-btn"
          aria-controls="lux-drawer-{{ section.id }}"
          aria-expanded="false"
          aria-label="Open menu"
          data-drawer-open
        >
          <span class="lux-burger" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>

        <nav class="lux-header__nav" aria-label="Primary">
          <ul class="lux-nav" role="list">
            {%- for link in main_menu.links -%}
              <li class="lux-nav__item" data-dropdown-item>
                {%- if link.links != blank -%}
                  <button
                    type="button"
                    class="lux-nav__link lux-nav__trigger"
                    aria-expanded="false"
                    aria-controls="lux-submenu-{{ section.id }}-{{ forloop.index }}"
                    data-dropdown-trigger
                  >
                    <span>{{ link.title | escape }}</span>
                    {% render 'lux-icon', name: 'chevron-down-sm', class: 'lux-nav__chevron' %}
                  </button>

                  <div
                    id="lux-submenu-{{ section.id }}-{{ forloop.index }}"
                    class="lux-submenu"
                    hidden
                    data-dropdown-panel
                  >
                    <ul class="lux-submenu__list" role="list">
                      {%- for child in link.links -%}
                        <li class="lux-submenu__item">
                          <a href="{{ child.url }}" class="lux-submenu__link">
                            {{ child.title | escape }}
                          </a>
                          {%- if child.links != blank -%}
                            <ul class="lux-submenu__nested" role="list">
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a href="{{ grandchild.url }}" class="lux-submenu__nested-link">
                                    {{ grandchild.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- else -%}
                  <a href="{{ link.url }}" class="lux-nav__link{% if link.active %} is-active{% endif %}">
                    {{ link.title | escape }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>

      <div class="lux-header__center{% if mobile_logo_left %} lux-header__center--mobile-left{% endif %}">
        <a href="{{ routes.root_url }}" class="lux-logo" aria-label="{{ shop.name | escape }}" itemscope itemtype="https://schema.org/Organization">
          {%- if use_asset_logo -%}
            <img
              src="{{ brand_logo_asset_url }}"
              alt="{{ shop.name | escape }}"
              width="1080"
              height="1080"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="lux-logo__img lux-logo__img--asset"
              itemprop="logo"
            >
          {%- elsif logo != blank -%}
            {{ logo | image_url: width: 480 | image_tag:
              widths: '120,160,200,240,300,360,420,480',
              sizes: '(min-width: 990px) 200px, 140px',
              alt: logo_alt,
              loading: 'eager',
              fetchpriority: 'high',
              class: 'lux-logo__img',
              itemprop: 'logo'
            }}
          {%- else -%}
            <span class="lux-logo__text">{{ shop.name }}</span>
          {%- endif -%}
          <meta itemprop="name" content="{{ shop.name | escape }}">
          <meta itemprop="url" content="{{ request.origin }}">
        </a>
      </div>

      <div class="lux-header__right">
        {%- if show_search -%}
          <button
            type="button"
            class="lux-icon-btn"
            aria-label="Open search"
            aria-expanded="false"
            aria-controls="lux-search-{{ section.id }}"
            data-search-open
          >
            {% render 'lux-icon', name: 'search', class: 'lux-icon-btn__svg' %}
            <span class="lux-icon-btn__label">Search</span>
          </button>
        {%- endif -%}

        {%- if show_account -%}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="lux-icon-btn lux-icon-btn--desktop"
            aria-label="{% if customer %}Account{% else %}Sign in{% endif %}"
          >
            {% render 'lux-icon', name: 'user', class: 'lux-icon-btn__svg' %}
            <span class="lux-icon-btn__label">{% if customer %}Account{% else %}Sign in{% endif %}</span>
          </a>
        {%- endif -%}

        {%- if show_wishlist -%}
          <a href="{{ wishlist_url }}" class="lux-icon-btn lux-icon-btn--desktop" aria-label="{{ wishlist_label | escape }}">
            {% render 'lux-icon', name: 'heart', class: 'lux-icon-btn__svg' %}
            <span class="lux-icon-btn__label">{{ wishlist_label | escape }}</span>
          </a>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="lux-icon-btn lux-icon-btn--cart" aria-label="Cart, {{ cart.item_count }} items">
          {% render 'lux-icon', name: 'shopping-bag', class: 'lux-icon-btn__svg' %}
          <span class="lux-icon-btn__label">Cart</span>
          {%- if cart.item_count > 0 -%}
            <span class="lux-cart-count is-active" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
          {%- else -%}
            <span class="lux-cart-count" data-cart-count aria-hidden="true" hidden></span>
          {%- endif -%}
        </a>

        {%- if show_whatsapp -%}
          <a
            href="{{ section.settings.whatsapp_url }}"
            class="lux-cta lux-cta--desktop"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ whatsapp_label | escape }}"
          >
            {% render 'lux-icon', name: 'whatsapp', class: 'lux-cta__icon' %}
            <span class="lux-cta__label">{{ whatsapp_label | escape }}</span>
          </a>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <div class="lux-header__app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endfor -%}
      </div>
    </div>

    {%- if show_search -%}
      <div
        id="lux-search-{{ section.id }}"
        class="lux-search"
        hidden
        data-search-panel
      >
        <form action="{{ routes.search_url }}" method="get" role="search" class="lux-search__form">
          <input type="hidden" name="options[prefix]" value="last">
          <label class="lux-search__label" for="lux-search-input-{{ section.id }}">
            {% render 'lux-icon', name: 'search', class: 'lux-search__icon' %}
            <span class="lux-visually-hidden">Search</span>
          </label>
          <input
            id="lux-search-input-{{ section.id }}"
            class="lux-search__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="Search fragrances, attars, incense"
            autocomplete="off"
            spellcheck="false"
            data-search-input
          >
          <button type="button" class="lux-search__close" aria-label="Close search" data-search-close>
            {% render 'lux-icon', name: 'close', class: 'lux-search__close-icon' %}
          </button>
        </form>
      </div>
    {%- endif -%}
  </div>

  <div class="lux-drawer" id="lux-drawer-{{ section.id }}" hidden data-drawer>
    <button class="lux-drawer__scrim" type="button" aria-label="Close menu" data-drawer-close></button>

    <aside
      class="lux-drawer__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile menu"
      tabindex="-1"
      data-drawer-panel
    >
      <header class="lux-drawer__head">
        <a href="{{ routes.root_url }}" class="lux-drawer__brand" data-drawer-link aria-label="{{ shop.name | escape }}">
          {%- if use_asset_logo -%}
            <img
              src="{{ brand_logo_asset_url }}"
              alt="{{ shop.name | escape }}"
              width="1080"
              height="1080"
              loading="lazy"
              decoding="async"
              class="lux-drawer__brand-img lux-drawer__brand-img--asset"
            >
          {%- elsif logo_mobile != blank -%}
            {{ logo_mobile | image_url: width: 200 | image_tag:
              widths: '100,140,180,220',
              sizes: '120px',
              alt: logo_alt,
              loading: 'lazy',
              class: 'lux-drawer__brand-img'
            }}
          {%- else -%}
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <button class="lux-drawer__close" type="button" aria-label="Close menu" data-drawer-close>
          {% render 'lux-icon', name: 'close', class: 'lux-drawer__close-icon' %}
        </button>
      </header>

      {%- if show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="lux-drawer__search">
          {% render 'lux-icon', name: 'search', class: 'lux-drawer__search-icon' %}
          <label class="lux-visually-hidden" for="lux-drawer-q-{{ section.id }}">Search</label>
          <input
            id="lux-drawer-q-{{ section.id }}"
            type="search"
            name="q"
            placeholder="Search the collection"
            autocomplete="off"
          >
        </form>
      {%- endif -%}

      <nav class="lux-drawer__nav" aria-label="Mobile navigation">
        <ul class="lux-drawer__menu" role="list">
          {%- for link in main_menu.links -%}
            <li class="lux-drawer__item">
              {%- if link.links != blank -%}
                <details class="lux-acc">
                  <summary>
                    <span>{{ link.title | escape }}</span>
                    {% render 'lux-icon', name: 'chevron-down-sm', class: 'lux-acc__chevron' %}
                  </summary>
                  <div class="lux-acc__body">
                    <ul role="list">
                      {%- for child in link.links -%}
                        <li>
                          <a href="{{ child.url }}" data-drawer-link>{{ child.title | escape }}</a>
                          {%- if child.links != blank -%}
                            <ul class="lux-acc__sub" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}" data-drawer-link>{{ grandchild.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="lux-drawer__link" data-drawer-link>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="lux-drawer__quick">
        {%- if show_account -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="lux-drawer__quick-item" data-drawer-link>
            {% render 'lux-icon', name: 'user', class: 'lux-drawer__quick-icon' %}
            <span>{% if customer %}Account{% else %}Sign in{% endif %}</span>
          </a>
        {%- endif -%}
        {%- if show_wishlist -%}
          <a href="{{ wishlist_url }}" class="lux-drawer__quick-item" data-drawer-link>
            {% render 'lux-icon', name: 'heart', class: 'lux-drawer__quick-icon' %}
            <span>{{ wishlist_label | escape }}</span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="lux-drawer__quick-item" data-drawer-link>
          {% render 'lux-icon', name: 'shopping-bag', class: 'lux-drawer__quick-icon' %}
          <span>Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</span>
        </a>
      </div>

      {%- if show_whatsapp -%}
        <a
          href="{{ section.settings.whatsapp_url }}"
          class="lux-drawer__cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          {% render 'lux-icon', name: 'whatsapp', class: 'lux-drawer__cta-icon' %}
          <span>{{ whatsapp_label | escape }}</span>
        </a>
      {%- endif -%}

      {%- if show_country_selector or show_language_selector -%}
        {%- assign locale_form_id = 'lux-locale-' | append: section.id -%}
        <div class="lux-drawer__locale">
          {%- form 'localization', id: locale_form_id, class: 'lux-drawer__locale-form' -%}
            {%- if show_country_selector -%}
              <label class="lux-visually-hidden" for="lux-country-{{ section.id }}">Country</label>
              <select id="lux-country-{{ section.id }}" name="country_code">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }})
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            {%- if show_language_selector -%}
              <label class="lux-visually-hidden" for="lux-lang-{{ section.id }}">Language</label>
              <select id="lux-lang-{{ section.id }}" name="locale_code">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            <button type="submit" class="lux-drawer__locale-submit">Update</button>
          {%- endform -%}
        </div>
      {%- endif -%}

      <footer class="lux-drawer__foot">
        {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">Instagram</a>{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer">Facebook</a>{%- endif -%}
        {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer">YouTube</a>{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer">TikTok</a>{%- endif -%}
        {%- if drawer_footer_note != blank -%}<p>{{ drawer_footer_note | escape }}</p>{%- endif -%}
      </footer>
    </aside>
  </div>
</header>

{%- if settings.cart_type == 'notification' -%}
  {% render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop %}
{%- endif -%}

{% stylesheet %}
  .lux-header {
    --lux-z-bar: 35;
    --lux-z-drawer: 80;
    --lux-max: 1480px;

    --lux-bg: rgba(255, 255, 255, 0.92);
    --lux-bg-solid: #ffffff;
    --lux-soft: #f8f5f0;
    --lux-text: #181613;
    --lux-muted: #6f685f;
    --lux-accent: #a3823f;
    --lux-line: rgba(24, 22, 19, 0.12);
    --lux-line-soft: rgba(24, 22, 19, 0.06);
    --lux-shadow: 0 6px 24px rgba(20, 16, 12, 0.07);
    --lux-shadow-lg: 0 18px 50px rgba(18, 14, 10, 0.1);

    --lux-radius-pill: 999px;
    --lux-radius-md: 16px;
    --lux-radius-sm: 12px;

    --lux-touch: 44px;

    position: -webkit-sticky !important;
    position: sticky !important;
    inset-block-start: 0 !important;
    top: 0 !important;
    z-index: var(--lux-z-bar);
    margin-block-end: var(--lux-header-margin-bottom, 0);
    color: var(--lux-text);
    font-family: var(--font-body-family, 'Inter', system-ui, -apple-system, sans-serif);
    isolation: isolate;
    contain: layout style;
  }
  .lux-header.is-hidden,
  .lux-header.is-hidden .lux-header__bar {
    transform: none !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .lux-skip-link {
    position: absolute;
    inset-block-start: -100px;
    inset-inline-start: 1rem;
    background: #fff;
    color: #000;
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    z-index: 9;
    text-decoration: none;
    transition: inset-block-start 0.2s ease;
  }
  .lux-skip-link:focus {
    inset-block-start: 1rem;
  }

  .lux-visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  .lux-header__bar {
    background: var(--lux-bg);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-block-end: 1px solid transparent;
    transition: background-color 240ms ease, box-shadow 240ms ease, border-color 240ms ease, transform 280ms ease;
    will-change: transform;
  }
  .lux-header--with-border .lux-header__bar {
    border-block-end-color: var(--lux-line);
  }
  .lux-header.is-compact .lux-header__bar {
    background: var(--lux-bg-solid);
    box-shadow: var(--lux-shadow);
  }
  .lux-header.is-hidden .lux-header__bar {
    transform: none;
  }

  .lux-header__container {
    max-inline-size: var(--lux-max);
    margin-inline: auto;
    padding-inline: clamp(14px, 3vw, 36px);
    padding-block: var(--lux-header-pt, 14px) var(--lux-header-pb, 14px);
    min-block-size: clamp(86px, 9.5vw, 124px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: clamp(10px, 1.5vw, 22px);
    transition: padding 220ms ease, min-block-size 220ms ease;
  }
  .lux-header.is-compact .lux-header__container {
    min-block-size: clamp(72px, 7.5vw, 96px);
    padding-block: clamp(8px, 1vw, 12px);
  }

  .lux-header__left,
  .lux-header__right {
    display: flex;
    align-items: center;
    gap: clamp(4px, 0.6vw, 10px);
    min-inline-size: 0;
  }
  .lux-header__left { justify-content: flex-start; }
  .lux-header__right { justify-content: flex-end; }
  .lux-header__center {
    display: flex;
    justify-content: center;
    min-inline-size: 0;
  }

  .lux-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    line-height: 1;
  }
  .lux-logo__img {
    display: block;
    inline-size: auto;
    max-inline-size: clamp(160px, 18vw, 260px);
    max-block-size: clamp(56px, 6.5vw, 84px);
    object-fit: contain;
    transition: max-block-size 240ms ease, max-inline-size 240ms ease;
  }
  .lux-logo__img--asset {
    aspect-ratio: 1 / 1;
    max-inline-size: clamp(72px, 8.5vw, 104px);
    max-block-size: clamp(72px, 8.5vw, 104px);
    image-rendering: -webkit-optimize-contrast;
  }
  .lux-header.is-compact .lux-logo__img {
    max-block-size: clamp(48px, 5.2vw, 68px);
  }
  .lux-header.is-compact .lux-logo__img--asset {
    max-inline-size: clamp(60px, 6.6vw, 84px);
    max-block-size: clamp(60px, 6.6vw, 84px);
  }
  .lux-logo__text {
    font-size: clamp(1rem, 1vw + 0.7rem, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .lux-icon-btn {
    --pad: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-inline-size: var(--lux-touch);
    min-block-size: var(--lux-touch);
    padding: 8px var(--pad);
    border: 1px solid transparent;
    border-radius: var(--lux-radius-pill);
    background: transparent;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
    line-height: 1;
    position: relative;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }
  .lux-icon-btn:hover {
    background: var(--lux-soft);
  }
  .lux-icon-btn:active {
    transform: translate3d(0, 1px, 0);
  }
  .lux-icon-btn svg {
    inline-size: 20px;
    block-size: 20px;
    flex: none;
  }
  .lux-icon-btn__label {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lux-muted);
    white-space: nowrap;
  }

  .lux-icon-btn--cart {
    position: relative;
  }

  .lux-cart-count {
    position: absolute;
    inset-block-start: 4px;
    inset-inline-end: 2px;
    min-inline-size: 18px;
    block-size: 18px;
    padding-inline: 5px;
    border-radius: 999px;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 0.66rem;
    font-weight: 600;
    background: #1c1814;
    color: #fff;
    line-height: 1;
    border: 2px solid var(--lux-bg-solid, #fff);
    box-shadow: 0 2px 4px rgba(20, 16, 12, 0.18);
    pointer-events: none;
  }
  .lux-cart-count.is-active {
    display: inline-flex;
  }
  .lux-cart-count[hidden] {
    display: none !important;
  }

  .lux-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-block-size: var(--lux-touch);
    padding: 8px 16px;
    border-radius: var(--lux-radius-pill);
    background: #1c1814;
    color: #fff;
