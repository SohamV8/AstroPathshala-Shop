            <path d="M6 7H20L18.5 14H8L6 7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M6 7L5.2 4H3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <circle cx="9" cy="19" r="1.4" fill="currentColor"/>
