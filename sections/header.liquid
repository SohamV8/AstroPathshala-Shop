            <path d="M9.2 8.9C9.5 8.2 9.9 8.2 10.2 8.2H10.8C11.1 8.2 11.3 8.5 11.4 8.7L11.9 9.9C12 10.1 12 10.4 11.8 10.6L11.2 11.3C11.1 11.5 11.1 11.8 11.2 12C11.9 13.2 12.8 14.1 14 14.8C14.2 14.9 14.5 14.9 14.7 14.8L15.4 14.2C15.6 14.1 15.9 14.1 16.1 14.2L17.3 14.7C17.5 14.8 17.8 15 17.8 15.3V15.9C17.8 16.2 17.8 16.6 17.1 16.9C16.4 17.2 15.5 17.3 14.3 16.9C12.7 16.4 11.2 15.4 10 14.2C8.8 13 7.8 11.5 7.3 9.9C6.9 8.7 7 7.8 7.3 7.1C7.6 6.4 8 6.4 8.3 6.4H8.9C9.2 6.4 9.4 6.7 9.5 6.9L10 8.1C10.1 8.3 10.1 8.6 9.9 8.8L9.2 8.9Z" fill="currentColor"/>
          </svg>
          <span class="premium-header__utility-label premium-header__desktop-only">{{ section.settings.whatsapp_label | default: 'WhatsApp' }}</span>
