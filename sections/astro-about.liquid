{% comment %}
  Astro PathShala — About Us Page
  File: sections/astro-about.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.aab{font-family:var(--font-body);color:var(--black);background:transparent;}
.aab *{box-sizing:border-box;}

/* NAV */
.aab-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;min-height:80px;position:sticky;top:0;z-index:100;position:relative;}
.aab-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.aab-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.aab-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.aab-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.aab-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.aab-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.aab-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.aab-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.aab-nav-icon:hover{color:var(--black);}
.aab-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.aab-cart-btn:hover{background:var(--gold);}
.aab-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.aab-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.aab-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.aab-mob.open{display:block;}
.aab-mob ul{list-style:none;}
.aab-mob ul li{border-bottom:1px solid var(--border);}
.aab-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}

/* HERO */
.aab-hero{background:var(--dark);padding:96px 48px;text-align:center;position:relative;overflow:hidden;}
.aab-hero::before{content:'';position:absolute;top:-80px;left:50%;transform:translateX(-50%);width:500px;height:500px;border-radius:50%;border:1px solid rgba(184,134,11,0.1);pointer-events:none;}
.aab-hero::after{content:'';position:absolute;top:-40px;left:50%;transform:translateX(-50%);width:300px;height:300px;border-radius:50%;border:1px solid rgba(184,134,11,0.08);pointer-events:none;}
.aab-hero-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:block;}
.aab-hero-title{font-family:var(--font-heading);font-size:64px;font-weight:500;color:var(--gold-pale);line-height:1.08;margin-bottom:24px;}
.aab-hero-title em{font-style:italic;color:var(--gold);}
.aab-hero-desc{font-size:16px;color:var(--gold-lt);font-weight:300;line-height:1.8;max-width:600px;margin:0 auto 40px;}
.aab-hero-stats{display:flex;justify-content:center;gap:56px;flex-wrap:wrap;}
.aab-hero-stat-num{font-family:var(--font-heading);font-size:48px;color:var(--gold);font-weight:400;line-height:1;}
.aab-hero-stat-label{font-size:11px;color:var(--gold-lt);font-weight:300;margin-top:6px;letter-spacing:0.5px;}

/* STORY SECTION */
.aab-story{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--border);}
.aab-story-img{background:var(--cream);min-height:500px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.aab-story-img img{width:100%;height:100%;object-fit:cover;display:block;}
.aab-story-img-placeholder{display:flex;flex-direction:column;align-items:center;gap:20px;}
.aab-story-img-icon{font-size:80px;}
.aab-story-img-rings{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:300px;height:300px;border-radius:50%;border:1px solid rgba(184,134,11,0.15);}
.aab-story-content{padding:72px 56px;display:flex;flex-direction:column;justify-content:center;}
.aab-story-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:flex;align-items:center;gap:10px;}
.aab-story-label::before{content:'';width:20px;height:1px;background:var(--gold);}
.aab-story-title{font-family:var(--font-heading);font-size:42px;color:var(--black);font-weight:500;line-height:1.15;margin-bottom:22px;}
.aab-story-text{font-size:14px;color:var(--muted);line-height:1.9;font-weight:300;margin-bottom:16px;}

/* PHILOSOPHY */
.aab-philosophy{padding:80px 48px;background:var(--cream);border-top:1px solid var(--border);}
.aab-philosophy-inner{max-width:1200px;margin:0 auto;}
.aab-philosophy-hdr{text-align:center;margin-bottom:56px;}
.aab-philosophy-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.aab-philosophy-title{font-family:var(--font-heading);font-size:42px;color:var(--black);font-weight:500;margin-bottom:14px;}
.aab-philosophy-sub{font-size:14px;color:var(--muted);font-weight:300;line-height:1.8;max-width:560px;margin:0 auto;}
.aab-philosophy-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
.aab-phil-card{background:transparent;border:1px solid var(--border);border-radius:4px;padding:36px 28px;text-align:center;transition:border-color 0.2s,transform 0.2s;}
.aab-phil-card:hover{border-color:var(--gold);transform:translateY(-4px);}
.aab-phil-icon{width:70px;height:70px;border-radius:50%;background:var(--gold-pale);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 20px;}
.aab-phil-title{font-family:var(--font-heading);font-size:22px;color:var(--black);font-weight:500;margin-bottom:12px;}
.aab-phil-text{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;}

/* FOUNDER */
.aab-founder{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--border);}
.aab-founder-content{padding:72px 56px;display:flex;flex-direction:column;justify-content:center;background:var(--dark);}
.aab-founder-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:14px;display:flex;align-items:center;gap:10px;}
.aab-founder-label::before{content:'';width:20px;height:1px;background:var(--gold-lt);}
.aab-founder-title{font-family:var(--font-heading);font-size:42px;color:var(--gold-pale);font-weight:500;line-height:1.15;margin-bottom:8px;}
.aab-founder-name{font-size:14px;color:var(--gold);font-weight:500;letter-spacing:1px;margin-bottom:24px;}
.aab-founder-text{font-size:14px;color:var(--gold-lt);line-height:1.9;font-weight:300;margin-bottom:14px;}
.aab-founder-quote{border-left:3px solid var(--gold);padding-left:20px;margin-top:24px;}
.aab-founder-quote p{font-family:var(--font-heading);font-size:20px;color:var(--gold-pale);font-style:italic;line-height:1.7;}
.aab-founder-img{background:var(--cream);min-height:500px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.aab-founder-img img{width:100%;height:100%;object-fit:cover;display:block;}
.aab-founder-img-placeholder{font-size:80px;}

/* WHAT WE OFFER */
.aab-offer{padding:80px 48px;background:transparent;border-top:1px solid var(--border);}
.aab-offer-inner{max-width:1200px;margin:0 auto;}
.aab-offer-hdr{text-align:center;margin-bottom:56px;}
.aab-offer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.aab-offer-card{border:1px solid var(--border);border-radius:4px;overflow:hidden;text-decoration:none;display:block;transition:border-color 0.2s;}
.aab-offer-card:hover{border-color:var(--gold);}
.aab-offer-card:hover .aab-offer-card-title{color:var(--gold);}
.aab-offer-img{height:200px;display:flex;align-items:center;justify-content:center;font-size:60px;position:relative;}
.aab-offer-img.gems{background:var(--dark);}
.aab-offer-img.books{background:#2A1F08;}
.aab-offer-img.lal{background:#3D0A0A;}
.aab-offer-body{padding:24px 24px 28px;}
.aab-offer-card-label{font-size:9px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:8px;}
.aab-offer-card-title{font-family:var(--font-heading);font-size:22px;color:var(--black);font-weight:500;margin-bottom:10px;transition:color 0.2s;}
.aab-offer-card-text{font-size:13px;color:var(--muted);line-height:1.75;font-weight:300;margin-bottom:16px;}
.aab-offer-card-link{font-size:11px;color:var(--gold);font-weight:500;letter-spacing:0.8px;text-transform:uppercase;display:flex;align-items:center;gap:6px;}

/* WHY US */
.aab-why{padding:80px 48px;background:var(--dark);border-top:1px solid rgba(184,134,11,0.2);}
.aab-why-inner{max-width:1200px;margin:0 auto;}
.aab-why-hdr{text-align:center;margin-bottom:56px;}
.aab-why-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block;}
.aab-why-title{font-family:var(--font-heading);font-size:42px;color:var(--gold-pale);font-weight:500;}
.aab-why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
.aab-why-card{background:rgba(255,253,245,0.05);border:1px solid rgba(184,134,11,0.2);border-radius:4px;padding:32px 24px;text-align:center;transition:border-color 0.2s;}
.aab-why-card:hover{border-color:var(--gold);}
.aab-why-icon{font-size:36px;margin-bottom:16px;}
.aab-why-num{font-family:var(--font-heading);font-size:40px;color:var(--gold);font-weight:400;line-height:1;margin-bottom:6px;}
.aab-why-card-title{font-family:var(--font-heading);font-size:18px;color:var(--gold-pale);margin-bottom:10px;font-weight:500;}
.aab-why-card-text{font-size:12px;color:var(--gold-lt);line-height:1.75;font-weight:300;}

/* TESTIMONIALS */
.aab-testi{padding:80px 48px;background:transparent;border-top:1px solid var(--border);}
.aab-testi-inner{max-width:1200px;margin:0 auto;}
.aab-testi-hdr{text-align:center;margin-bottom:52px;}
.aab-testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.aab-testi-card{background:var(--cream);border:1px solid var(--border);border-radius:4px;padding:32px;transition:border-color 0.2s;}
.aab-testi-card:hover{border-color:var(--gold);}
.aab-testi-stars{color:var(--gold);font-size:12px;letter-spacing:2px;margin-bottom:16px;}
.aab-testi-text{font-size:15px;color:#4A3A10;line-height:1.8;font-family:var(--font-heading);font-style:italic;margin-bottom:18px;}
.aab-testi-author{font-size:11px;font-weight:500;color:var(--black);letter-spacing:0.8px;text-transform:uppercase;}

/* CTA */
.aab-cta{padding:80px 48px;background:var(--dark);text-align:center;border-top:1px solid rgba(184,134,11,0.2);}
.aab-cta-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:block;}
.aab-cta-title{font-family:var(--font-heading);font-size:52px;color:var(--gold-pale);font-weight:500;margin-bottom:16px;line-height:1.1;}
.aab-cta-sub{font-size:15px;color:var(--gold-lt);font-weight:300;margin-bottom:40px;line-height:1.7;max-width:500px;margin-left:auto;margin-right:auto;}
.aab-cta-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.aab-cta-btn-primary{padding:15px 36px;background:var(--gold);color:var(--ivory);border:none;font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.aab-cta-btn-primary:hover{background:var(--saffron);}
.aab-cta-btn-outline{padding:15px 36px;background:transparent;color:var(--gold-pale);border:1px solid rgba(201,168,76,0.5);font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:all 0.2s;}
.aab-cta-btn-outline:hover{border-color:var(--gold);color:var(--gold);}

/* FOOTER */
.aab-footer{background:var(--cream);}
.aab-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.aab-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.aab-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;}
.aab-footer-main{padding:56px 48px 40px;}
.aab-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.aab-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.aab-footer-social{display:flex;gap:10px;margin-top:20px;}
.aab-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.aab-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.aab-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.aab-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.aab-footer-col ul{list-style:none;}
.aab-footer-col ul li{margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.aab-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.6;}
.aab-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.aab-footer-col ul li a:hover{color:var(--gold);}
.aab-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.aab-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.aab-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.aab-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.aab-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.aab-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.aab-footer-legal{display:flex;gap:20px;}
.aab-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.aab-footer-legal a:hover{color:var(--gold);}

/* SHARED LABELS */
.aab-sec-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.aab-sec-title{font-family:var(--font-heading);font-size:42px;font-weight:500;color:var(--black);}
.aab-sec-sub{font-size:14px;color:var(--muted);font-weight:300;line-height:1.8;margin-top:10px;}

/* RESPONSIVE */
@media(max-width:1024px){
  .aab-nav,.aab-hero,.aab-philosophy,.aab-offer,.aab-why,.aab-testi,.aab-cta,.aab-footer-main,.aab-footer-topbar,.aab-footer-bottom{padding-left:28px;padding-right:28px;}
  .aab-story-content,.aab-founder-content{padding:52px 36px;}
  .aab-why-grid{grid-template-columns:repeat(2,1fr);}
  .aab-footer-grid{grid-template-columns:1fr 1fr;gap:32px;}
}
@media(max-width:768px){
  .aab-nav{padding:0 20px;min-height:68px;}
  .aab-nav-links{display:none;}
  .aab-burger{display:flex;}
  .aab-logo img{height:54px;}
  .aab-mob{top:68px;}
  .aab-hero{padding:64px 20px;}
  .aab-hero-title{font-size:44px;}
  .aab-hero-stats{gap:32px;}
  .aab-story,.aab-founder{grid-template-columns:1fr;}
  .aab-story-img,.aab-founder-img{min-height:300px;}
  .aab-story-content,.aab-founder-content{padding:40px 20px;}
  .aab-philosophy,.aab-offer,.aab-why,.aab-testi,.aab-cta{padding:52px 20px;}
  .aab-philosophy-grid,.aab-offer-grid{grid-template-columns:1fr;}
  .aab-testi-grid{grid-template-columns:1fr;}
  .aab-why-grid{grid-template-columns:1fr 1fr;}
  .aab-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .aab-footer-main,.aab-footer-topbar,.aab-footer-bottom{padding-left:20px;padding-right:20px;}
  .aab-footer-topbar{flex-direction:column;text-align:center;}
  .aab-footer-bottom{flex-direction:column;text-align:center;}
}
@media(max-width:480px){
  .aab-hero-title{font-size:36px;}
  .aab-cta-title{font-size:36px;}
  .aab-why-grid{grid-template-columns:1fr;}
  .aab-footer-grid{grid-template-columns:1fr;}
}
</style>

<div class="aab">


{%- comment -%} HERO {%- endcomment -%}
<div class="aab-hero">
  <span class="aab-hero-label">Our Story</span>
  <h1 class="aab-hero-title">{{ section.settings.hero_title | default: 'Ancient Wisdom,' }}<br><em>{{ section.settings.hero_title_italic | default: 'Modern Journey' }}</em></h1>
  <p class="aab-hero-desc">{{ section.settings.hero_desc | default: 'Astro PathShala was born from a deep reverence for Vedic astrology and a mission to make authentic gemstones and sacred knowledge accessible to every seeker.' }}</p>
  <div class="aab-hero-stats">
    <div>
      <div class="aab-hero-stat-num">{{ section.settings.stat1_num | default: '12K+' }}</div>
      <div class="aab-hero-stat-label">{{ section.settings.stat1_label | default: 'Happy Customers' }}</div>
    </div>
    <div>
      <div class="aab-hero-stat-num">{{ section.settings.stat2_num | default: '300+' }}</div>
      <div class="aab-hero-stat-label">{{ section.settings.stat2_label | default: 'Certified Gemstones' }}</div>
    </div>
    <div>
      <div class="aab-hero-stat-num">{{ section.settings.stat3_num | default: '8 Yrs' }}</div>
      <div class="aab-hero-stat-label">{{ section.settings.stat3_label | default: 'Trusted Experience' }}</div>
    </div>
    <div>
      <div class="aab-hero-stat-num">{{ section.settings.stat4_num | default: '50+' }}</div>
      <div class="aab-hero-stat-label">{{ section.settings.stat4_label | default: 'Expert E-Books' }}</div>
    </div>
  </div>
</div>

{%- comment -%} STORY SECTION {%- endcomment -%}
<div class="aab-story">
  <div class="aab-story-img">
    {%- if section.settings.story_image != blank -%}
      {{ section.settings.story_image | image_url: width: 900 | image_tag: style: 'width:100%;height:100%;object-fit:cover;', alt: 'Our Story' }}
    {%- else -%}
      <div class="aab-story-img-placeholder">
        <div class="aab-story-img-icon">&#128142;</div>
      </div>
    {%- endif -%}
  </div>
  <div class="aab-story-content">
    <span class="aab-story-label">How It Began</span>
    <h2 class="aab-story-title">{{ section.settings.story_title | default: 'Where Every Stone Carries a Purpose' }}</h2>
    <p class="aab-story-text">{{ section.settings.story_p1 | default: 'Astro PathShala began in 2017 with a single purpose — to bridge the ancient science of Vedic astrology with modern seekers who are searching for meaning, guidance and healing through nature.' }}</p>
    <p class="aab-story-text">{{ section.settings.story_p2 | default: 'Our founder, a dedicated student of Jyotish, spent years studying the sacred texts and sourcing gemstones directly from mines across India, Sri Lanka and Southeast Asia — building a network of trusted, ethical suppliers.' }}</p>
    <p class="aab-story-text">{{ section.settings.story_p3 | default: 'Today, we serve thousands of seekers across India and beyond — providing lab-certified gemstones, expert-authored e-books and powerful Lal Kitaab remedies, all guided by authentic Vedic wisdom.' }}</p>
  </div>
</div>

{%- comment -%} PHILOSOPHY {%- endcomment -%}
<div class="aab-philosophy">
  <div class="aab-philosophy-inner">
    <div class="aab-philosophy-hdr">
      <span class="aab-philosophy-label">What We Believe</span>
      <div class="aab-philosophy-title">Our Philosophy</div>
      <div class="aab-philosophy-sub">We believe the cosmos holds the answers — our role is to help you access them.</div>
    </div>
