{% comment %}
  Astro PathShala — Gemstone Collection Section
  File: sections/astro-collection-gemstones.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.agc{font-family:var(--font-body);color:var(--black);background:transparent;}
.agc *{box-sizing:border-box;}

/* NAV */
.agc-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;min-height:80px;position:sticky;top:0;z-index:100;position:relative;}
.agc-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.agc-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.agc-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.agc-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.agc-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.agc-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.agc-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.agc-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.agc-nav-icon:hover{color:var(--black);}
.agc-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.agc-cart-btn:hover{background:var(--gold);}
.agc-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.agc-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.agc-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.agc-mob.open{display:block;}
.agc-mob ul{list-style:none;}
.agc-mob ul li{border-bottom:1px solid var(--border);}
.agc-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}

/* BREADCRUMB */
.agc-crumb{padding:14px 48px;background:var(--cream);border-bottom:1px solid var(--border);font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px;}
.agc-crumb a{color:var(--muted);text-decoration:none;}
.agc-crumb a:hover{color:var(--gold);}
.agc-crumb-sep{color:var(--border);}
.agc-crumb-cur{color:var(--gold);font-weight:500;}

/* PAGE HEADER */
.agc-header{padding:48px 48px 40px;border-bottom:1px solid var(--border);display:flex;align-items:flex-end;justify-content:space-between;gap:24px;}
.agc-header-left{}
.agc-header-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:10px;display:flex;align-items:center;gap:10px;}
.agc-header-label::before{content:'';width:24px;height:1px;background:var(--gold);}
.agc-header-title{font-family:var(--font-heading);font-size:44px;font-weight:500;color:var(--black);line-height:1.1;}
.agc-header-desc{font-size:14px;color:var(--muted);margin-top:10px;font-weight:300;line-height:1.7;max-width:520px;}
.agc-header-right{display:flex;gap:36px;flex-shrink:0;}
.agc-hstat{text-align:right;}
.agc-hstat-num{font-family:var(--font-heading);font-size:32px;color:var(--gold);font-weight:400;line-height:1;}
.agc-hstat-label{font-size:11px;color:var(--muted);margin-top:4px;font-weight:300;}

/* TOOLBAR */
.agc-toolbar{display:flex;align-items:center;justify-content:space-between;padding:14px 48px;background:transparent;border-bottom:1px solid var(--border);}
.agc-count{font-size:13px;color:var(--muted);font-weight:300;}
.agc-count strong{color:var(--black);font-weight:500;}
.agc-toolbar-right{display:flex;align-items:center;gap:16px;}
.agc-sort-label{font-size:12px;color:var(--muted);}
.agc-sort{padding:8px 14px;border:1px solid var(--border);background:transparent;font-size:12px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;cursor:pointer;}
.agc-sort:focus{border-color:var(--gold);}




/* PRODUCT GRID */
.agc-grid-wrap{padding:36px 48px;}
.agc-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;}
.agc-card{text-decoration:none;display:block;}
.agc-card:hover .agc-card-img{border-color:var(--gold);}
.agc-card:hover .agc-card-name{color:var(--gold);}
.agc-card-img{height:260px;background:var(--cream);border:1px solid var(--border);border-radius:4px;position:relative;overflow:hidden;transition:border-color 0.2s;display:flex;align-items:center;justify-content:center;font-size:56px;}
.agc-card-img img{width:100%;height:100%;object-fit:cover;display:block;}
.agc-badge{position:absolute;top:10px;left:10px;background:var(--gold);color:var(--ivory);font-size:9px;padding:3px 9px;border-radius:2px;letter-spacing:0.8px;text-transform:uppercase;font-weight:500;}
.agc-badge.sale{background:var(--saffron);}
.agc-badge.new{background:var(--black);}
.agc-cert{position:absolute;bottom:10px;right:10px;background:rgba(253,248,232,0.95);border:1px solid var(--border);border-radius:2px;padding:3px 8px;font-size:9px;color:var(--muted);font-weight:500;letter-spacing:0.4px;text-transform:uppercase;}
.agc-card-body{padding:14px 2px 0;}
.agc-card-type{font-size:9px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:5px;}
.agc-card-name{font-family:var(--font-heading);font-size:18px;color:var(--black);font-weight:500;line-height:1.25;margin-bottom:4px;transition:color 0.2s;}
.agc-card-sub{font-size:11px;color:var(--muted);font-weight:300;margin-bottom:12px;}
.agc-card-footer{display:flex;align-items:center;justify-content:space-between;}
.agc-price{font-family:var(--font-heading);font-size:19px;color:var(--saffron);font-weight:500;}
.agc-compare{font-size:12px;color:#B0A060;text-decoration:line-through;margin-left:6px;}
.agc-view-btn{font-size:10px;color:var(--muted);font-weight:500;letter-spacing:0.8px;text-transform:uppercase;border-bottom:1px solid var(--border);padding-bottom:1px;transition:color 0.2s,border-color 0.2s;}
.agc-card:hover .agc-view-btn{color:var(--gold);border-color:var(--gold);}

/* EMPTY */
.agc-empty{text-align:center;padding:80px 40px;}
.agc-empty-icon{font-size:52px;margin-bottom:18px;}
.agc-empty-title{font-family:var(--font-heading);font-size:26px;color:var(--black);margin-bottom:8px;}
.agc-empty-desc{font-size:13px;color:var(--muted);font-weight:300;}

/* PAGINATION */
.agc-pagination{display:flex;justify-content:center;gap:8px;padding:40px 48px;}
.agc-page-link{padding:9px 16px;border:1px solid var(--border);color:var(--muted);text-decoration:none;font-size:12px;border-radius:2px;transition:all 0.2s;}
.agc-page-link:hover{border-color:var(--gold);color:var(--gold);}
.agc-page-current{padding:9px 16px;border:1px solid var(--gold);background:var(--gold);color:var(--ivory);font-size:12px;border-radius:2px;}


/* TRUST STRIP */
.agc-trust{display:flex;justify-content:center;background:var(--dark);border-top:1px solid #3A2A08;border-bottom:1px solid #3A2A08;flex-wrap:wrap;}
.agc-trust-item{display:flex;align-items:center;gap:10px;padding:14px 28px;font-size:11px;color:var(--gold-pale);letter-spacing:0.8px;text-transform:uppercase;font-weight:400;border-right:1px solid #3A2A08;}
.agc-trust-item:last-child{border-right:none;}
.agc-trust-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0;}

/* FOOTER */
.agc-footer{background:transparent;}
.agc-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.agc-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.agc-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;}
.agc-footer-main{padding:56px 48px 40px;}
.agc-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.agc-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.agc-footer-social{display:flex;gap:10px;margin-top:20px;}
.agc-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.agc-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.agc-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.agc-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.agc-footer-col ul{list-style:none;}
.agc-footer-col ul li{margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.agc-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.6;}
.agc-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.agc-footer-col ul li a:hover{color:var(--gold);}
.agc-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.agc-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.agc-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.agc-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.agc-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.agc-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.agc-footer-legal{display:flex;gap:20px;}
.agc-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.agc-footer-legal a:hover{color:var(--gold);}
/* RESPONSIVE */
@media(max-width:1024px){
  .agc-crumb,.agc-header,.agc-toolbar,.agc-grid-wrap,.agc-pagination{padding-left:28px;padding-right:28px;}
  .agc-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;}
}
@media(max-width:768px){
  .agc-nav{padding:0 20px;min-height:68px;}
  .agc-nav-links{display:none;}
  .agc-burger{display:flex;}
  .agc-logo img{height:54px;}
  .agc-mob{top:68px;}
  .agc-trust{flex-wrap:wrap;}
  .agc-trust-item{width:50%;border-right:none;border-bottom:1px solid #3A2A08;}
  .agc-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .agc-footer-main{padding:40px 20px;}
  .agc-footer-topbar{flex-direction:column;text-align:center;padding:14px 20px;}
  .agc-footer-bottom{flex-direction:column;text-align:center;padding:18px 20px;}
  .agc-crumb,.agc-header,.agc-toolbar,.agc-grid-wrap,.agc-pagination{padding-left:20px;padding-right:20px;}
  .agc-header{flex-direction:column;align-items:flex-start;padding-top:32px;padding-bottom:28px;}
  .agc-header-right{gap:24px;}
  .agc-hstat{text-align:left;}
  .agc-header-title{font-size:34px;}
  .agc-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;}
  .agc-toolbar{flex-wrap:wrap;gap:10px;}
}
@media(max-width:480px){
  .agc-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;}
  .agc-card-img{height:200px;}
  .agc-header-title{font-size:28px;}
  .agc-trust-item{width:100%;}
  .agc-footer-grid{grid-template-columns:1fr;}
}
</style>

<div class="agc">

  {%- comment -%} BREADCRUMB {%- endcomment -%}
  <div class="agc-crumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="agc-crumb-sep">›</span>
    <span class="agc-crumb-cur">{{ collection.title | default: 'Gemstone' }}</span>
  </div>


  {%- comment -%} TRUST STRIP {%- endcomment -%}
  <div class="agc-trust">
    <div class="agc-trust-item"><span class="agc-trust-dot"></span>Lab Certified Natural</div>
    <div class="agc-trust-item"><span class="agc-trust-dot"></span>Ethically Sourced</div>
    <div class="agc-trust-item"><span class="agc-trust-dot"></span>Free Shipping &#8377;999+</div>
    <div class="agc-trust-item"><span class="agc-trust-dot"></span>7-Day Easy Returns</div>
  </div>
  {%- comment -%} PAGE HEADER {%- endcomment -%}
  <div class="agc-header">
    <div class="agc-header-left">
      <div class="agc-header-label">Astro PathShala</div>
      <h1 class="agc-header-title">{{ section.settings.hero_title | default: 'Certified Gemstone' }}</h1>
      <p class="agc-header-desc">{{ section.settings.hero_desc | default: "Every gemstone is 100% natural and lab certified. Ethically sourced from trusted mines across India and Ceylon." }}</p>
    </div>
    <div class="agc-header-right">
      <div class="agc-hstat">
        <div class="agc-hstat-num">{{ section.settings.stat1_num | default: '300+' }}</div>
        <div class="agc-hstat-label">{{ section.settings.stat1_label | default: 'Gemstone' }}</div>
      </div>
      <div class="agc-hstat">
        <div class="agc-hstat-num">{{ section.settings.stat2_num | default: '100%' }}</div>
        <div class="agc-hstat-label">{{ section.settings.stat2_label | default: 'Lab Certified' }}</div>
      </div>
      <div class="agc-hstat">
        <div class="agc-hstat-num">{{ section.settings.stat3_num | default: '8 Yrs' }}</div>
        <div class="agc-hstat-label">{{ section.settings.stat3_label | default: 'Trusted' }}</div>
      </div>
    </div>
  </div>

  {%- comment -%} TOOLBAR {%- endcomment -%}
  <div class="agc-toolbar">
    <div class="agc-count">
      Showing <strong id="agc-visible">{{ collection.products_count }}</strong> gemstone
    </div>
    <div class="agc-toolbar-right">
      <span class="agc-sort-label">Sort</span>
      <select class="agc-sort" onchange="agcSort(this.value)">
        <option value="manual">Featured</option>
        <option value="price-asc">Price: Low to High</option>
        <option value="price-desc">Price: High to Low</option>
        <option value="title-asc">Name: A–Z</option>
        <option value="created-desc">Newest First</option>
      </select>
    </div>
  </div>



  {%- comment -%} PRODUCT GRID {%- endcomment -%}
  <div class="agc-grid-wrap">
    {%- if collection.products.size > 0 -%}
      <div class="agc-grid" id="agc-grid">
        {%- for product in collection.products -%}
          <a href="{{ product.url }}" class="agc-card"
             data-price="{{ product.price }}"
             data-title="{{ product.title | downcase }}"
             data-tags="{{ product.tags | join: ',' | downcase }}">
            <div class="agc-card-img">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}
              {%- else -%}
                &#128142;
              {%- endif -%}
              {%- if product.tags contains 'bestseller' or product.tags contains 'Bestseller' -%}
                <div class="agc-badge">Bestseller</div>
              {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
                <div class="agc-badge new">New</div>
              {%- elsif product.compare_at_price > product.price -%}
                <div class="agc-badge sale">Sale</div>
              {%- endif -%}
              <div class="agc-cert">&#10003; Lab Certified</div>
            </div>
            <div class="agc-card-body">
              <div class="agc-card-type">{{ product.product_type | default: 'Gemstone' }}</div>
              <div class="agc-card-name">{{ product.title }}</div>
              <div class="agc-card-sub">
                {%- assign planet_tag = '' -%}
                {%- for tag in product.tags -%}
                  {%- assign tl = tag | downcase -%}
                  {%- if tl == 'saturn' or tl == 'mars' or tl == 'sun' or tl == 'moon' or tl == 'mercury' or tl == 'jupiter' or tl == 'venus' or tl == 'rahu' or tl == 'ketu' -%}
                    {%- assign planet_tag = tag -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if planet_tag != '' -%}{{ planet_tag }} &nbsp;·&nbsp; {%- endif -%}
                {%- if product.variants.size > 1 -%}{{ product.variants.size }} sizes{%- else -%}{{ product.variants.first.title }}{%- endif -%}
              </div>
              <div class="agc-card-footer">
                <div>
                  <span class="agc-price">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="agc-compare">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
                <span class="agc-view-btn">View</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
      <div id="agc-empty" style="display:none;" class="agc-empty">
        <div class="agc-empty-icon">&#128142;</div>
        <div class="agc-empty-title">No gemstone found</div>
        <div class="agc-empty-desc">Try adjusting your filters.</div>
      </div>
    {%- else -%}
      <div class="agc-empty">
        <div class="agc-empty-icon">&#128142;</div>
        <div class="agc-empty-title">Coming Soon</div>
        <div class="agc-empty-desc">We are adding our gemstone collection. Please check back soon.</div>
      </div>
    {%- endif -%}

    {%- paginate collection.products by 20 -%}
      {%- if paginate.pages > 1 -%}
        <div class="agc-pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="agc-page-link">&#8592; Prev</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}" class="agc-page-link">{{ part.title }}</a>
            {%- else -%}<span class="agc-page-current">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="agc-page-link">Next &#8594;</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>

  </div>

<script>
function agcSort(val){
  var g=document.getElementById('agc-grid');
  if(!g)return;
  var cards=Array.from(g.querySelectorAll('.agc-card'));
  cards.sort(function(a,b){
    if(val==='price-asc')return parseFloat(a.dataset.price)-parseFloat(b.dataset.price);
    if(val==='price-desc')return parseFloat(b.dataset.price)-parseFloat(a.dataset.price);
    if(val==='title-asc')return a.dataset.title.localeCompare(b.dataset.title);
    return 0;
  });
  cards.forEach(function(c){g.appendChild(c);});
}
</script>

{% schema %}
{
  "name": "Gemstone Collection",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Page Header"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Title",
      "default": "Certified Gemstone"
    },
    {
      "type": "textarea",
      "id": "hero_desc",
      "label": "Description",
      "default": "Every gemstone is 100% natural and lab certified. Ethically sourced from trusted mines across India and Ceylon."
    },
    {
      "type": "text",
      "id": "stat1_num",
      "label": "Stat 1 number",
      "default": "300+"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 label",
      "default": "Gemstone"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Stat 2 number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 label",
      "default": "Lab Certified"
    },
    {
      "type": "text",
      "id": "stat3_num",
      "label": "Stat 3 number",
      "default": "8 Yrs"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 label",
      "default": "Trusted"
    },
    {
      "type": "header",
      "content": "Footer - Shop Links"
    },
    {
      "type": "url",
      "id": "footer_shop1_url",
      "label": "Shop link 1 URL"
    },
