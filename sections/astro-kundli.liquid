<script>
function akrToggle(id) {
  if (id === 'r1' || id === 'r2') { return; }
  var lbl = document.getElementById('lbl-r3');
  var check = document.getElementById('r3');
  if (lbl && check) { lbl.classList.toggle('selected', check.checked); }
}
function akrUpdateSummary() {
  var reportInputs = document.querySelectorAll('#akr-report-checks input[name=report_type]');
  var selectedReport = document.querySelector('#akr-report-checks input[name=report_type]:checked');
  var bundleCheck = document.getElementById('r3');
  var rows = document.getElementById('akr-summary-rows');
  var totalRow = document.getElementById('akr-total-row');
  var totalEl = document.getElementById('akr-total');
  var hiddenReports = document.getElementById('akr-selected-reports');
  var variantInput = document.getElementById('variant-id-input');
  var formEl = document.getElementById('kundli-form');
  var kundliVariantId = formEl ? formEl.getAttribute('data-kundli-variant-id') : '';
  var gemstoneVariantId = formEl ? formEl.getAttribute('data-gemstone-variant-id') : '';
  var total = 0;
  var selectedNames = [];
  var html = '';

  reportInputs.forEach(function(radio) {
    var wrap = radio.closest('.akr-check-label');
    if (wrap) wrap.classList.toggle('selected', radio.checked);
  });

  if (selectedReport) {
    var selectedPrice = parseInt(selectedReport.dataset.price) || 0;
    var selectedLabel = selectedReport.dataset.label || selectedReport.value;
    total += selectedPrice;
    selectedNames.push(selectedLabel + ' (₹' + selectedPrice + ')');
    html += '<div class="akr-summary-row"><span>' + selectedLabel + '</span><span>₹' + selectedPrice + '</span></div>';
    if (variantInput) {
      variantInput.value = selectedReport.value === 'gemstone' ? gemstoneVariantId : kundliVariantId;
    }
  }

  if (bundleCheck && bundleCheck.checked) {
    var kundliRadio = document.getElementById('r1');
    var gemstoneRadio = document.getElementById('r2');
    var kundliPrice = kundliRadio ? (parseInt(kundliRadio.dataset.price) || 0) : 0;
    var gemstonePrice = gemstoneRadio ? (parseInt(gemstoneRadio.dataset.price) || 0) : 0;
    var bundleTotal = kundliPrice + gemstonePrice;
    total = bundleTotal;
    selectedNames = [
      (kundliRadio ? kundliRadio.dataset.label : 'Kundli Report') + ' (₹' + kundliPrice + ')',
      (gemstoneRadio ? gemstoneRadio.dataset.label : 'Gemstone Report') + ' (₹' + gemstonePrice + ')'
    ];
    html = '<div class="akr-summary-row"><span>' + (kundliRadio ? kundliRadio.dataset.label : 'Kundli Report') + '</span><span>₹' + kundliPrice + '</span></div>';
    html += '<div class="akr-summary-row"><span>' + (gemstoneRadio ? gemstoneRadio.dataset.label : 'Gemstone Report') + '</span><span>₹' + gemstonePrice + '</span></div>';
  }

  if (html) {
    rows.innerHTML = html + '<div id="akr-summary-empty" style="display:none;"></div>';
    totalRow.style.display = 'flex';
    totalEl.textContent = '₹' + total;
  } else {
    rows.innerHTML = '<div class="akr-summary-empty" id="akr-summary-empty">No reports selected yet</div>';
    totalRow.style.display = 'none';
  }
  if (hiddenReports) hiddenReports.value = selectedNames.join(', ');
}
document.getElementById('kundli-form') && document.getElementById('kundli-form').addEventListener('submit', function(e) {
  e.preventDefault();
  var formEl = this;
  var submitBtn = document.getElementById('akr-submit-btn');
  var selectedReport = document.querySelector('#akr-report-checks input[name=report_type]:checked');
  var bundleCheck = document.getElementById('r3');
  var kundliVariantId = formEl.getAttribute('data-kundli-variant-id');
  var gemstoneVariantId = formEl.getAttribute('data-gemstone-variant-id');

  if (!selectedReport) {
    alert('Please select a report before submitting.');
    return;
  }

  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Processing...';
  }

  var formData = new FormData(formEl);
  var baseProperties = {};
  formData.forEach(function(value, key) {
    if (key.indexOf('properties[') === 0) {
      var propName = key.replace('properties[', '').replace(']', '');
      baseProperties[propName] = value;
    }
  });

  var items = [];
  if (bundleCheck && bundleCheck.checked) {
    if (kundliVariantId) items.push({ id: kundliVariantId, quantity: 1, properties: baseProperties });
    if (gemstoneVariantId) items.push({ id: gemstoneVariantId, quantity: 1, properties: baseProperties });
  } else {
    var targetVariantId = selectedReport.value === 'gemstone' ? gemstoneVariantId : kundliVariantId;
    if (targetVariantId) items.push({ id: targetVariantId, quantity: 1, properties: baseProperties });
  }

  if (items.length === 0) {
    window.location.href = '/checkout';
    return;
  }

  function addSingleItem(item) {
    var body = new URLSearchParams();
    body.append('id', item.id);
    body.append('quantity', item.quantity || 1);
    Object.keys(item.properties || {}).forEach(function(key) {
      body.append('properties[' + key + ']', item.properties[key]);
    });
    return fetch('{{ routes.cart_add_url }}.js', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
      },
      body: body.toString()
    }).then(function(response) {
      if (!response.ok) throw new Error('Failed to add item');
      return response.json();
    });
  }

  var addRequests = items.map(addSingleItem);
  Promise.all(addRequests)
    .then(function() {
      window.location.href = '/checkout';
    })
    .catch(function() {
      window.location.href = '{{ routes.cart_url }}';
    });
});
akrUpdateSummary();
</script>

