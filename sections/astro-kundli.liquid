{% comment %}
  Astro PathShala — Kundli Report Page (Enhanced)
  File: sections/astro-kundli.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.akr{font-family:var(--font-body);color:var(--black);background:transparent;}
.akr *{box-sizing:border-box;}

/* ── BREADCRUMB ── */
.akr-crumb{padding:14px 48px;background:var(--cream);border-bottom:1px solid var(--border);font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px;}
.akr-crumb a{color:var(--muted);text-decoration:none;}
.akr-crumb a:hover{color:var(--gold);}
.akr-crumb-sep{color:var(--border);}
.akr-crumb-cur{color:var(--gold);font-weight:500;}

/* ── HERO INTRO SECTION ── */
.akr-hero-intro{background:var(--dark);padding:72px 48px;text-align:center;position:relative;overflow:hidden;}
.akr-hero-intro::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:500px;height:500px;border-radius:50%;border:1px solid rgba(184,134,11,0.08);pointer-events:none;}
.akr-hero-intro-inner{position:relative;z-index:1;max-width:760px;margin:0 auto;}
.akr-hero-intro-label{font-size:10px;font-weight:500;letter-spacing:3.5px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:flex;align-items:center;justify-content:center;gap:12px;}
.akr-hero-intro-label::before,.akr-hero-intro-label::after{content:'';width:24px;height:1px;background:var(--gold-lt);}
.akr-hero-intro-title{font-family:var(--font-heading);font-size:56px;font-weight:500;color:var(--gold-pale);line-height:1.08;margin-bottom:18px;}
.akr-hero-intro-title em{font-style:italic;color:var(--gold);}
.akr-hero-intro-sub{font-size:15px;color:var(--gold-lt);font-weight:300;line-height:1.85;margin-bottom:36px;}
.akr-hero-intro-cta{
  display:inline-flex;align-items:center;gap:10px;
  padding:15px 36px;background:var(--gold);color:var(--ivory);
  font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;
  border-radius:2px;text-decoration:none;font-family:var(--font-body);
  transition:background 0.2s;
}
.akr-hero-intro-cta:hover{background:var(--saffron);}

/* ── WHAT IS KUNDLI SECTION ── */
.akr-explain{background:transparent;padding:72px 48px;border-bottom:1px solid var(--border);}
.akr-explain-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;}
.akr-explain-left{}
.akr-explain-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:flex;align-items:center;gap:10px;}
.akr-explain-label::before{content:'';width:20px;height:1px;background:var(--gold);}
.akr-explain-title{font-family:var(--font-heading);font-size:40px;font-weight:500;color:var(--black);line-height:1.15;margin-bottom:18px;}
.akr-explain-desc{font-size:14px;color:var(--muted);line-height:1.9;font-weight:300;margin-bottom:14px;}
.akr-explain-desc strong{color:var(--black);font-weight:500;}
.akr-explain-right{}
.akr-explain-subtitle{font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px;}
.akr-feature-list{display:flex;flex-direction:column;gap:12px;}
.akr-feature-item{display:flex;align-items:flex-start;gap:14px;padding:16px 18px;background:var(--cream);border:1px solid var(--border);border-radius:3px;transition:border-color 0.2s;}
.akr-feature-item:hover{border-color:var(--gold);}
.akr-feature-icon{font-size:20px;flex-shrink:0;margin-top:1px;}
.akr-feature-title{font-size:13px;font-weight:500;color:var(--black);margin-bottom:3px;}
.akr-feature-desc{font-size:12px;color:var(--muted);font-weight:300;line-height:1.6;}

/* ── WHAT YOU GET SECTION ── */
.akr-inside{background:var(--cream);padding:72px 48px;border-bottom:1px solid var(--border);}
.akr-inside-inner{max-width:1100px;margin:0 auto;}
.akr-inside-hdr{text-align:center;margin-bottom:52px;}
.akr-inside-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.akr-inside-title{font-family:var(--font-heading);font-size:40px;font-weight:500;color:var(--black);margin-bottom:10px;}
.akr-inside-sub{font-size:14px;color:var(--muted);font-weight:300;line-height:1.75;max-width:560px;margin:0 auto;}
.akr-inside-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.akr-inside-card{background:transparent;border:1px solid var(--border);border-radius:4px;padding:28px 24px;transition:border-color 0.2s,transform 0.2s;}
.akr-inside-card:hover{border-color:var(--gold);transform:translateY(-4px);}
.akr-inside-card-num{font-family:var(--font-heading);font-size:36px;color:var(--gold);font-weight:400;line-height:1;margin-bottom:12px;}
.akr-inside-card-title{font-family:var(--font-heading);font-size:19px;color:var(--black);font-weight:500;margin-bottom:8px;}
.akr-inside-card-desc{font-size:12px;color:var(--muted);font-weight:300;line-height:1.75;}
/* Bullet points inside card */
.akr-inside-card-bullets{list-style:none;margin-top:10px;display:flex;flex-direction:column;gap:5px;}
.akr-inside-card-bullets li{font-size:12px;color:var(--muted);font-weight:300;display:flex;align-items:flex-start;gap:8px;}
.akr-inside-card-bullets li::before{content:'✦';color:var(--gold);font-size:8px;flex-shrink:0;margin-top:3px;}

/* ── BENEFITS SECTION ── */
.akr-benefits{background:var(--dark);padding:72px 48px;}
.akr-benefits-inner{max-width:1100px;margin:0 auto;}
.akr-benefits-hdr{text-align:center;margin-bottom:52px;}
.akr-benefits-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block;}
.akr-benefits-title{font-family:var(--font-heading);font-size:40px;color:var(--gold-pale);font-weight:500;margin-bottom:10px;}
.akr-benefits-sub{font-size:14px;color:var(--gold-lt);font-weight:300;max-width:520px;margin:0 auto;line-height:1.75;}
.akr-benefits-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
.akr-benefit-item{display:flex;align-items:flex-start;gap:16px;padding:20px;background:rgba(255,253,245,0.05);border:1px solid rgba(184,134,11,0.18);border-radius:4px;transition:border-color 0.2s;}
.akr-benefit-item:hover{border-color:var(--gold);}
.akr-benefit-icon{font-size:24px;flex-shrink:0;width:48px;height:48px;border-radius:50%;background:rgba(184,134,11,0.12);display:flex;align-items:center;justify-content:center;}
.akr-benefit-title{font-size:14px;font-weight:500;color:var(--gold-pale);margin-bottom:4px;}
.akr-benefit-desc{font-size:12px;color:var(--gold-lt);font-weight:300;line-height:1.7;}

/* ── TRUST STRIP ── */
.akr-trust-strip{background:transparent;padding:48px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.akr-trust-strip-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:48px;flex-wrap:wrap;}
.akr-trust-strip-item{display:flex;align-items:center;gap:14px;}
.akr-trust-strip-icon{width:48px;height:48px;border-radius:50%;border:1px solid var(--border);background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.akr-trust-strip-num{font-family:var(--font-heading);font-size:26px;color:var(--saffron);font-weight:400;line-height:1;}
.akr-trust-strip-label{font-size:12px;color:var(--muted);font-weight:300;margin-top:2px;}

/* ── HOW IT WORKS ── */
.akr-how{background:var(--cream);padding:72px 48px;border-bottom:1px solid var(--border);}
.akr-how-inner{max-width:1100px;margin:0 auto;}
.akr-how-hdr{text-align:center;margin-bottom:52px;}
.akr-how-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.akr-how-title{font-family:var(--font-heading);font-size:40px;font-weight:500;color:var(--black);margin-bottom:10px;}
.akr-how-sub{font-size:14px;color:var(--muted);font-weight:300;max-width:520px;margin:0 auto;line-height:1.75;}
.akr-how-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.akr-how-step{text-align:center;padding:28px 20px;background:transparent;border:1px solid var(--border);border-radius:4px;position:relative;}
.akr-how-step:not(:last-child)::after{content:'→';position:absolute;right:-14px;top:50%;transform:translateY(-50%);color:var(--gold);font-size:18px;z-index:1;}
.akr-how-num{width:44px;height:44px;border-radius:50%;background:var(--gold);color:var(--ivory);font-family:var(--font-heading);font-size:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
.akr-how-step-icon{font-size:28px;margin-bottom:12px;}
.akr-how-step-title{font-family:var(--font-heading);font-size:17px;color:var(--black);margin-bottom:8px;font-weight:500;}
.akr-how-step-text{font-size:12px;color:var(--muted);line-height:1.7;font-weight:300;}

/* ── PAGE LAYOUT (existing) ── */
.akr-page{display:grid;grid-template-columns:1fr 1.1fr;min-height:calc(100vh - 80px);}

/* ── LEFT PANEL ── */
.akr-left{background:var(--dark);padding:56px 52px;display:flex;flex-direction:column;gap:0;position:sticky;top:0;height:100vh;overflow-y:auto;}
.akr-left::-webkit-scrollbar{width:4px;}
.akr-left::-webkit-scrollbar-thumb{background:rgba(184,134,11,0.3);border-radius:2px;}
.akr-left-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:14px;display:flex;align-items:center;gap:10px;}
.akr-left-label::before{content:'';width:20px;height:1px;background:var(--gold-lt);}
.akr-left-title{font-family:var(--font-heading);font-size:44px;font-weight:500;color:var(--gold-pale);line-height:1.1;margin-bottom:10px;}
.akr-left-title em{font-style:italic;color:var(--gold);}
.akr-left-sub{font-size:13px;color:var(--gold-lt);font-weight:300;line-height:1.8;margin-bottom:36px;}
.akr-reports-list{display:flex;flex-direction:column;gap:12px;margin-bottom:36px;}
.akr-report-item{display:flex;align-items:flex-start;gap:14px;padding:16px;background:rgba(255,253,245,0.05);border:1px solid rgba(184,134,11,0.18);border-radius:4px;}
.akr-report-icon{font-size:22px;flex-shrink:0;margin-top:2px;}
.akr-report-name{font-size:13px;font-weight:500;color:var(--gold-pale);margin-bottom:3px;}
.akr-report-desc{font-size:11px;color:var(--gold-lt);font-weight:300;line-height:1.6;}
.akr-report-price{font-family:var(--font-heading);font-size:16px;color:var(--gold);font-weight:400;margin-top:4px;}
.akr-trust-list{display:flex;flex-direction:column;gap:10px;padding-top:28px;border-top:1px solid rgba(184,134,11,0.15);}
.akr-trust-item{display:flex;align-items:center;gap:12px;font-size:12px;color:var(--gold-lt);font-weight:300;}
.akr-trust-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);flex-shrink:0;}
.akr-delivery-badge{margin-top:28px;padding:14px 18px;background:rgba(184,134,11,0.1);border:1px solid rgba(184,134,11,0.3);border-radius:4px;display:flex;align-items:center;gap:14px;}
.akr-delivery-icon{font-size:24px;flex-shrink:0;}
.akr-delivery-text strong{display:block;font-size:13px;color:var(--gold-pale);font-weight:500;margin-bottom:2px;}
.akr-delivery-text span{font-size:11px;color:var(--gold-lt);font-weight:300;}

/* ── RIGHT PANEL ── */
.akr-right{padding:56px 52px;background:transparent;overflow-y:auto;}
.akr-form-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:10px;display:flex;align-items:center;gap:10px;}
.akr-form-label::before{content:'';width:20px;height:1px;background:var(--gold);}
.akr-form-title{font-family:var(--font-heading);font-size:36px;color:var(--black);font-weight:500;margin-bottom:6px;}
.akr-form-sub{font-size:13px;color:var(--muted);font-weight:300;line-height:1.7;margin-bottom:36px;}
.akr-form{display:flex;flex-direction:column;gap:20px;}
.akr-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.akr-field{display:flex;flex-direction:column;gap:6px;}
.akr-field-label{font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);}
.akr-field-label span{color:var(--saffron);}
.akr-input{padding:13px 16px;border:1px solid var(--border);background:var(--cream);font-size:13px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;transition:border-color 0.2s;width:100%;}
.akr-input:focus{border-color:var(--gold);}
.akr-input::placeholder{color:#C0A870;}
.akr-select{padding:13px 16px;border:1px solid var(--border);background:var(--cream);font-size:13px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;cursor:pointer;width:100%;appearance:none;background-image:url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%237A6535' stroke-width='1.2' stroke-linecap='round'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 14px center;}
.akr-select:focus{border-color:var(--gold);}
.akr-textarea{padding:13px 16px;border:1px solid var(--border);background:var(--cream);font-size:13px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;transition:border-color 0.2s;width:100%;resize:vertical;min-height:88px;line-height:1.6;}
.akr-textarea:focus{border-color:var(--gold);}
.akr-section-title{font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);margin-bottom:12px;}
.akr-report-checks{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.akr-check-label{display:flex;align-items:flex-start;gap:10px;padding:14px;border:1px solid var(--border);border-radius:3px;cursor:pointer;transition:border-color 0.2s,background 0.2s;background:var(--cream);}
.akr-check-label:hover{border-color:var(--gold);}
.akr-check-label.selected{border-color:var(--gold);background:var(--gold-pale);}
.akr-check-label input[type=checkbox]{accent-color:var(--gold);width:15px;height:15px;flex-shrink:0;margin-top:2px;}
.akr-check-info{}
.akr-check-name{font-size:12px;font-weight:500;color:var(--black);margin-bottom:2px;}
.akr-check-price{font-family:var(--font-heading);font-size:15px;color:var(--saffron);}
.akr-summary{background:var(--cream);border:1px solid var(--border);border-radius:4px;padding:20px;}
.akr-summary-title{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:14px;}
.akr-summary-rows{display:flex;flex-direction:column;gap:8px;margin-bottom:14px;}
.akr-summary-row{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);font-weight:300;}
.akr-summary-row.total{font-weight:500;color:var(--black);border-top:1px solid var(--border);padding-top:10px;margin-top:4px;}
.akr-summary-row.total .akr-summary-price{font-family:var(--font-heading);font-size:20px;color:var(--saffron);}
.akr-summary-empty{font-size:12px;color:var(--muted);font-weight:300;text-align:center;padding:8px 0;}
.akr-submit-wrap{display:flex;flex-direction:column;gap:10px;}
.akr-submit{padding:16px 32px;background:var(--black);color:var(--ivory);border:none;font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);transition:background 0.2s;text-align:center;width:100%;}
.akr-submit:hover{background:var(--gold);}
.akr-submit-note{font-size:11px;color:var(--muted);font-weight:300;text-align:center;line-height:1.6;}
.akr-divider{height:1px;background:var(--border);}
.akr-success{display:none;text-align:center;padding:40px 20px;}
.akr-success-icon{font-size:52px;margin-bottom:16px;}
.akr-success-title{font-family:var(--font-heading);font-size:32px;color:var(--black);margin-bottom:10px;}
.akr-success-sub{font-size:14px;color:var(--muted);font-weight:300;line-height:1.7;}

/* ── TESTIMONIALS ── */
.akr-testi{background:transparent;padding:72px 48px;border-top:1px solid var(--border);}
.akr-testi-inner{max-width:1100px;margin:0 auto;}
.akr-testi-hdr{text-align:center;margin-bottom:48px;}
.akr-testi-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.akr-testi-title{font-family:var(--font-heading);font-size:38px;font-weight:500;color:var(--black);}
.akr-testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.akr-testi-card{background:var(--cream);border:1px solid var(--border);border-radius:4px;padding:28px;transition:border-color 0.2s;}
.akr-testi-card:hover{border-color:var(--gold);}
.akr-testi-stars{color:var(--gold);font-size:12px;letter-spacing:2px;margin-bottom:14px;}
.akr-testi-text{font-size:14px;color:#4A3A10;line-height:1.8;font-family:var(--font-heading);font-style:italic;margin-bottom:16px;}
.akr-testi-author{font-size:11px;font-weight:500;color:var(--black);letter-spacing:.8px;text-transform:uppercase;}
.akr-testi-detail{font-size:11px;color:var(--muted);font-weight:300;margin-top:2px;}

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .akr-hero-intro,.akr-explain,.akr-inside,.akr-benefits,.akr-trust-strip,.akr-how,.akr-testi{padding-left:28px;padding-right:28px;}
  .akr-page{grid-template-columns:1fr 1fr;}
  .akr-left,.akr-right{padding:40px 36px;}
  .akr-left-title{font-size:36px;}
  .akr-inside-grid{grid-template-columns:1fr 1fr;}
  .akr-how-steps{grid-template-columns:1fr 1fr;gap:16px;}
  .akr-how-step:not(:last-child)::after{display:none;}
}
@media(max-width:768px){
  .akr-crumb{padding:12px 20px;}
  .akr-hero-intro{padding:52px 20px;}
  .akr-hero-intro-title{font-size:38px;}
  .akr-explain,.akr-inside,.akr-benefits,.akr-trust-strip,.akr-how,.akr-testi{padding-left:20px;padding-right:20px;}
  .akr-explain-inner{grid-template-columns:1fr;}
  .akr-inside-grid{grid-template-columns:1fr;}
  .akr-benefits-grid{grid-template-columns:1fr;}
  .akr-how-steps{grid-template-columns:1fr 1fr;}
  .akr-trust-strip-inner{gap:28px;}
  .akr-testi-grid{grid-template-columns:1fr;}
  .akr-page{grid-template-columns:1fr;}
  .akr-left{position:relative;height:auto;padding:40px 24px;}
  .akr-right{padding:40px 24px;}
  .akr-row{grid-template-columns:1fr;}
  .akr-report-checks{grid-template-columns:1fr;}
}
@media(max-width:480px){
  .akr-hero-intro-title{font-size:30px;}
  .akr-left-title{font-size:30px;}
  .akr-form-title{font-size:28px;}
  .akr-how-steps{grid-template-columns:1fr;}
  .akr-how-step::after{display:none;}
}
</style>

<div class="akr">

{%- comment -%} BREADCRUMB {%- endcomment -%}
<div class="akr-crumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span class="akr-crumb-sep">›</span>
  <span class="akr-crumb-cur">{{ section.settings.page_title | default: 'Kundli Report' }}</span>
</div>

{%- comment -%} ── HERO INTRO ── {%- endcomment -%}
<div class="akr-hero-intro">
  <div class="akr-hero-intro-inner">
    <div class="akr-hero-intro-label">{{ section.settings.intro_label | default: 'Vedic Astrology' }}</div>
    <h1 class="akr-hero-intro-title">{{ section.settings.intro_title | default: 'Your Complete' }}<br><em>{{ section.settings.intro_title_italic | default: 'Kundli Report' }}</em></h1>
    <p class="akr-hero-intro-sub">{{ section.settings.intro_sub | default: "A deeply personalised Vedic birth chart analysis prepared by our expert astrologers — revealing the blueprint of your destiny written in the stars at the moment of your birth." }}</p>
    <a href="{{ section.settings.intro_cta_link | default: '#akr-order-form' }}" class="akr-hero-intro-cta">
      {{ section.settings.intro_cta_text | default: 'Order Your Report Now' }} &#8594;
    </a>
