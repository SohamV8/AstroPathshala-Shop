<script>
function ablFilter(btn, tag) {
  document.querySelectorAll('.abl-filter-btn').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  var cards = document.querySelectorAll('#abl-grid .abl-card');
  var visible = 0;
  cards.forEach(function(card) {
    if (tag === 'all') {
      card.style.display = 'block';
      visible++;
    } else {
      var tags = card.dataset.tags || '';
      if (tags.indexOf(tag) !== -1) {
        card.style.display = 'block';
        visible++;
      } else {
        card.style.display = 'none';
      }
    }
  });
  var noResults = document.getElementById('abl-no-results');
  var grid = document.getElementById('abl-grid');
  if (noResults && grid) {
    noResults.style.display = visible === 0 ? 'block' : 'none';
    grid.style.display = visible === 0 ? 'none' : 'grid';
  }
}
</script>

