{% comment %}
  Astro PathShala — Blog Listing Page
  File: sections/blog-listing.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.abl{font-family:var(--font-body);color:var(--black);background:transparent;}
.abl *{box-sizing:border-box;}

/* NAV */
.abl-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;min-height:80px;position:sticky;top:0;z-index:100;position:relative;}
.abl-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.abl-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.abl-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.abl-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.abl-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.abl-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.abl-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.abl-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.abl-nav-icon:hover{color:var(--black);}
.abl-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.abl-cart-btn:hover{background:var(--gold);}
.abl-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.abl-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.abl-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.abl-mob.open{display:block;}
.abl-mob ul{list-style:none;}
.abl-mob ul li{border-bottom:1px solid var(--border);}
.abl-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}

/* HERO */
.abl-hero{background:var(--black);padding:100px 48px;text-align:center;position:relative;overflow:hidden;}
.abl-hero::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:600px;border-radius:50%;border:1px solid rgba(184,134,11,0.07);pointer-events:none;animation:ablPulse 6s ease-in-out infinite;}
.abl-hero::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:360px;height:360px;border-radius:50%;border:1px solid rgba(184,134,11,0.1);pointer-events:none;animation:ablPulse 6s ease-in-out infinite 1s;}
@keyframes ablPulse{0%,100%{opacity:0.4;transform:translate(-50%,-50%) scale(1);}50%{opacity:1;transform:translate(-50%,-50%) scale(1.04);}}
@keyframes ablFadeUp{from{opacity:0;transform:translateY(28px);}to{opacity:1;transform:translateY(0);}}
.abl-hero-inner{position:relative;z-index:1;}
.abl-hero-label{font-size:10px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:18px;display:block;animation:ablFadeUp 0.8s ease both;}
.abl-hero-title{font-family:var(--font-heading);font-size:72px;font-weight:500;color:var(--gold-pale);line-height:1.06;margin-bottom:20px;animation:ablFadeUp 0.8s ease 0.15s both;}
.abl-hero-title em{font-style:italic;color:var(--gold);}
.abl-hero-sub{font-size:16px;color:var(--gold-lt);font-weight:300;line-height:1.8;max-width:520px;margin:0 auto;animation:ablFadeUp 0.8s ease 0.3s both;}
.abl-hero-divider{width:40px;height:1px;background:var(--gold);margin:32px auto 0;animation:ablFadeUp 0.8s ease 0.45s both;}

/* CATEGORY FILTER */
.abl-filter{padding:0 48px;background:transparent;border-bottom:1px solid var(--border);}
.abl-filter-inner{display:flex;align-items:center;gap:0;overflow-x:auto;scrollbar-width:none;}
.abl-filter-inner::-webkit-scrollbar{display:none;}
.abl-filter-btn{padding:18px 24px;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);cursor:pointer;white-space:nowrap;border:none;background:none;font-family:var(--font-body);border-bottom:2px solid transparent;transition:color 0.2s,border-color 0.2s;}
.abl-filter-btn:hover{color:var(--black);}
.abl-filter-btn.active{color:var(--black);border-bottom-color:var(--gold);}
.abl-filter-count{font-size:10px;color:var(--muted);background:var(--cream);border-radius:10px;padding:2px 7px;margin-left:6px;font-weight:400;}

/* BLOG GRID */
.abl-grid-wrap{padding:56px 48px 72px;}
.abl-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px;}
.abl-card{text-decoration:none;display:block;background:transparent;}
.abl-card-img-wrap{overflow:hidden;border-radius:4px;margin-bottom:22px;border:1px solid var(--border);aspect-ratio:16/10;background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:52px;position:relative;transition:border-color 0.25s;}
.abl-card:hover .abl-card-img-wrap{border-color:var(--gold);}
.abl-card-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.5s ease;}
.abl-card:hover .abl-card-img{transform:scale(1.06);}
.abl-card-tag{font-size:9px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;display:flex;align-items:center;gap:8px;}
.abl-card-tag::before{content:'';width:16px;height:1px;background:var(--gold);}
.abl-card-title{font-family:var(--font-heading);font-size:22px;color:var(--black);font-weight:500;line-height:1.3;margin-bottom:12px;position:relative;display:inline;}
.abl-card-title-wrap{margin-bottom:12px;}
.abl-card-title{background-image:linear-gradient(var(--gold),var(--gold));background-size:0 1px;background-repeat:no-repeat;background-position:0 100%;transition:background-size 0.35s ease;}
.abl-card:hover .abl-card-title{background-size:100% 1px;}
.abl-card-excerpt{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;margin-bottom:18px;}
.abl-card-footer{display:flex;align-items:center;justify-content:space-between;}
.abl-card-meta{font-size:11px;color:#B0A060;font-weight:300;display:flex;align-items:center;gap:6px;}
.abl-card-meta-dot{width:3px;height:3px;border-radius:50%;background:var(--border);display:inline-block;}
.abl-read-more{font-size:11px;font-weight:500;letter-spacing:1px;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:6px;transition:gap 0.2s;}
.abl-card:hover .abl-read-more{gap:10px;}

/* FEATURED ARTICLE (first card, full width) */
.abl-card.featured{grid-column:1/-1;}
.abl-card.featured .abl-card-img-wrap{aspect-ratio:21/8;margin-bottom:28px;}
.abl-card.featured .abl-card-title{font-size:36px;}
.abl-card.featured .abl-card-excerpt{font-size:14px;max-width:680px;}
.abl-card.featured .abl-card-inner{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:end;}

/* EMPTY STATE */
.abl-empty{text-align:center;padding:80px 40px;}
.abl-empty-icon{font-size:52px;margin-bottom:18px;}
.abl-empty-title{font-family:var(--font-heading);font-size:28px;color:var(--black);margin-bottom:10px;}
.abl-empty-sub{font-size:13px;color:var(--muted);font-weight:300;}

/* PAGINATION */
.abl-pagination{display:flex;justify-content:center;gap:8px;padding:0 48px 56px;}
.abl-page-link{padding:10px 18px;border:1px solid var(--border);color:var(--muted);text-decoration:none;font-size:12px;border-radius:2px;transition:all 0.2s;font-family:var(--font-body);}
.abl-page-link:hover{border-color:var(--gold);color:var(--gold);}
.abl-page-current{padding:10px 18px;border:1px solid var(--gold);background:var(--gold);color:var(--ivory);font-size:12px;border-radius:2px;font-family:var(--font-body);}

/* NEWSLETTER */
.abl-nl{background:var(--black);padding:80px 48px;text-align:center;border-top:1px solid rgba(184,134,11,0.2);}
.abl-nl-label{font-size:10px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:block;}
.abl-nl-title{font-family:var(--font-heading);font-size:48px;color:var(--gold-pale);font-weight:500;margin-bottom:12px;line-height:1.1;}
.abl-nl-title em{font-style:italic;color:var(--gold);}
.abl-nl-sub{font-size:14px;color:var(--gold-lt);font-weight:300;margin-bottom:36px;line-height:1.7;max-width:460px;margin-left:auto;margin-right:auto;}
.abl-nl-form{display:flex;justify-content:center;max-width:480px;margin:0 auto 20px;}
.abl-nl-input{flex:1;padding:15px 20px;border:1px solid rgba(184,134,11,0.3);border-right:none;background:rgba(255,253,245,0.05);font-size:13px;font-family:var(--font-body);color:var(--gold-pale);outline:none;border-radius:2px 0 0 2px;transition:border-color 0.2s;}
.abl-nl-input::placeholder{color:rgba(201,168,76,0.5);}
.abl-nl-input:focus{border-color:var(--gold);}
.abl-nl-btn{background:var(--gold);color:var(--ivory);padding:15px 28px;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;border:none;cursor:pointer;font-family:var(--font-body);border-radius:0 2px 2px 0;transition:background 0.2s;white-space:nowrap;}
.abl-nl-btn:hover{background:var(--saffron);}
.abl-nl-note{font-size:11px;color:rgba(201,168,76,0.5);font-weight:300;}

/* FOOTER */
.abl-footer{background:var(--cream);}
.abl-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.abl-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.abl-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;}
.abl-footer-main{padding:56px 48px 40px;}
.abl-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.abl-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.abl-footer-social{display:flex;gap:10px;margin-top:20px;}
.abl-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.abl-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.abl-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.abl-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.abl-footer-col ul{list-style:none;}
.abl-footer-col ul li{margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.abl-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.6;}
.abl-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.abl-footer-col ul li a:hover{color:var(--gold);}
.abl-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.abl-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.abl-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.abl-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.abl-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.abl-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.abl-footer-legal{display:flex;gap:20px;}
.abl-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.abl-footer-legal a:hover{color:var(--gold);}

/* RESPONSIVE */
@media(max-width:1024px){
  .abl-nav,.abl-filter,.abl-grid-wrap,.abl-pagination,.abl-nl,.abl-footer-main,.abl-footer-topbar,.abl-footer-bottom{padding-left:28px;padding-right:28px;}
  .abl-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;}
  .abl-card.featured .abl-card-inner{grid-template-columns:1fr;}
  .abl-hero{padding:80px 28px;}
  .abl-hero-title{font-size:56px;}
  .abl-footer-grid{grid-template-columns:1fr 1fr;gap:32px;}
}
@media(max-width:768px){
  .abl-nav{padding:0 20px;min-height:68px;}
  .abl-nav-links{display:none;}
  .abl-burger{display:flex;}
  .abl-logo img{height:54px;}
  .abl-mob{top:68px;}
  .abl-hero{padding:64px 20px;}
  .abl-hero-title{font-size:42px;}
  .abl-hero-sub{font-size:14px;}
  .abl-filter{padding:0 20px;}
  .abl-grid-wrap,.abl-pagination,.abl-nl{padding-left:20px;padding-right:20px;}
  .abl-grid{grid-template-columns:1fr;gap:36px;}
  .abl-card.featured{grid-column:auto;}
  .abl-card.featured .abl-card-img-wrap{aspect-ratio:16/10;}
  .abl-card.featured .abl-card-title{font-size:24px;}
  .abl-nl-form{flex-direction:column;gap:0;}
  .abl-nl-input{border-right:1px solid rgba(184,134,11,0.3);border-bottom:none;border-radius:2px 2px 0 0;}
  .abl-nl-btn{border-radius:0 0 2px 2px;padding:14px;}
  .abl-nl-title{font-size:36px;}
  .abl-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .abl-footer-main,.abl-footer-topbar,.abl-footer-bottom{padding-left:20px;padding-right:20px;}
  .abl-footer-topbar{flex-direction:column;text-align:center;}
  .abl-footer-bottom{flex-direction:column;text-align:center;}
}
@media(max-width:480px){
  .abl-hero-title{font-size:34px;}
  .abl-nl-title{font-size:28px;}
  .abl-footer-grid{grid-template-columns:1fr;}
}
</style>

<div class="abl">

{%- comment -%} NAV {%- endcomment -%}
{%- assign main_menu = linklists[section.settings.menu] -%}
<nav class="abl-nav">
  <a href="{{ routes.root_url }}" class="abl-logo">
    {%- if section.settings.logo_image != blank -%}
      {{ section.settings.logo_image | image_url: width: 240 | image_tag: style: 'height:68px;width:auto;display:block;object-fit:contain;', alt: shop.name }}
    {%- else -%}
      <span class="abl-logo-text">{{ shop.name }}</span>
    {%- endif -%}
  </a>
  <ul class="abl-nav-links">
    {%- if main_menu != blank -%}
      {%- for link in main_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
    {%- else -%}
      <li><a href="/collections/gemstones">Gemstones</a></li>
      <li><a href="/collections/e-books">E-Books</a></li>
      <li><a href="/collections/lal-kitaab">Lal Kitaab</a></li>
      <li><a href="/pages/about">About</a></li>
      <li><a href="/blogs/news">Blog</a></li>
    {%- endif -%}
  </ul>
  <div class="abl-nav-right">
    <a href="{{ routes.search_url }}" class="abl-nav-icon" aria-label="Search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></a>
    <a href="{{ routes.account_url }}" class="abl-nav-icon" aria-label="Account"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
    <a href="{{ routes.cart_url }}" class="abl-cart-btn">Cart ({{ cart.item_count }})</a>
    <div class="abl-burger" onclick="document.getElementById('abl-mob').classList.toggle('open')"><span></span><span></span><span></span></div>
  </div>
  <div class="abl-mob" id="abl-mob">
    <ul>
      {%- if main_menu != blank -%}
        {%- for link in main_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
      {%- else -%}
        <li><a href="/collections/gemstones">Gemstones</a></li>
        <li><a href="/collections/e-books">E-Books</a></li>
        <li><a href="/collections/lal-kitaab">Lal Kitaab</a></li>
        <li><a href="/pages/about">About</a></li>
        <li><a href="/blogs/news">Blog</a></li>
      {%- endif -%}
    </ul>
  </div>
</nav>

{%- comment -%} HERO {%- endcomment -%}
<div class="abl-hero">
  <div class="abl-hero-inner">
    <span class="abl-hero-label">{{ section.settings.hero_label | default: 'Astro PathShala' }}</span>
    <h1 class="abl-hero-title">{{ section.settings.hero_title | default: 'Sacred' }} <em>{{ section.settings.hero_title_italic | default: 'Knowledge' }}</em></h1>
    <p class="abl-hero-sub">{{ section.settings.hero_sub | default: 'Ancient wisdom, modern guidance for your spiritual journey' }}</p>
    <div class="abl-hero-divider"></div>
  </div>
</div>

{%- comment -%} CATEGORY FILTER {%- endcomment -%}
{%- assign blog_handle = section.settings.blog_handle | default: 'news' -%}
{%- assign featured_blog = blogs[blog_handle] -%}
{%- assign all_tags = '' -%}
{%- for article in featured_blog.articles limit: 50 -%}
  {%- for tag in article.tags -%}
    {%- unless all_tags contains tag -%}
      {%- assign all_tags = all_tags | append: tag | append: '|' -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign tag_list = all_tags | split: '|' | uniq -%}

<div class="abl-filter">
  <div class="abl-filter-inner">
    <button class="abl-filter-btn active" data-tag="all" onclick="ablFilter(this,'all')">
      All
      <span class="abl-filter-count">{{ featured_blog.articles_count }}</span>
    </button>
    {%- for tag in tag_list -%}
      {%- if tag != blank -%}
        <button class="abl-filter-btn" data-tag="{{ tag | downcase | replace: ' ', '-' }}" onclick="ablFilter(this,'{{ tag | downcase | replace: ' ', '-' }}')">
          {{ tag }}
        </button>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{%- comment -%} BLOG GRID {%- endcomment -%}
<div class="abl-grid-wrap">
  {%- if featured_blog.articles.size > 0 -%}
    <div class="abl-grid" id="abl-grid">
      {%- for article in featured_blog.articles -%}
        {%- assign article_tags = '' -%}
        {%- for tag in article.tags -%}
          {%- assign article_tags = article_tags | append: tag | downcase | replace: ' ', '-' | append: ' ' -%}
        {%- endfor -%}
        <a href="{{ article.url }}" class="abl-card {% if forloop.first %}featured{% endif %}" data-tags="{{ article_tags | strip }}">

          {%- if forloop.first -%}
            <div class="abl-card-img-wrap">
              {%- if article.image != blank -%}
                <img class="abl-card-img" src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title }}" loading="eager">
              {%- else -%}
                &#128336;
              {%- endif -%}
            </div>
            <div class="abl-card-inner">
              <div>
                <div class="abl-card-tag">{{ article.tags | first | default: 'Astrology' }}</div>
                <div class="abl-card-title-wrap"><span class="abl-card-title">{{ article.title }}</span></div>
                <div class="abl-card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</div>
              </div>
              <div class="abl-card-footer">
                <div class="abl-card-meta">
                  {{ article.published_at | date: '%d %b %Y' }}
                  <span class="abl-card-meta-dot"></span>
                  {{ article.author }}
                </div>
                <span class="abl-read-more">Read More &#8594;</span>
              </div>
            </div>

          {%- else -%}
            <div class="abl-card-img-wrap">
              {%- if article.image != blank -%}
                <img class="abl-card-img" src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | default: article.title }}" loading="lazy">
              {%- else -%}
                &#128336;
              {%- endif -%}
            </div>
            <div class="abl-card-tag">{{ article.tags | first | default: 'Astrology' }}</div>
            <div class="abl-card-title-wrap"><span class="abl-card-title">{{ article.title }}</span></div>
            <div class="abl-card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</div>
            <div class="abl-card-footer">
              <div class="abl-card-meta">
                {{ article.published_at | date: '%d %b %Y' }}
                <span class="abl-card-meta-dot"></span>
                {{ article.author }}
              </div>
              <span class="abl-read-more">Read More &#8594;</span>
            </div>

          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

    <div id="abl-no-results" style="display:none;" class="abl-empty">
      <div class="abl-empty-icon">&#128336;</div>
      <div class="abl-empty-title">No articles found</div>
      <div class="abl-empty-sub">Try selecting a different category.</div>
    </div>

  {%- else -%}
    <div class="abl-empty">
