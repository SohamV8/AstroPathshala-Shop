{% comment %}
  Astro PathShala — Lal Kitaab Remedies Collection Section
  File: sections/astro-collection-lalkitaab.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.alk{font-family:var(--font-body);color:var(--black);background:transparent;}
.alk *{box-sizing:border-box;}
.alk-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;min-height:80px;position:sticky;top:0;z-index:100;position:relative;}
.alk-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.alk-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.alk-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.alk-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.alk-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.alk-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.alk-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.alk-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.alk-nav-icon:hover{color:var(--black);}
.alk-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.alk-cart-btn:hover{background:var(--gold);}
.alk-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.alk-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.alk-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.alk-mob.open{display:block;}
.alk-mob ul{list-style:none;}
.alk-mob ul li{border-bottom:1px solid var(--border);}
.alk-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}
.alk-crumb{padding:14px 48px;background:var(--cream);border-bottom:1px solid var(--border);font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px;}
.alk-crumb a{color:var(--muted);text-decoration:none;}
.alk-crumb a:hover{color:var(--gold);}
.alk-crumb-sep{color:var(--border);}
.alk-crumb-cur{color:var(--gold);font-weight:500;}
.alk-strip{background:var(--dark);padding:14px 48px;display:flex;align-items:center;justify-content:center;gap:40px;flex-wrap:wrap;}
.alk-strip-item{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--gold-pale);letter-spacing:0.8px;font-weight:400;}
.alk-strip-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0;}
.alk-toolbar{display:flex;align-items:center;justify-content:space-between;padding:14px 48px;background:transparent;border-bottom:1px solid var(--border);}
.alk-count{font-size:13px;color:var(--muted);font-weight:300;}
.alk-count strong{color:var(--black);font-weight:500;}
.alk-sort-wrap{display:flex;align-items:center;gap:10px;}
.alk-sort-label{font-size:12px;color:var(--muted);}
.alk-sort{padding:8px 14px;border:1px solid var(--border);background:transparent;font-size:12px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;cursor:pointer;}
.alk-sort:focus{border-color:var(--gold);}
.alk-grid-wrap{padding:36px 48px;}
.alk-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;}
.alk-card{text-decoration:none;display:block;}
.alk-card:hover .alk-card-img{border-color:var(--gold);}
.alk-card:hover .alk-card-name{color:var(--gold);}
.alk-card-img{height:240px;background:var(--cream);border:1px solid var(--border);border-radius:4px;position:relative;overflow:hidden;transition:border-color 0.2s;display:flex;align-items:center;justify-content:center;font-size:52px;}
.alk-card-img img{width:100%;height:100%;object-fit:cover;display:block;}
.alk-badge{position:absolute;top:10px;left:10px;background:var(--gold);color:var(--ivory);font-size:9px;padding:3px 9px;border-radius:2px;letter-spacing:0.8px;text-transform:uppercase;font-weight:500;}
.alk-badge.sale{background:var(--saffron);}
.alk-badge.new{background:var(--black);}
.alk-remedy-tag{position:absolute;bottom:10px;left:0;right:0;text-align:center;}
.alk-remedy-tag span{background:rgba(253,248,232,0.95);border:1px solid var(--border);border-radius:2px;padding:4px 10px;font-size:9px;color:var(--muted);font-weight:500;letter-spacing:0.5px;text-transform:uppercase;}
.alk-card-body{padding:14px 2px 0;}
.alk-card-type{font-size:9px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:5px;}
.alk-card-name{font-family:var(--font-heading);font-size:18px;color:var(--black);font-weight:500;line-height:1.25;margin-bottom:4px;transition:color 0.2s;}
.alk-card-sub{font-size:11px;color:var(--muted);font-weight:300;margin-bottom:12px;}
.alk-card-footer{display:flex;align-items:center;justify-content:space-between;}
.alk-price{font-family:var(--font-heading);font-size:19px;color:var(--saffron);font-weight:500;}
.alk-compare{font-size:12px;color:#B0A060;text-decoration:line-through;margin-left:6px;}
.alk-view-btn{font-size:10px;color:var(--muted);font-weight:500;letter-spacing:0.8px;text-transform:uppercase;border-bottom:1px solid var(--border);padding-bottom:1px;transition:color 0.2s,border-color 0.2s;}
.alk-card:hover .alk-view-btn{color:var(--gold);border-color:var(--gold);}
.alk-empty{text-align:center;padding:80px 40px;}
.alk-empty-icon{font-size:52px;margin-bottom:18px;}
.alk-empty-title{font-family:var(--font-heading);font-size:26px;color:var(--black);margin-bottom:8px;}
.alk-empty-desc{font-size:13px;color:var(--muted);font-weight:300;}
.alk-pagination{display:flex;justify-content:center;gap:8px;padding:40px 48px;}
.alk-page-link{padding:9px 16px;border:1px solid var(--border);color:var(--muted);text-decoration:none;font-size:12px;border-radius:2px;transition:all 0.2s;}
.alk-page-link:hover{border-color:var(--gold);color:var(--gold);}
.alk-page-current{padding:9px 16px;border:1px solid var(--gold);background:var(--gold);color:var(--ivory);font-size:12px;border-radius:2px;}
.alk-footer{background:transparent;}
.alk-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.alk-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.alk-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;}
.alk-footer-main{padding:56px 48px 40px;}
.alk-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.alk-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.alk-footer-social{display:flex;gap:10px;margin-top:20px;}
.alk-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.alk-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.alk-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.alk-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.alk-footer-col ul{list-style:none;}
.alk-footer-col ul li{margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.alk-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.6;}
.alk-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.alk-footer-col ul li a:hover{color:var(--gold);}
.alk-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.alk-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.alk-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.alk-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.alk-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.alk-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.alk-footer-legal{display:flex;gap:20px;}
.alk-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.alk-footer-legal a:hover{color:var(--gold);}
@media(max-width:1024px){
  .alk-crumb,.alk-strip,.alk-toolbar,.alk-grid-wrap,.alk-pagination,.alk-footer-main,.alk-footer-topbar,.alk-footer-bottom{padding-left:28px;padding-right:28px;}
  .alk-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;}
}
@media(max-width:768px){
  .alk-nav{padding:0 20px;min-height:68px;}
  .alk-nav-links{display:none;}
  .alk-burger{display:flex;}
  .alk-logo img{height:54px;}
  .alk-mob{top:68px;}
  .alk-crumb,.alk-strip,.alk-toolbar,.alk-grid-wrap,.alk-pagination,.alk-footer-main,.alk-footer-topbar,.alk-footer-bottom{padding-left:20px;padding-right:20px;}
  .alk-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;}
  .alk-strip{gap:14px;}
  .alk-toolbar{flex-wrap:wrap;gap:10px;}
  .alk-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .alk-footer-topbar{flex-direction:column;text-align:center;}
  .alk-footer-bottom{flex-direction:column;text-align:center;}
}
@media(max-width:480px){
  .alk-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;}
  .alk-card-img{height:200px;}
  .alk-footer-grid{grid-template-columns:1fr;}
}
</style>

<div class="alk">

{%- comment -%} BREADCRUMB {%- endcomment -%}
<div class="alk-crumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span class="alk-crumb-sep">›</span>
  <span class="alk-crumb-cur">{{ collection.title | default: 'Lal Kitaab Remedies' }}</span>
</div>

{%- comment -%} STRIP {%- endcomment -%}
<div class="alk-strip">
  <div class="alk-strip-item"><span class="alk-strip-dot"></span>Simple &amp; Effective Remedies</div>
  <div class="alk-strip-item"><span class="alk-strip-dot"></span>Based on Ancient Lal Kitaab</div>
  <div class="alk-strip-item"><span class="alk-strip-dot"></span>No Elaborate Rituals Needed</div>
  <div class="alk-strip-item"><span class="alk-strip-dot"></span>Verified by Expert Astrologers</div>
</div>

{%- comment -%} TOOLBAR {%- endcomment -%}
<div class="alk-toolbar">
  <div class="alk-count"><strong>{{ collection.products_count }}</strong> remedies available</div>
  <div class="alk-sort-wrap">
    <span class="alk-sort-label">Sort by</span>
    <select class="alk-sort" onchange="alkSort(this.value)">
      <option value="manual">Featured</option>
      <option value="price-asc">Price: Low to High</option>
      <option value="price-desc">Price: High to Low</option>
      <option value="title-asc">Name: A–Z</option>
      <option value="created-desc">Newest First</option>
    </select>
  </div>
</div>

{%- comment -%} PRODUCT GRID {%- endcomment -%}
<div class="alk-grid-wrap">
  {%- if collection.products.size > 0 -%}
    <div class="alk-grid" id="alk-grid">
      {%- for product in collection.products -%}
        <a href="{{ product.url }}" class="alk-card" data-price="{{ product.price }}" data-title="{{ product.title | downcase }}">
          <div class="alk-card-img">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}
            {%- else -%}
              &#128212;
            {%- endif -%}
            {%- if product.tags contains 'bestseller' or product.tags contains 'Bestseller' -%}
              <div class="alk-badge">Popular</div>
            {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
              <div class="alk-badge new">New</div>
            {%- elsif product.compare_at_price > product.price -%}
              <div class="alk-badge sale">Sale</div>
            {%- endif -%}
            <div class="alk-remedy-tag"><span>&#128212; Lal Kitaab</span></div>
          </div>
          <div class="alk-card-body">
            <div class="alk-card-type">{{ product.product_type | default: 'Remedy' }}</div>
            <div class="alk-card-name">{{ product.title }}</div>
            <div class="alk-card-sub">
              {%- assign planet_tag = '' -%}
              {%- for tag in product.tags -%}
                {%- assign tl = tag | downcase -%}
                {%- if tl == 'saturn' or tl == 'mars' or tl == 'sun' or tl == 'moon' or tl == 'mercury' or tl == 'jupiter' or tl == 'venus' or tl == 'rahu' or tl == 'ketu' -%}
                  {%- assign planet_tag = tag -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if planet_tag != '' -%}{{ planet_tag }} &nbsp;&middot;&nbsp; {%- endif -%}
              {%- if product.variants.size > 1 -%}{{ product.variants.size }} options{%- else -%}{{ product.variants.first.title }}{%- endif -%}
            </div>
            <div class="alk-card-footer">
              <div>
                <span class="alk-price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="alk-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <span class="alk-view-btn">View</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="alk-empty">
      <div class="alk-empty-icon">&#128212;</div>
      <div class="alk-empty-title">Coming Soon</div>
      <div class="alk-empty-desc">We are adding our Lal Kitaab remedies. Please check back soon.</div>
    </div>
  {%- endif -%}
  {%- paginate collection.products by 20 -%}
    {%- if paginate.pages > 1 -%}
      <div class="alk-pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="alk-page-link">&#8592; Prev</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}" class="alk-page-link">{{ part.title }}</a>
          {%- else -%}<span class="alk-page-current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="alk-page-link">Next &#8594;</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

</div>

<script>
function alkSort(val){
  var g=document.getElementById('alk-grid');
  if(!g)return;
  var cards=Array.from(g.querySelectorAll('.alk-card'));
  cards.sort(function(a,b){
    if(val==='price-asc')return parseFloat(a.dataset.price)-parseFloat(b.dataset.price);
    if(val==='price-desc')return parseFloat(b.dataset.price)-parseFloat(a.dataset.price);
    if(val==='title-asc')return a.dataset.title.localeCompare(b.dataset.title);
    return 0;
  });
  cards.forEach(function(c){g.appendChild(c);});
}
</script>

