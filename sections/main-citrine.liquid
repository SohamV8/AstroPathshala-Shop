{% comment %}
  Astro PathShala — Gemstone Product Page
  File: sections/main-citrine.liquid
  Fixes: variant selector, spacing, duplicate badges, enhanced UI
{% endcomment %}

{% comment %}theme-check-disable RemoteAsset{% endcomment %}
{% comment %}theme-check-enable RemoteAsset{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}

/* ── BREADCRUMB ── */
.apg-crumb{
  font-family:var(--font-body);font-size:12px;color:var(--muted);
  padding:14px 48px;background:var(--cream);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
}
.apg-crumb a{color:var(--muted);text-decoration:none;transition:color .2s;}
.apg-crumb a:hover{color:var(--gold);}
.apg-crumb-sep{color:var(--border);}
.apg-crumb-cur{color:var(--gold);font-weight:500;}

/* ── MAIN WRAPPER ── */
.apg-product{
  font-family:var(--font-body);background:transparent;
  max-width:{{ section.settings.max_width | default: '1320' }}px;
  margin:0 auto;padding:48px 48px 80px;
}

/* ── TWO COLUMN LAYOUT ── */
.apg-layout{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;}

/* ── GALLERY ── */
.apg-gallery{position:sticky;top:20px;}
.apg-gallery-main{
  width:100%;aspect-ratio:1/1;border-radius:6px;overflow:hidden;
  border:1px solid var(--border);background:var(--cream);
  position:relative;cursor:zoom-in;margin-bottom:14px;
}
.apg-gallery-main img{
  width:100%;height:100%;object-fit:cover;display:block;
  transition:transform .5s ease;
}
.apg-gallery-main:hover img{transform:scale(1.05);}
.apg-gallery-placeholder{
  width:100%;height:100%;display:flex;align-items:center;
  justify-content:center;font-size:100px;min-height:400px;
}
/* Certified ribbon on image */
.apg-gallery-ribbon{
  position:absolute;top:16px;right:16px;
  background:rgba(253,248,232,0.96);border:1px solid var(--border);
  border-radius:3px;padding:5px 12px;
  font-size:10px;font-weight:500;color:var(--muted);
  letter-spacing:.5px;text-transform:uppercase;
  display:flex;align-items:center;gap:5px;
}
.apg-gallery-ribbon::before{content:'✓';color:var(--gold);font-size:12px;}

.apg-thumbs{display:flex;gap:10px;flex-wrap:wrap;}
.apg-thumb{
  width:76px;height:76px;border-radius:4px;overflow:hidden;
  border:2px solid transparent;cursor:pointer;transition:border-color .2s;
  flex-shrink:0;background:var(--cream);
}
.apg-thumb.active,.apg-thumb:hover{border-color:var(--gold);}
.apg-thumb img{width:100%;height:100%;object-fit:cover;display:block;}

/* ── INFO PANEL ── */
.apg-info{display:flex;flex-direction:column;gap:0;}

/* Type label */
.apg-type-label{
  font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;
  color:var(--gold);margin-bottom:10px;display:flex;align-items:center;gap:10px;
}
.apg-type-label::before{content:'';width:20px;height:1px;background:var(--gold);}

/* Title */
.apg-title{
  font-family:var(--font-heading);
  font-size:{{ section.settings.title_size | default: '42' }}px;
  font-weight:500;color:var(--black);line-height:1.1;margin-bottom:10px;
}

/* Rating row */
.apg-rating{display:flex;align-items:center;gap:10px;margin-bottom:16px;}
.apg-stars{color:var(--gold);font-size:13px;letter-spacing:2px;}
.apg-rating-txt{font-size:12px;color:var(--muted);font-weight:300;}
.apg-rating-sep{width:3px;height:3px;border-radius:50%;background:var(--border);}

/* Price */
.apg-price-row{display:flex;align-items:baseline;gap:12px;margin-bottom:6px;}
.apg-price{font-family:var(--font-heading);font-size:38px;color:var(--saffron);font-weight:500;}
.apg-compare{font-size:20px;color:#B0A060;text-decoration:line-through;font-weight:300;}
.apg-save-pill{
  font-size:11px;font-weight:500;background:var(--gold-pale);
  color:var(--dark);padding:4px 10px;border-radius:2px;letter-spacing:.3px;
}

/* Stock */
.apg-stock-row{display:flex;align-items:center;gap:12px;margin-bottom:20px;}
.apg-stock-badge{
  display:flex;align-items:center;gap:6px;
  font-size:11px;font-weight:500;letter-spacing:.8px;text-transform:uppercase;
}
.apg-stock-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.apg-stock-badge.in .apg-stock-dot{background:#4CAF50;}
.apg-stock-badge.low .apg-stock-dot{background:var(--saffron);}
.apg-stock-badge.out .apg-stock-dot{background:#aaa;}
.apg-delivery-info{font-size:12px;color:var(--muted);font-weight:300;}

/* Short desc */
.apg-short-desc{
  font-size:14px;color:var(--muted);line-height:1.85;font-weight:300;
  padding-bottom:20px;border-bottom:1px solid var(--border);margin-bottom:20px;
}

/* Planet tags */
.apg-tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;}
.apg-tag{
  padding:5px 14px;border:1px solid var(--border);border-radius:20px;
  font-size:11px;color:var(--muted);font-weight:400;
}
.apg-tag.planet{border-color:var(--gold-pale);background:var(--gold-pale);color:var(--dark);font-weight:500;}

/* ── VARIANT SELECTOR ── */
.apg-option{margin-bottom:18px;}
.apg-option-label{
  font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;
  color:var(--muted);margin-bottom:10px;display:block;
}
.apg-option-label span{color:var(--black);font-weight:600;margin-left:4px;}
.apg-pills{display:flex;gap:8px;flex-wrap:wrap;}
.apg-pill{
  padding:9px 18px;border:1px solid var(--border);border-radius:2px;
  font-size:13px;color:var(--muted);cursor:pointer;
  transition:all .2s;font-family:var(--font-body);background:transparent;
}
.apg-pill:hover:not(.disabled){border-color:var(--gold);color:var(--gold);}
.apg-pill.active{border-color:var(--gold);background:var(--gold);color:var(--ivory);}
.apg-pill.disabled{opacity:.35;cursor:not-allowed;text-decoration:line-through;}

/* ── QUANTITY ── */
.apg-qty-wrap{display:flex;align-items:center;gap:20px;margin-bottom:24px;}
.apg-qty-label{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);}
.apg-qty{display:flex;align-items:center;border:1px solid var(--border);border-radius:2px;overflow:hidden;}
.apg-qty-btn{
  width:42px;height:44px;background:var(--cream);border:none;font-size:20px;
  cursor:pointer;color:var(--muted);transition:background .2s;font-family:var(--font-body);
}
.apg-qty-btn:hover{background:var(--gold-pale);}
.apg-qty-num{
  width:52px;height:44px;text-align:center;border:none;
  border-left:1px solid var(--border);border-right:1px solid var(--border);
  font-size:15px;font-family:var(--font-body);color:var(--black);
  background:transparent;outline:none;
}

/* ── CTA BUTTONS ── */
.apg-cta{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;}
.apg-add-btn{
  padding:15px 20px;background:var(--black);color:var(--ivory);
  border:none;font-size:11px;font-weight:500;letter-spacing:1.5px;
  text-transform:uppercase;cursor:pointer;border-radius:2px;
  font-family:var(--font-body);transition:background .2s;
  display:flex;align-items:center;justify-content:center;gap:8px;
}
.apg-add-btn:hover:not(:disabled){background:var(--gold);}
.apg-add-btn:disabled{background:#ccc;cursor:not-allowed;}
.apg-buy-btn{
  padding:15px 20px;background:transparent;color:var(--black);
  border:1.5px solid var(--black);font-size:11px;font-weight:500;
  letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;
  border-radius:2px;font-family:var(--font-body);transition:all .2s;
}
.apg-buy-btn:hover:not(:disabled){background:var(--black);color:var(--ivory);}
.apg-buy-btn:disabled{opacity:.5;cursor:not-allowed;}

/* ── TRUST BADGES (single row only) ── */
.apg-trust{
  display:grid;grid-template-columns:repeat(2,1fr);gap:10px;
  margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--border);
}
.apg-trust-item{
  display:flex;align-items:center;gap:10px;padding:10px 12px;
  background:var(--cream);border:1px solid var(--border);border-radius:3px;
}
.apg-trust-icon{font-size:16px;flex-shrink:0;}
.apg-trust-text{font-size:11px;color:var(--muted);line-height:1.4;font-weight:400;}

/* Shipping info row */
.apg-ship-row{
  display:flex;align-items:center;gap:16px;margin-bottom:20px;
  font-size:12px;color:var(--muted);font-weight:300;
}
.apg-ship-sep{width:3px;height:3px;border-radius:50%;background:var(--border);}

/* ── ACCORDION SECTIONS ── */
.apg-accordions{border-top:1px solid var(--border);}
.apg-acc{border-bottom:1px solid var(--border);}
.apg-acc-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 0;cursor:pointer;user-select:none;
}
.apg-acc-title{font-size:13px;font-weight:500;color:var(--black);display:flex;align-items:center;gap:10px;}
.apg-acc-title-icon{font-size:14px;}
.apg-acc-arrow{font-size:18px;color:var(--gold);transition:transform .25s;flex-shrink:0;}
.apg-acc.open .apg-acc-arrow{transform:rotate(45deg);}
.apg-acc-body{display:none;padding:0 0 18px;}
.apg-acc.open .apg-acc-body{display:block;}
.apg-acc-body p{font-size:13px;color:var(--muted);line-height:1.85;font-weight:300;margin-bottom:8px;}
.apg-acc-body ul{list-style:none;padding:0;}
.apg-acc-body ul li{font-size:13px;color:var(--muted);font-weight:300;line-height:1.7;padding:3px 0;display:flex;gap:10px;}
.apg-acc-body ul li::before{content:'✦';color:var(--gold);font-size:8px;flex-shrink:0;margin-top:5px;}

/* ── SPIRITUAL SECTION ── */
.apg-spirit{
  background:var(--dark);padding:64px 48px;
  border-top:1px solid rgba(184,134,11,.2);
}
.apg-spirit-inner{max-width:1320px;margin:0 auto;}
.apg-spirit-hdr{text-align:center;margin-bottom:48px;}
.apg-spirit-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block;}
.apg-spirit-title{font-family:var(--font-heading);font-size:40px;color:var(--gold-pale);font-weight:500;}
.apg-spirit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.apg-spirit-card{
  background:rgba(255,253,245,.05);border:1px solid rgba(184,134,11,.2);
  border-radius:4px;padding:28px 24px;transition:border-color .2s;
}
.apg-spirit-card:hover{border-color:var(--gold);}
.apg-spirit-card-icon{font-size:30px;margin-bottom:14px;}
.apg-spirit-card-title{font-family:var(--font-heading);font-size:20px;color:var(--gold-pale);margin-bottom:10px;font-weight:500;}
.apg-spirit-card-text{font-size:13px;color:var(--gold-lt);line-height:1.8;font-weight:300;}

/* ── RITUAL ── */
.apg-ritual{padding:64px 48px;background:var(--cream);border-top:1px solid var(--border);}
.apg-ritual-inner{max-width:1320px;margin:0 auto;}
.apg-ritual-hdr{text-align:center;margin-bottom:48px;}
.apg-sec-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.apg-sec-title{font-family:var(--font-heading);font-size:38px;font-weight:500;color:var(--black);}
.apg-sec-sub{font-size:13px;color:var(--muted);font-weight:300;margin-top:8px;line-height:1.7;}
.apg-ritual-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.apg-ritual-step{text-align:center;padding:28px 20px;background:transparent;border:1px solid var(--border);border-radius:4px;}
.apg-ritual-num{width:44px;height:44px;border-radius:50%;background:var(--gold);color:var(--ivory);font-family:var(--font-heading);font-size:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
.apg-ritual-step-title{font-family:var(--font-heading);font-size:17px;color:var(--black);margin-bottom:8px;font-weight:500;}
.apg-ritual-step-text{font-size:12px;color:var(--muted);line-height:1.7;font-weight:300;}

/* ── REVIEWS ── */
.apg-reviews{padding:64px 48px;border-top:1px solid var(--border);}
.apg-reviews-inner{max-width:1320px;margin:0 auto;}
.apg-reviews-hdr{text-align:center;margin-bottom:48px;}
.apg-reviews-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
.apg-review-card{background:var(--cream);border:1px solid var(--border);border-radius:4px;padding:28px;transition:border-color .2s;}
.apg-review-card:hover{border-color:var(--gold);}
.apg-review-stars{color:var(--gold);font-size:12px;letter-spacing:2px;margin-bottom:14px;}
.apg-review-text{font-size:14px;color:#4A3A10;line-height:1.8;font-family:var(--font-heading);font-style:italic;margin-bottom:16px;}
.apg-review-author{font-size:11px;font-weight:500;color:var(--black);letter-spacing:.8px;text-transform:uppercase;}
.apg-review-location{font-size:11px;color:var(--muted);font-weight:300;margin-top:2px;}

/* ── FAQ ── */
.apg-faq{padding:64px 48px;background:var(--cream);border-top:1px solid var(--border);}
.apg-faq-inner{max-width:820px;margin:0 auto;}
.apg-faq-hdr{text-align:center;margin-bottom:48px;}
.apg-faq-item{border-bottom:1px solid var(--border);}
.apg-faq-q{display:flex;justify-content:space-between;align-items:center;padding:18px 0;cursor:pointer;user-select:none;}
.apg-faq-q-text{font-size:14px;font-weight:500;color:var(--black);}
.apg-faq-arrow{font-size:18px;color:var(--gold);transition:transform .2s;flex-shrink:0;}
.apg-faq-item.open .apg-faq-arrow{transform:rotate(45deg);}
.apg-faq-a{display:none;padding:0 0 18px;}
.apg-faq-item.open .apg-faq-a{display:block;}
.apg-faq-a p{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;}

/* ── CERT STRIP ── */
.apg-cert-strip{
  padding:44px 48px;background:var(--dark);
  display:flex;align-items:center;justify-content:center;
  gap:52px;flex-wrap:wrap;border-top:1px solid rgba(184,134,11,.2);
}
.apg-cert-item{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;}
.apg-cert-circle{
  width:56px;height:56px;border-radius:50%;
  border:1px solid rgba(184,134,11,.4);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;background:rgba(184,134,11,.08);
}
.apg-cert-text{font-size:11px;font-weight:500;color:var(--gold-lt);letter-spacing:.5px;}

/* ── RELATED ── */
.apg-related{padding:64px 48px;border-top:1px solid var(--border);}
.apg-related-inner{max-width:1320px;margin:0 auto;}
.apg-related-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:40px;}
.apg-rel-card{text-decoration:none;display:block;}
.apg-rel-card:hover .apg-rel-img{border-color:var(--gold);}
.apg-rel-card:hover .apg-rel-name{color:var(--gold);}
.apg-rel-img{height:200px;background:var(--cream);border:1px solid var(--border);border-radius:4px;overflow:hidden;transition:border-color .2s;display:flex;align-items:center;justify-content:center;font-size:52px;}
.apg-rel-img img{width:100%;height:100%;object-fit:cover;display:block;}
.apg-rel-body{padding:12px 0 0;}
.apg-rel-type{font-size:9px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:4px;}
.apg-rel-name{font-family:var(--font-heading);font-size:17px;color:var(--black);font-weight:500;margin-bottom:4px;transition:color .2s;}
.apg-rel-price{font-family:var(--font-heading);font-size:17px;color:var(--saffron);}

/* ── STICKY ATC (mobile) ── */
.apg-sticky{
  display:none;position:fixed;bottom:0;left:0;right:0;
  background:transparent;border-top:1px solid var(--border);
  padding:12px 20px;z-index:200;flex-direction:row;
  align-items:center;justify-content:space-between;gap:12px;
}
.apg-sticky-info-title{font-size:13px;font-weight:500;color:var(--black);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px;}
.apg-sticky-info-price{font-family:var(--font-heading);font-size:18px;color:var(--saffron);}
.apg-sticky-add{
  padding:12px 24px;background:var(--black);color:var(--ivory);
  border:none;font-size:11px;font-weight:500;letter-spacing:1.2px;
  text-transform:uppercase;cursor:pointer;border-radius:2px;
  font-family:var(--font-body);white-space:nowrap;transition:background .2s;
}
.apg-sticky-add:hover{background:var(--gold);}

/* ── NOTIFICATION TOAST ── */
.apg-toast{
  position:fixed;top:24px;right:24px;padding:12px 20px;
  border-radius:3px;font-family:var(--font-body);font-size:13px;
  z-index:9999;opacity:0;transform:translateX(30px);
  transition:all .3s ease;pointer-events:none;
}
.apg-toast.show{opacity:1;transform:translateX(0);}
.apg-toast.success{background:#2E7D32;color:#fff;}
.apg-toast.error{background:#C62828;color:#fff;}

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .apg-product{padding:36px 28px 64px;}
  .apg-layout{gap:40px;}
  .apg-spirit,.apg-ritual,.apg-reviews,.apg-faq,.apg-cert-strip,.apg-related{padding-left:28px;padding-right:28px;}
  .apg-spirit-grid{grid-template-columns:1fr 1fr;}
  .apg-ritual-steps{grid-template-columns:1fr 1fr;}
  .apg-related-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
}
@media(max-width:768px){
  .apg-crumb{padding:12px 20px;}
  .apg-product{padding:24px 20px 48px;}
  .apg-layout{grid-template-columns:1fr;gap:28px;}
  .apg-gallery{position:relative;top:0;}
  .apg-title{font-size:32px;}
  .apg-cta{grid-template-columns:1fr;}
  .apg-spirit,.apg-ritual,.apg-reviews,.apg-faq,.apg-cert-strip,.apg-related{padding-left:20px;padding-right:20px;}
  .apg-spirit-grid,.apg-related-grid{grid-template-columns:1fr;}
  .apg-ritual-steps{grid-template-columns:1fr 1fr;}
  .apg-reviews-grid{grid-template-columns:1fr;}
  .apg-sticky{display:flex;}
  .apg-trust{grid-template-columns:1fr 1fr;}
  .apg-cert-strip{gap:28px;}
}
@media(max-width:480px){
  .apg-ritual-steps{grid-template-columns:1fr;}
  .apg-trust{grid-template-columns:1fr;}
  .apg-related-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
}
</style>

{%- comment -%} BREADCRUMB {%- endcomment -%}
<div class="apg-crumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span class="apg-crumb-sep">›</span>
  {%- if product.collections.first != blank -%}
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    <span class="apg-crumb-sep">›</span>
  {%- endif -%}
  <span class="apg-crumb-cur">{{ product.title }}</span>
</div>

{%- comment -%} MAIN PRODUCT SECTION {%- endcomment -%}
<div class="apg-product">
  <div class="apg-layout">

    {%- comment -%} ── GALLERY ── {%- endcomment -%}
    <div class="apg-gallery">
      <div class="apg-gallery-main" id="apg-main-img-wrap">
        {%- if product.images.size > 0 -%}
          <img id="apg-main-img" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title }}" width="900" height="900" loading="eager" decoding="async">
        {%- else -%}
          <div class="apg-gallery-placeholder">&#128142;</div>
        {%- endif -%}
        <div class="apg-gallery-ribbon">Lab Certified</div>
      </div>
      {%- if product.images.size > 1 -%}
        <div class="apg-thumbs">
          {%- for img in product.images -%}
            <div class="apg-thumb {% if forloop.first %}active{% endif %}" data-src="{{ img | image_url: width: 900 }}" onclick="apgSetImg(this)">
              <img src="{{ img | image_url: width: 150 }}" alt="{{ img.alt | default: product.title }}" width="150" height="150" loading="lazy" decoding="async">
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── INFO ── {%- endcomment -%}
    <div class="apg-info">

      <div class="apg-type-label">{{ product.product_type | default: 'Gemstone' }}</div>
