{%- comment -%} TOAST {%- endcomment -%}
<div class="apg-toast" id="apg-toast"></div>

<script>
(function(){
  // ── Product data
  var productVariants = {{ product.variants | json }};
  var currentVariantId = {{ product.selected_or_first_available_variant.id }};
  var selectedOptions = [
    {%- for option in product.options_with_values -%}
      "{{ option.selected_value }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  // ── Gallery
  window.apgSetImg = function(thumb) {
    document.getElementById('apg-main-img').src = thumb.dataset.src;
    document.querySelectorAll('.apg-thumb').forEach(function(t){ t.classList.remove('active'); });
    thumb.classList.add('active');
  };

  // ── Variant selector
  window.apgSelectOption = function(pill) {
    var idx = parseInt(pill.dataset.optionIndex);
    var value = pill.dataset.value;

    // Update active pill in this option group
    var group = pill.closest('.apg-pills');
    group.querySelectorAll('.apg-pill').forEach(function(p){ p.classList.remove('active'); });
    pill.classList.add('active');

    // Update selected options array
    selectedOptions[idx] = value;

    // Update label display
    var label = document.getElementById('apg-opt-val-' + idx);
    if (label) label.textContent = value;

    // Find matching variant
    var matched = null;
    for (var i = 0; i < productVariants.length; i++) {
      var v = productVariants[i];
      var opts = [v.option1, v.option2, v.option3];
      var match = true;
      for (var j = 0; j < selectedOptions.length; j++) {
        if (selectedOptions[j] && opts[j] !== selectedOptions[j]) { match = false; break; }
      }
      if (match) { matched = v; break; }
    }

    if (matched) {
      currentVariantId = matched.id;
      document.getElementById('apg-variant-id').value = matched.id;

      // Update price display
      var priceEl = document.getElementById('apg-price');
      if (priceEl) priceEl.textContent = apgFormatMoney(matched.price);

      var stickyPrice = document.getElementById('apg-sticky-price');
      if (stickyPrice) stickyPrice.textContent = apgFormatMoney(matched.price);

      // Update availability
      var addBtn = document.getElementById('apg-add-btn');
      var buyBtn = document.getElementById('apg-buy-btn');
      var addText = document.getElementById('apg-add-text');
      if (matched.available) {
        if (addBtn) { addBtn.disabled = false; }
        if (buyBtn) { buyBtn.disabled = false; }
        if (addText) { addText.textContent = {{ section.settings.add_to_cart_text | default: 'Add to Cart' | json }}; }
      } else {
        if (addBtn) { addBtn.disabled = true; }
        if (buyBtn) { buyBtn.disabled = true; }
        if (addText) { addText.textContent = 'Out of Stock'; }
      }

      // Update URL without reload
      if (window.history && window.history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', matched.id);
        window.history.replaceState({}, '', url.toString());
      }
    }
  };

  // ── Quantity
  window.apgQty = function(delta) {
    var inp = document.getElementById('apg-qty');
    var field = document.getElementById('apg-qty-field');
    var val = parseInt(inp.value) + delta;
    if (val < 1) val = 1;
    if (val > 10) val = 10;
    inp.value = val;
    if (field) field.value = val;
  };

  // ── Add to cart
  window.apgAddToCart = function() {
    var qty = parseInt(document.getElementById('apg-qty').value) || 1;
    var addBtn = document.getElementById('apg-add-btn');
    var addText = document.getElementById('apg-add-text');
    if (addBtn) { addBtn.disabled = true; }
    if (addText) { addText.textContent = 'Adding…'; }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: currentVariantId, quantity: qty })
    })
    .then(function(r){
      return r.json().then(function(data){ return { ok: r.ok, data: data }; });
    })
    .then(function(res){
      if (!res.ok) {
        var errMsg = (res.data && (res.data.description || res.data.message)) ? (res.data.description || res.data.message) : {{ section.settings.error_message | default: 'Error adding to cart. Please try again.' | json }};
        apgToast(errMsg, 'error');
        if (addBtn) { addBtn.disabled = false; }
        if (addText) { addText.textContent = {{ section.settings.add_to_cart_text | default: 'Add to Cart' | json }}; }
        return;
      }
      apgToast({{ section.settings.success_message | default: 'Added to cart!' | json }}, 'success');
      apgUpdateCartCount();
      if (addBtn) { addBtn.disabled = false; }
      if (addText) { addText.textContent = {{ section.settings.add_to_cart_text | default: 'Add to Cart' | json }}; }
    })
    .catch(function(){
      apgToast({{ section.settings.error_message | default: 'Error adding to cart. Please try again.' | json }}, 'error');
      if (addBtn) { addBtn.disabled = false; }
      if (addText) { addText.textContent = {{ section.settings.add_to_cart_text | default: 'Add to Cart' | json }}; }
    });
  };

  // ── Buy now
  window.apgBuyNow = function() {
    var qty = parseInt(document.getElementById('apg-qty').value) || 1;
    var buyBtn = document.getElementById('apg-buy-btn');
    if (buyBtn) { buyBtn.disabled = true; buyBtn.textContent = 'Processing…'; }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: currentVariantId, quantity: qty })
    })
    .then(function(){ window.location.href = '/checkout'; })
    .catch(function(){
      apgToast('Error. Please try again.', 'error');
      if (buyBtn) { buyBtn.disabled = false; buyBtn.textContent = {{ section.settings.buy_now_text | default: 'Buy Now' | json }}; }
    });
  };

  // ── Cart count update
  function apgUpdateCartCount() {
    fetch('/cart.js')
      .then(function(r){ return r.json(); })
      .then(function(cart){
        document.querySelectorAll('[class*="cart-btn"],[class*="cart_btn"]').forEach(function(el){
          el.textContent = 'Cart (' + cart.item_count + ')';
        });
      });
  }

  // ── Toast
  function apgToast(msg, type) {
    var t = document.getElementById('apg-toast');
    if (!t) return;
    t.textContent = msg;
    t.className = 'apg-toast ' + type;
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 3000);
  }

  // ── Money formatter
  function apgFormatMoney(cents) {
    if (cents == null || isNaN(Number(cents))) return '';
    var amount = (Number(cents) / 100).toFixed(2);
    return '\u20B9' + parseFloat(amount).toLocaleString('en-IN', { minimumFractionDigits: 2 });
  }

  // ── Sticky ATC — show after scrolling past product
  window.addEventListener('scroll', function() {
    var sticky = document.getElementById('apg-sticky');
    if (!sticky) return;
    sticky.style.display = window.scrollY > 700 ? 'flex' : 'none';
  });

})();
</script>

