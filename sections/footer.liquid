{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_social_icons = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank
    assign has_social_icons = true
  endif
-%}

<footer class="footer premium-footer color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding" role="contentinfo">
  <div class="premium-footer__backdrop" aria-hidden="true"></div>
  <div class="premium-footer__inner page-width">
    <div class="premium-footer__top">
      <section class="premium-footer__brand{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <a class="premium-footer__brand-link" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {%- if settings.brand_image != blank -%}
            {%- assign brand_image_height = settings.brand_image_width | divided_by: settings.brand_image.aspect_ratio -%}
            {{
              settings.brand_image
              | image_url: width: 460
              | image_tag:
                loading: 'lazy',
                widths: '120, 180, 240, 320, 460',
                height: brand_image_height,
                width: settings.brand_image_width,
                class: 'premium-footer__logo'
            }}
          {%- else -%}
            <span class="premium-footer__brand-name">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <p class="premium-footer__brand-description">{{ section.settings.brand_description }}</p>
        <p class="premium-footer__brand-trust">{{ section.settings.brand_trust_line }}</p>
      </section>

      <nav class="premium-footer__links{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" aria-label="Footer quick links">
        <h2 class="premium-footer__heading">Quick Links</h2>
        <ul class="premium-footer__list list-unstyled" role="list">
          <li><a href="{{ section.settings.about_url }}">About</a></li>
          <li><a href="{{ section.settings.courses_url }}">Courses</a></li>
          <li><a href="{{ section.settings.consultations_url }}">Consultations</a></li>
          <li><a href="{{ section.settings.reports_url }}">Reports</a></li>
          <li><a href="{{ section.settings.blog_url }}">Blog</a></li>
          <li><a href="{{ section.settings.contact_url }}">Contact</a></li>
          <li><a href="{{ section.settings.privacy_url }}">Privacy Policy</a></li>
          <li><a href="{{ section.settings.terms_url }}">Terms</a></li>
        </ul>
      </nav>

      <nav class="premium-footer__services{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" aria-label="Astrology services">
        <h2 class="premium-footer__heading">Services</h2>
        <ul class="premium-footer__list list-unstyled" role="list">
          <li><a href="{{ section.settings.kundli_url }}">Kundli</a></li>
          <li><a href="{{ section.settings.numerology_url }}">Numerology</a></li>
          <li><a href="{{ section.settings.palmistry_url }}">Palmistry</a></li>
          <li><a href="{{ section.settings.vastu_url }}">Vastu</a></li>
          <li><a href="{{ section.settings.gemstones_url }}">Gemstones</a></li>
          <li><a href="{{ section.settings.matchmaking_url }}">Matchmaking</a></li>
          <li><a href="{{ section.settings.career_astrology_url }}">Career Astrology</a></li>
          <li><a href="{{ section.settings.horoscope_url }}">Horoscope</a></li>
        </ul>
      </nav>

      <section class="premium-footer__newsletter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" aria-label="Newsletter signup">
        <h2 class="premium-footer__heading">{{ section.settings.newsletter_heading }}</h2>
        <p class="premium-footer__newsletter-copy">{{ section.settings.newsletter_copy }}</p>
        {%- if section.settings.newsletter_enable -%}
          {%- form 'customer', id: 'PremiumFooterNewsletter', class: 'premium-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="premium-footer__newsletter-field">
              <label class="visually-hidden" for="PremiumNewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
              <input
                id="PremiumNewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="premium-footer__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PremiumFooter-error"
                {% elsif form.posted_successfully? %}
                  aria-describedby="PremiumFooter-success"
                {% endif %}
                placeholder="{{ 'newsletter.label' | t }}"
                required
              >
              <button type="submit" class="premium-footer__button" aria-label="{{ 'newsletter.button_label' | t }}">
                {{ 'newsletter.button_label' | t }}
              </button>
            </div>
            {%- if form.errors -%}
              <small class="premium-footer__message premium-footer__message--error" id="PremiumFooter-error">
                <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="premium-footer__message premium-footer__message--success" id="PremiumFooter-success" tabindex="-1">
                <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
                {{- 'newsletter.success' | t -}}
              </p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </section>
    </div>

    <div class="premium-footer__middle{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <section class="premium-footer__social" aria-label="Social media links">
        <h2 class="premium-footer__heading premium-footer__heading--small">Follow</h2>
        {%- if section.settings.show_social and has_social_icons -%}
          <ul class="premium-footer__social-list list-unstyled" role="list">
            {%- if settings.social_instagram_link != blank -%}
              <li>
                <a href="{{ settings.social_instagram_link }}" class="premium-footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
                  <span class="svg-wrapper">{{ 'icon-instagram.svg' | inline_asset_content }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <li>
                <a href="{{ settings.social_facebook_link }}" class="premium-footer__social-link" target="_blank" rel="noopener" aria-label="Facebook">
                  <span class="svg-wrapper">{{ 'icon-facebook.svg' | inline_asset_content }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li>
                <a href="{{ settings.social_youtube_link }}" class="premium-footer__social-link" target="_blank" rel="noopener" aria-label="YouTube">
                  <span class="svg-wrapper">{{ 'icon-youtube.svg' | inline_asset_content }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li>
                <a href="{{ settings.social_tiktok_link }}" class="premium-footer__social-link" target="_blank" rel="noopener" aria-label="TikTok">
                  <span class="svg-wrapper">{{ 'icon-tiktok.svg' | inline_asset_content }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <li>
                <a href="{{ settings.social_twitter_link }}" class="premium-footer__social-link" target="_blank" rel="noopener" aria-label="X">
                  <span class="svg-wrapper">{{ 'icon-twitter.svg' | inline_asset_content }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <li>
                <a href="{{ settings.social_pinterest_link }}" class="premium-footer__social-link" target="_blank" rel="noopener" aria-label="Pinterest">
                  <span class="svg-wrapper">{{ 'icon-pinterest.svg' | inline_asset_content }}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </section>

      <section class="premium-footer__contact" aria-label="Contact details">
        <h2 class="premium-footer__heading premium-footer__heading--small">Contact</h2>
        <ul class="premium-footer__contact-list list-unstyled" role="list">
          <li>
            <span class="svg-wrapper">{{ 'icon-chat-bubble.svg' | inline_asset_content }}</span>
            <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
          </li>
          <li>
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
            <a href="https://wa.me/{{ section.settings.whatsapp_number | replace: ' ', '' | replace: '+', '' }}" target="_blank" rel="noopener">
              {{ section.settings.whatsapp_number }}
            </a>
          </li>
          <li>
            <span class="svg-wrapper">{{ 'icon-map-pin.svg' | inline_asset_content }}</span>
            <span>{{ section.settings.location_text }}</span>
          </li>
          <li>
            <span class="svg-wrapper">{{ 'icon-stopwatch.svg' | inline_asset_content }}</span>
            <span>{{ section.settings.support_timing }}</span>
          </li>
        </ul>
      </section>
    </div>

    <div class="premium-footer__divider" aria-hidden="true"></div>

    <div class="premium-footer__bottom">
      <small class="premium-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}, {{ shop.name }}. Gurugram's trusted Vedic Astrology and Lal Kitab platform.
      </small>
      <nav class="premium-footer__legal" aria-label="Legal links">
        <a href="{{ section.settings.privacy_url }}">Privacy</a>
        <a href="{{ section.settings.terms_url }}">Terms</a>
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Premium Footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Brand content"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "A modern astrology and spiritual intelligence platform for clarity, confidence, and conscious growth."
    },
    {
      "type": "text",
      "id": "brand_trust_line",
      "label": "Trust line",
      "default": "Trusted guidance, modern experience, timeless wisdom."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Enable newsletter"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "Join Our Cosmic Journal",
      "label": "Newsletter heading"
    },
    {
      "type": "textarea",
      "id": "newsletter_copy",
      "label": "Newsletter description",
      "default": "Receive thoughtful insights, launch updates, and weekly astrological guidance."
    },
    {
      "type": "header",
      "content": "Quick links"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About URL"
    },
    {
      "type": "url",
      "id": "courses_url",
      "label": "Courses URL"
    },
    {
      "type": "url",
      "id": "consultations_url",
      "label": "Consultations URL"
    },
    {
      "type": "url",
      "id": "reports_url",
      "label": "Reports URL"
    },
    {
      "type": "url",
      "id": "blog_url",
      "label": "Blog URL"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact URL"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy URL"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms URL"
    },
    {
      "type": "header",
      "content": "Service links"
    },
    {
      "type": "url",
      "id": "kundli_url",
      "label": "Kundli URL"
    },
    {
      "type": "url",
      "id": "numerology_url",
      "label": "Numerology URL"
    },
    {
      "type": "url",
      "id": "palmistry_url",
      "label": "Palmistry URL"
    },
    {
      "type": "url",
      "id": "vastu_url",
      "label": "Vastu URL"
    },
    {
      "type": "url",
      "id": "gemstones_url",
      "label": "Gemstones URL"
    },
    {
      "type": "url",
      "id": "matchmaking_url",
      "label": "Matchmaking URL"
    },
    {
      "type": "url",
      "id": "career_astrology_url",
      "label": "Career astrology URL"
    },
    {
      "type": "url",
      "id": "horoscope_url",
      "label": "Horoscope URL"
    },
    {
      "type": "header",
      "content": "Contact details"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "support@example.com"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "default": "+91 90000 00000"
    },
    {
      "type": "text",
      "id": "location_text",
      "label": "Location",
      "default": "New Delhi, India"
    },
    {
      "type": "text",
      "id": "support_timing",
      "label": "Support timing",
      "default": "Mon - Sat, 10:00 AM to 7:00 PM IST"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show social icons"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 220,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
