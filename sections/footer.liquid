        </div>
      </div>
      <div class="aps-footer-col"><div class="aps-footer-divider"></div><h4>Shop</h4><ul><li><a href="{{ routes.collections_url | append: '/gemstone' }}">Gemstones</a></li><li><a href="{{ routes.collections_url | append: '/e-books' }}">E-Books</a></li><li><a href="{{ routes.collections_url | append: '/lal-kitaab-remedies' }}">Lal Kitaab</a></li><li><a href="{{ routes.all_products_collection_url }}">New Arrivals</a></li></ul></div>
      <div class="aps-footer-col"><div class="aps-footer-divider"></div><h4>Learn</h4><ul><li><a href="/blogs/news">Blog</a></li><li><a href="/pages/gem-guide">Gem Guide</a></li><li><a href="/pages/rashi-guide">Rashi Guide</a></li><li><a href="/pages/faq">FAQ</a></li><li><a href="/pages/about">About Us</a></li></ul></div>
      <div class="aps-footer-col"><div class="aps-footer-divider"></div><h4>Contact</h4><div class="aps-footer-contact"><p><span class="lbl">&#9990;</span>{{ section.settings.contact_phone | default: '+91 98765 43210' }}</p><p><span class="lbl">&#9993;</span>{{ section.settings.contact_email | default: 'support@astropathshala.com' }}</p><p><span class="lbl">&#9679;</span>{{ section.settings.contact_hours | default: 'Mon–Sat, 10am–7pm IST' }}</p></div><ul style="margin-top:16px;"><li><a href="/policies/shipping-policy">Shipping Policy</a></li><li><a href="/policies/refund-policy">Refund Policy</a></li></ul></div>
    </div>
  </div>
  <div class="aps-footer-bottom">
    <span class="aps-footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span class="aps-footer-india">Made with care in India &#127470;&#127475;</span>
    <div class="aps-footer-legal"><a href="/policies/privacy-policy">Privacy</a><a href="/policies/terms-of-service">Terms</a></div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
    { "type": "text", "id": "footer_desc", "label": "Footer description", "default": "Authentic gemstones, Lal Kitaab remedies and Vedic astrology e-books — handpicked for your journey." },
    { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "url", "id": "social_youtube", "label": "YouTube URL" },
    { "type": "url", "id": "social_facebook", "label": "Facebook URL" },
    { "type": "url", "id": "social_whatsapp", "label": "WhatsApp URL" },
    { "type": "text", "id": "contact_phone", "label": "Phone number", "default": "+91 98765 43210" },
    { "type": "text", "id": "contact_email", "label": "Email address", "default": "support@astropathshala.com" },
    { "type": "text", "id": "contact_hours", "label": "Business hours", "default": "Mon–Sat, 10am–7pm IST" }
  ]
}
{% endschema %}



