{{ 'blog-editorial.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- paginate blog.articles by section.settings.posts_per_page -%}
  <div class="editorial-blog page-width section-{{ section.id }}-padding">
    <header class="editorial-blog__header">
      <h1 id="BlogHeading-{{ section.id }}" class="editorial-blog__title">{{ blog.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="editorial-blog__dek">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="editorial-blog__toolbar" aria-label="Blog search and topics">
      <div class="editorial-blog__search">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="article">
          <label class="visually-hidden" for="BlogSearch-{{ section.id }}">
            {{- 'general.search.search' | t | default: 'Search' -}}
          </label>
          <input
            id="BlogSearch-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            autocomplete="off"
            spellcheck="false"
          >
          <button type="submit">{{ section.settings.search_button_label }}</button>
        </form>
      </div>

      {%- if blog.all_tags.size > 0 -%}
        <div class="editorial-blog__tags-wrap">
          <span class="editorial-blog__tags-label" id="topics-label-{{ section.id }}">
            {{- section.settings.tags_label | escape -}}
          </span>
          <div class="editorial-blog__tags" role="navigation" aria-labelledby="topics-label-{{ section.id }}">
            <a
              href="{{ blog.url }}"
              class="editorial-blog__tag{% if current_tags == blank %} is-active{% endif %}"
              {% if current_tags == blank %}
                aria-current="page"
              {% endif %}
            >
              {{ section.tags_all_label }}
            </a>
            {%- for tag in blog.all_tags -%}
              <a
                href="{{ blog.url }}/tagged/{{ tag | handle }}"
                class="editorial-blog__tag{% if current_tags contains tag %} is-active{% endif %}"
                {% if current_tags contains tag %}
                  aria-current="page"
                {% endif %}
              >
                {{ tag | escape }}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if paginate.current_page == 1 and section.settings.show_spotlight and blog.articles_count > 0 -%}
      {%- assign spotlight = blog.articles.first -%}
      {%- liquid
        assign spotlight_words = spotlight.content | strip_html | split: ' ' | size
        assign spotlight_read = spotlight_words | times: 1 | divided_by: 200
        if spotlight_read < 1
          assign spotlight_read = 1
        endif
      -%}
      <section class="editorial-blog__hero" aria-labelledby="SpotlightTitle-{{ section.id }}">
        <div class="editorial-blog__hero-grid">
          {%- if section.settings.show_image and spotlight.image -%}
            <div class="editorial-blog__hero-media">
              <a class="editorial-blog__hero-img-link" href="{{ spotlight.url }}" aria-hidden="true" tabindex="-1">
                <span class="visually-hidden">{{ spotlight.title | escape }}</span>
                <div class="editorial-blog__hero-img-wrap">
                  <img
                    class="editorial-blog__hero-img"
                    srcset="
                      {%- if spotlight.image.width >= 600 -%}{{ spotlight.image | image_url: width: 600 }} 600w,{%- endif -%}
                      {%- if spotlight.image.width >= 900 -%}{{ spotlight.image | image_url: width: 900 }} 900w,{%- endif -%}
                      {%- if spotlight.image.width >= 1200 -%}{{ spotlight.image | image_url: width: 1200 }} 1200w,{%- endif -%}
                      {%- if spotlight.image.width >= 1600 -%}{{ spotlight.image | image_url: width: 1600 }} 1600w,{%- endif -%}
                      {{ spotlight.image | image_url }} {{ spotlight.image.width }}w
                    "
                    src="{{ spotlight.image | image_url: width: 1200 }}"
                    sizes="(min-width: 900px) 52vw, 100vw"
                    alt="{{ spotlight.image.alt | default: spotlight.title | escape }}"
                    width="{{ spotlight.image.width }}"
                    height="{{ spotlight.image.height }}"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  >
                </div>
              </a>
            </div>
          {%- endif -%}
          <div class="editorial-blog__hero-body">
            <p class="editorial-blog__hero-eyebrow">{{ section.settings.spotlight_eyebrow | escape }}</p>
            <h2 id="SpotlightTitle-{{ section.id }}" class="editorial-blog__hero-title">
              <a href="{{ spotlight.url }}">{{ spotlight.title | escape }}</a>
            </h2>
            <div class="editorial-blog__hero-meta">
              <span>{{ spotlight.published_at | time_tag: format: 'date' }}</span>
              <span>{{ spotlight_read }} min read</span>
            </div>
            {%- if spotlight.excerpt != blank or spotlight.content != blank -%}
              <p class="editorial-blog__hero-excerpt">
                {%- if spotlight.excerpt != blank -%}
                  {{ spotlight.excerpt | strip_html | truncatewords: 38 }}
                {%- else -%}
                  {{ spotlight.content | strip_html | truncatewords: 38 }}
                {%- endif -%}
              </p>
            {%- endif -%}
            <a class="editorial-blog__hero-cta" href="{{ spotlight.url }}">
              {{ section.settings.spotlight_cta_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    {%- endif -%}

    <ul class="editorial-blog__grid" role="list">
      {%- for article in blog.articles -%}
        {%- if paginate.current_page == 1 and section.settings.show_spotlight and blog.articles_count > 1 and forloop.first -%}
          {%- continue -%}
        {%- endif -%}
        <li class="editorial-blog__grid-item">
          {%- render 'article-card',
            blog: blog,
            article: article,
            media_height: section.settings.image_height,
            media_aspect_ratio: article.image.aspect_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: true,
            show_reading_time: section.settings.show_reading_time,
            image_sizes: '(min-width: 1200px) min(400px, 30vw), (min-width: 750px) min(50vw, 480px), calc(100vw - 2.4rem)'
          -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <div class="editorial-blog__rail">
        {%- render 'pagination', paginate: paginate -%}
      </div>
    {%- endif -%}
  </div>
{%- endpaginate -%}

<script src="{{ 'blog-editorial.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "Subtitle",
      "default": "Vedic astrology, Lal Kitab, gemstones, rituals, courses, and guru-led guidance — editorial dispatches from Astro Pathshala."
    },
    {
      "type": "textarea",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search articles…"
    },
    {
      "type": "text",
      "id": "search_button_label",
      "label": "Search button",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "tags_label",
      "label": "Topics label",
      "default": "Topics"
    },
    {
      "type": "text",
      "id": "tags_all_label",
      "label": "All topics label",
      "default": "All"
    },
    {
      "type": "checkbox",
      "id": "show_spotlight",
      "default": true,
      "label": "Show spotlight hero"
    },
    {
      "type": "text",
      "id": "spotlight_eyebrow",
      "label": "Spotlight label",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "spotlight_cta_label",
      "label": "Spotlight link text",
      "default": "Read article"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 6,
      "max": 24,
      "step": 1,
      "default": 12,
      "label": "Posts per page"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-blog.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.main-blog.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-blog.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-blog.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.main-blog.settings.image_height.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "default": true,
      "label": "Show reading time on cards"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ]
}
{% endschema %}
