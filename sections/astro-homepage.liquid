{% comment %}
  Astro PathShala — Homepage Section
  File: sections/astro-homepage.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;
  --dark-bg:rgba(44,32,5,0.65);--card-bg:#3A2A08;
  --red-dark:#3D0A0A;--red-card:#4A1010;
  --footer-bg:#1C1508;
}
.aps{font-family:var(--font-body);color:var(--black);background:transparent;}
.aps *{box-sizing:border-box;}
.aps-wrap{padding:72px 48px;background:transparent;}
.aps-wrap-dark{padding:72px 48px;background:var(--dark-bg);}
.aps-wrap-red{padding:72px 48px;background:var(--cream);border-top:1px solid var(--border);}
.aps-wrap-card{padding:72px 48px;background:transparent;}
.aps-hdr{text-align:center;margin-bottom:52px;}
.aps-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;display:block;}
.aps-title{font-family:var(--font-heading);font-size:40px;font-weight:500;color:var(--black);}
.aps-title-lt{font-family:var(--font-heading);font-size:40px;font-weight:500;color:var(--gold-pale);}
.aps-sub{font-size:14px;color:var(--muted);margin-top:12px;font-weight:300;line-height:1.7;}
.aps-sub-lt{font-size:14px;color:var(--gold-lt);margin-top:12px;font-weight:300;line-height:1.7;}
.aps-btn-outline-dark{display:inline-block;padding:13px 34px;background:transparent;border:1.5px solid var(--gold);color:var(--gold-pale);font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;border-radius:2px;text-decoration:none;font-family:var(--font-body);}
.aps-btn-outline-light{display:inline-block;padding:13px 34px;background:transparent;border:1.5px solid var(--gold);color:var(--black);font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;border-radius:2px;text-decoration:none;font-family:var(--font-body);}

/* NAV */
.aps-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;position:sticky;top:0;z-index:100;min-height:80px;position:relative;}
.aps-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.aps-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.aps-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.aps-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.aps-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.aps-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.aps-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.aps-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.aps-nav-icon:hover{color:var(--black);}
.aps-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.aps-cart-btn:hover{background:var(--gold);}
.aps-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.aps-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.aps-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.aps-mob.open{display:block;}
.aps-mob ul{list-style:none;}
.aps-mob ul li{border-bottom:1px solid var(--border);}
.aps-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}

/* HERO */
.aps-hero{display:grid;grid-template-columns:1fr 1fr;min-height:560px;}
.aps-hero-left{padding:72px 56px 64px;display:flex;flex-direction:column;justify-content:center;background:transparent;}
.aps-hero-badge{font-size:11px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--gold);margin-bottom:18px;display:flex;align-items:center;gap:10px;}
.aps-hero-badge::before{content:'';width:32px;height:1px;background:var(--gold);}
.aps-hero-title{font-family:var(--font-heading);font-size:58px;line-height:1.06;color:var(--black);margin-bottom:22px;font-weight:500;}
.aps-hero-title em{color:var(--saffron);font-style:italic;}
.aps-hero-desc{font-size:15px;color:var(--muted);line-height:1.8;max-width:400px;margin-bottom:38px;font-weight:300;}
.aps-hero-ctas{display:flex;gap:14px;flex-wrap:wrap;}
.aps-btn-primary{background:var(--black);color:var(--ivory);padding:14px 30px;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;border:none;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.aps-btn-primary:hover{background:var(--gold);}
.aps-btn-outline{background:transparent;color:var(--black);padding:14px 30px;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;border:1.5px solid var(--black);cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:all 0.2s;}
.aps-btn-outline:hover{background:var(--black);color:var(--ivory);}
.aps-hero-right{background:var(--cream);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.aps-hero-img{width:100%;height:100%;object-fit:cover;display:block;}
.aps-hero-placeholder{display:flex;align-items:center;justify-content:center;width:100%;height:100%;min-height:440px;}
.aps-gem-vis{position:relative;width:280px;height:280px;}
.aps-gem-ring{position:absolute;border-radius:50%;border:1px solid rgba(184,134,11,0.25);}
.aps-gem-r1{width:280px;height:280px;top:0;left:0;}
.aps-gem-r2{width:200px;height:200px;top:40px;left:40px;background:rgba(184,134,11,0.05);}
.aps-gem-r3{width:110px;height:110px;top:85px;left:85px;background:rgba(184,134,11,0.08);}
.aps-gem-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:72px;line-height:1;}
.aps-hero-tag{position:absolute;background:transparent;border:1px solid var(--border);border-radius:3px;padding:8px 16px;font-size:12px;font-weight:500;color:var(--black);letter-spacing:0.3px;}
.aps-hero-tag.top{top:32px;left:24px;}

/* TRUST BAR */
.aps-trust{display:flex;justify-content:center;background:var(--dark-bg);border-top:1px solid #4A3510;border-bottom:1px solid #4A3510;flex-wrap:wrap;}
.aps-trust-item{display:flex;align-items:center;gap:10px;padding:18px 36px;font-size:12px;color:var(--gold-pale);letter-spacing:0.8px;text-transform:uppercase;font-weight:500;border-right:1px solid #4A3510;}
.aps-trust-item:last-child{border-right:none;}
.aps-trust-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);flex-shrink:0;}

/* CATEGORIES */
.aps-cats{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
.aps-cat-card{cursor:pointer;text-decoration:none;display:block;}
.aps-cat-img{height:260px;display:flex;align-items:center;justify-content:center;font-size:64px;position:relative;overflow:hidden;border-radius:4px;}
.aps-cat-img.gems{background:var(--black);}
.aps-cat-img.ebooks{background:#2A1F08;}
.aps-cat-img.lalkitaab{background:#8B1A1A;}
.aps-cat-overlay{position:absolute;inset:0;background:rgba(26,18,8,0);transition:background 0.3s;display:flex;align-items:center;justify-content:center;}
.aps-cat-card:hover .aps-cat-overlay{background:rgba(26,18,8,0.6);}
.aps-cat-overlay-text{color:var(--ivory);font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:500;border:1px solid rgba(245,230,200,0.7);padding:10px 24px;opacity:0;transition:opacity 0.3s;}
.aps-cat-card:hover .aps-cat-overlay-text{opacity:1;}
.aps-cat-info{padding:18px 0 4px;}
.aps-cat-name{font-family:var(--font-heading);font-size:22px;color:var(--black);font-weight:500;}
.aps-cat-count{font-size:12px;color:var(--muted);margin-top:4px;font-weight:300;}

/* PRODUCTS */
.aps-products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;}
.aps-prod-card{cursor:pointer;text-decoration:none;display:block;}
.aps-prod-img{height:230px;background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:52px;border:1px solid var(--border);border-radius:4px;transition:border-color 0.2s;position:relative;overflow:hidden;}
.aps-prod-card:hover .aps-prod-img{border-color:var(--gold);}
.aps-prod-img img,.aps-prod-img-dark img,.aps-prod-img-red img{width:100%;height:100%;object-fit:cover;display:block;}
.aps-prod-img-dark{height:230px;background:#4A3510;display:flex;align-items:center;justify-content:center;font-size:52px;border:1px solid #6A5020;border-radius:4px;transition:border-color 0.2s;position:relative;overflow:hidden;}
.aps-prod-card:hover .aps-prod-img-dark{border-color:var(--gold);}
.aps-prod-img-red{height:230px;background:var(--cream);display:flex;align-items:center;justify-content:center;font-size:52px;border:1px solid var(--border);border-radius:4px;transition:border-color 0.2s;position:relative;overflow:hidden;}
.aps-prod-card:hover .aps-prod-img-red{border-color:var(--gold);}
.aps-prod-badge{position:absolute;top:12px;left:12px;background:var(--gold);color:var(--ivory);font-size:10px;padding:4px 10px;border-radius:2px;letter-spacing:0.8px;text-transform:uppercase;font-weight:500;}
.aps-prod-badge.sale{background:var(--saffron);}
.aps-prod-info{padding:14px 0 0;}
.aps-prod-name{font-size:15px;font-weight:500;color:var(--black);margin-bottom:4px;}
.aps-prod-name-lt{font-size:15px;font-weight:500;color:var(--gold-pale);margin-bottom:4px;}
.aps-prod-sub{font-size:12px;color:var(--muted);font-weight:300;margin-bottom:10px;}
.aps-prod-sub-lt{font-size:12px;color:var(--gold-lt);font-weight:300;margin-bottom:10px;}
.aps-prod-price{font-family:var(--font-heading);font-size:20px;color:var(--saffron);font-weight:500;}
.aps-prod-compare{font-size:13px;color:#B0A060;text-decoration:line-through;margin-left:8px;font-weight:300;}

/* WHY CHOOSE US */
.aps-why-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;}
.aps-why-card{border:1px solid var(--border);border-radius:4px;padding:36px 24px;text-align:center;transition:border-color 0.25s,transform 0.2s;background:transparent;}
.aps-why-card:hover{border-color:var(--gold);transform:translateY(-4px);box-shadow:0 8px 32px rgba(184,134,11,0.12);}
.aps-why-icon{width:68px;height:68px;border-radius:50%;background:var(--cream);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 20px;}
.aps-why-num{font-family:var(--font-heading);font-size:38px;color:var(--gold);font-weight:400;line-height:1;margin-bottom:6px;}
.aps-why-title{font-family:var(--font-heading);font-size:19px;color:var(--black);font-weight:500;margin-bottom:10px;}
.aps-why-desc{font-size:13px;color:var(--muted);line-height:1.75;font-weight:300;}

/* ABOUT */
.aps-about{background:rgba(44,32,5,0.65);padding:72px 48px;display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;}
.aps-about-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:block;}
.aps-about-title{font-family:var(--font-heading);font-size:38px;color:var(--ivory);line-height:1.22;margin-bottom:20px;font-weight:500;}
.aps-about-desc{font-size:14px;color:var(--gold-lt);line-height:1.85;font-weight:300;}
.aps-about-btn{display:inline-block;margin-top:28px;padding:12px 30px;background:transparent;border:1px solid var(--gold-lt);color:var(--ivory);font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;font-family:var(--font-body);border-radius:2px;text-decoration:none;}
.aps-about-stats{display:grid;grid-template-columns:1fr 1fr;gap:32px;}
.aps-stat{border-left:2px solid var(--gold);padding-left:20px;}
.aps-stat-num{font-family:var(--font-heading);font-size:44px;color:var(--ivory);font-weight:400;line-height:1;}
.aps-stat-label{font-size:12px;color:var(--gold-lt);margin-top:8px;font-weight:300;line-height:1.5;}

/* TESTIMONIALS */
.aps-testi-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;}
.aps-testi-card{background:transparent;border:1px solid var(--border);border-radius:4px;padding:30px;transition:border-color 0.2s;}
.aps-testi-card:hover{border-color:var(--gold);}
.aps-testi-stars{color:var(--gold);font-size:13px;margin-bottom:16px;letter-spacing:2px;}
.aps-testi-text{font-size:15px;color:#4A3A10;line-height:1.8;font-family:var(--font-heading);font-style:italic;}
.aps-testi-author{margin-top:20px;font-size:11px;font-weight:500;color:var(--black);letter-spacing:0.8px;text-transform:uppercase;}

/* BLOG */
.aps-blog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;}
.aps-blog-card{text-decoration:none;display:block;}
.aps-blog-card:hover .aps-blog-img{border-color:var(--gold);}
.aps-blog-img{height:210px;background:var(--cream);border:1px solid var(--border);border-radius:4px;overflow:hidden;margin-bottom:18px;transition:border-color 0.2s;display:flex;align-items:center;justify-content:center;font-size:52px;}
.aps-blog-img img{width:100%;height:100%;object-fit:cover;display:block;}
.aps-blog-tag{font-size:10px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;display:block;}
.aps-blog-title{font-family:var(--font-heading);font-size:20px;color:var(--black);font-weight:500;line-height:1.35;margin-bottom:10px;transition:color 0.2s;}
.aps-blog-card:hover .aps-blog-title{color:var(--gold);}
.aps-blog-excerpt{font-size:13px;color:var(--muted);line-height:1.7;font-weight:300;margin-bottom:14px;}
.aps-blog-meta{font-size:11px;color:#B0A060;display:flex;align-items:center;gap:8px;}
.aps-blog-meta::before{content:'';display:block;width:20px;height:1px;background:var(--border);}

/* NEWSLETTER */
.aps-nl-title{font-family:var(--font-heading);font-size:36px;color:var(--black);margin-bottom:12px;}
.aps-nl-sub{font-size:14px;color:var(--muted);font-weight:300;margin-bottom:32px;}
.aps-nl-form{display:flex;justify-content:center;max-width:460px;margin:0 auto;}
.aps-nl-input{flex:1;padding:14px 20px;border:1px solid var(--border);border-right:none;background:transparent;font-size:13px;font-family:var(--font-body);color:var(--black);outline:none;border-radius:2px 0 0 2px;}
.aps-nl-input:focus{border-color:var(--gold);}
.aps-nl-btn{background:var(--black);color:var(--ivory);padding:14px 26px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;border:none;cursor:pointer;font-family:var(--font-body);border-radius:0 2px 2px 0;transition:background 0.2s;}
.aps-nl-btn:hover{background:var(--gold);}

/* FOOTER */
.aps-footer{background:var(--cream);}
.aps-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;}
.aps-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.aps-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;white-space:nowrap;}
.aps-footer-main{padding:56px 48px 40px;}
.aps-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.aps-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.aps-footer-social{display:flex;gap:10px;margin-top:20px;}
.aps-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:14px;color:var(--muted);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.aps-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.aps-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.aps-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.aps-footer-col ul{list-style:none;}
.aps-footer-col ul li{margin-bottom:13px;display:flex;align-items:center;gap:8px;}
.aps-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.7;}
.aps-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.aps-footer-col ul li a:hover{color:var(--gold);}
.aps-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.aps-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.aps-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.aps-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.aps-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.aps-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.aps-footer-legal{display:flex;gap:20px;}
.aps-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.aps-footer-legal a:hover{color:var(--gold);}

/* RESPONSIVE */
@media(max-width:1024px){
  .aps-nav{padding:0 28px;}
  .aps-hero-left{padding:52px 36px;}
  .aps-hero-title{font-size:44px;}
  .aps-wrap,.aps-wrap-dark,.aps-wrap-red,.aps-wrap-card{padding:56px 28px;}
  .aps-products{grid-template-columns:repeat(2,minmax(0,1fr));}
  .aps-about{padding:56px 28px;gap:48px;}
  .aps-why-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
  .aps-footer-grid{grid-template-columns:1fr 1fr;gap:32px;}
  .aps-footer-main{padding:40px 28px;}
  .aps-footer-bottom{padding:18px 28px;}
  .aps-footer-topbar{padding:12px 28px;}
}
@media(max-width:768px){
  .aps-nav{padding:0 20px;min-height:68px;}
  .aps-nav-links{display:none;}
  .aps-burger{display:flex;}
  .aps-logo img{height:54px;}
  .aps-mob{top:68px;}
  .aps-hero{grid-template-columns:1fr;}
  .aps-hero-right{min-height:280px;}
  .aps-hero-left{padding:44px 24px;}
  .aps-hero-title{font-size:38px;}
  .aps-trust{flex-wrap:wrap;}
  .aps-trust-item{padding:14px 20px;border-right:none;border-bottom:1px solid #2A1F08;width:50%;}
  .aps-cats{grid-template-columns:1fr;}
  .aps-products{grid-template-columns:1fr 1fr;}
  .aps-about{grid-template-columns:1fr;gap:36px;}
  .aps-testi-grid{grid-template-columns:1fr;}
  .aps-blog-grid{grid-template-columns:1fr;}
  .aps-why-grid{grid-template-columns:1fr 1fr;}
  .aps-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .aps-footer-topbar{flex-direction:column;text-align:center;}
  .aps-footer-bottom{flex-direction:column;gap:10px;text-align:center;}
}
@media(max-width:480px){
  .aps-products{grid-template-columns:1fr;}
  .aps-why-grid{grid-template-columns:1fr;}
  .aps-footer-grid{grid-template-columns:1fr;}
  .aps-title,.aps-title-lt{font-size:30px;}
  .aps-hero-title{font-size:32px;}
  .aps-nl-form{flex-direction:column;}
  .aps-nl-input{border-right:1px solid var(--border);border-bottom:none;border-radius:2px 2px 0 0;}
  .aps-nl-btn{border-radius:0 0 2px 2px;}
  .aps-trust-item{width:100%;}
}
</style>

<div class="aps">

{%- comment -%} ── NAVIGATION ── {%- endcomment -%}
{%- comment -%} ── HERO ── {%- endcomment -%}
<section class="aps-hero">
  <div class="aps-hero-left">
    <div class="aps-hero-badge">{{ section.settings.hero_badge | default: 'Handpicked from the Earth' }}</div>
    <h1 class="aps-hero-title">{{ section.settings.hero_title_line1 | default: 'Where Stones' }}<br>Meet <em>{{ section.settings.hero_title_italic | default: 'Wisdom' }}</em></h1>
    <p class="aps-hero-desc">{{ section.settings.hero_desc | default: "Discover authentic gemstones, Lal Kitaab remedies and astrological e-books — curated for those who seek guidance from nature's gifts." }}</p>
    <div class="aps-hero-ctas">
