{% comment %}
  E-Book Product Page Template - sections/main-product.liquid
  Shopify 2.0 Compatible | Astro PathShala
  Book: Jyotish - The Science of Soul and Karmic Mathematics
{% endcomment %}

<div class="aps-product" data-product-json="{{ product | json | escape }}" data-section-id="{{ section.id }}">
  <div class="aps-product-container">
    <div class="aps-product-gallery">
      <div class="aps-product-gallery-main">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="aps-product-gallery-slide {% if forloop.first %}active{% endif %}" data-media-id="{{ media.id }}">
              {%- if media.media_type == 'image' -%}
                <img src="{{ media | image_url: width: 800, height: 800, crop: 'center' }}"
                     alt="{{ media.alt | default: product.title }}"
                     width="800" height="800"
                     loading="lazy">
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="aps-product-gallery-slide active">
            <div class="aps-product-placeholder">ज्योतिष: Soul's Blueprint</div>
          </div>
        {%- endif -%}
      </div>
      
      {%- if product.media.size > 1 -%}
        <div class="aps-product-thumbnails">
          {%- for media in product.media -%}
            <div class="aps-product-thumbnail {% if forloop.first %}active{% endif %}" data-media-id="{{ media.id }}">
              {%- if media.media_type == 'image' -%}
                <img src="{{ media | image_url: width: 100, height: 100, crop: 'center' }}"
                     alt="{{ media.alt | default: product.title }}"
                     width="100" height="100"
                     loading="lazy">
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    
    <div class="aps-product-info">
      <div class="aps-product-breadcrumbs">
        <a href="{{ routes.root_url }}">Home</a> / 
        <a href="{{ routes.collections_url | append: '/e-books' }}">E-Books</a> / 
        <span>ज्योतिष: The Science of Soul</span>
      </div>
      
      <h1 class="aps-product-title">ज्योतिष: The Science of Soul and Karmic Mathematics</h1>
      <div class="aps-product-subtitle">Decode Your Life's Script Through the Ancient Wisdom of Vedic Astrology</div>
      
      <div class="aps-product-price">
        <span class="aps-product-price-current">{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <span class="aps-product-price-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          <span class="aps-product-price-save">Save {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}</span>
        {%- endif -%}
      </div>
      
      <div class="aps-product-stock">
        {%- if product.selected_or_first_available_variant.available -%}
          <span class="aps-stock-badge in-stock">● Instant Download Available</span>
        {%- else -%}
          <span class="aps-stock-badge out-of-stock">● Currently Unavailable</span>
        {%- endif -%}
      </div>
      
      <div class="aps-product-variants">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="aps-variant-option" data-option-name="{{ option.name }}">
              <label class="aps-variant-label">{{ option.name }}</label>
              <div class="aps-variant-values">
                {%- for value in option.values -%}
                  <button class="aps-variant-value {% if option.selected_value == value %}active{% endif %}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          data-value="{{ value }}">
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}
      </div>
      
      <div class="aps-product-quantity">
        <label class="aps-quantity-label">Quantity</label>
        <div class="aps-quantity-selector">
          <button class="aps-quantity-btn minus" type="button" aria-label="Decrease quantity">−</button>
          <input type="number" class="aps-quantity-input" value="1" min="1" max="10" step="1" id="quantity-input">
          <button class="aps-quantity-btn plus" type="button" aria-label="Increase quantity">+</button>
        </div>
      </div>
      
      <div class="aps-product-actions">
        <button class="aps-add-to-cart-btn" data-add-to-cart id="add-to-cart-btn">
          <span class="btn-text">Add to Cart</span>
          <span class="btn-icon">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        </button>
        <button class="aps-buy-now-btn" data-buy-now id="buy-now-btn">
          Buy Now
        </button>
      </div>
      
      <div class="aps-product-badges">
        <div class="aps-badge-item">
          <span class="badge-icon">{{ 'icon-lightning-bolt.svg' | inline_asset_content }}</span>
          <span class="badge-text">Instant Download</span>
        </div>
        <div class="aps-badge-item">
          <span class="badge-icon">{{ 'icon-clipboard.svg' | inline_asset_content }}</span>
          <span class="badge-text">Read Anywhere</span>
        </div>
        <div class="aps-badge-item">
          <span class="badge-icon">{{ 'icon-star.svg' | inline_asset_content }}</span>
          <span class="badge-text">Karmic Mathematics</span>
        </div>
        <div class="aps-badge-item">
          <span class="badge-icon">{{ 'icon-star.svg' | inline_asset_content }}</span>
          <span class="badge-text">Expert Authored</span>
        </div>
      </div>
    </div>
  </div>
  
  <div class="aps-product-details">
    <div class="aps-details-tabs">
      <button class="aps-tab-btn active" data-tab="about">About This Book</button>
      <button class="aps-tab-btn" data-tab="benefits">What You'll Learn</button>
      <button class="aps-tab-btn" data-tab="author">About the Author</button>
      <button class="aps-tab-btn" data-tab="instructions">How to Access</button>
    </div>
    
    <div class="aps-tab-content active" data-tab-content="about">
      <h3>ज्योतिष: The Science of Soul and Karmic Mathematics</h3>
      
      <div class="aps-metafield-content">
        {%- assign product_description = product.metafields.custom.product_description -%}
        {%- if product_description != blank -%}
          {{ product_description }}
        {%- else -%}
          <div class="aps-book-intro">
            <p style="font-size: 18px; line-height: 1.6; color: var(--black);"><strong>क्या आप अपनी life की script को decode करना चाहते हैं?</strong></p>
            
            <p>In this exclusive e-book, we explore astrology not just as prediction, but as a profound <strong>"Karmic Mathematics"</strong> — a logical system that reveals the mathematics of your soul's journey through multiple lifetimes.</p>
            
            <p>Whether you are a beginner taking your first steps into Jyotish or a seasoned learner seeking deeper understanding, this guide will provide you with the foundational pillars of Vedic astrology in a practical, easy-to-understand format. From the motion of planets to the secrets of the 12 houses, every chapter is designed to help you understand your soul's blueprint.</p>
            
            <div style="background: linear-gradient(135deg, #FFF5E6 0%, #FDF8E8 100%); padding: 28px; border-radius: 8px; margin: 28px 0; text-align: center;">
              <p style="margin: 0; font-size: 20px; font-family:var(--font-heading); color: var(--saffron);"><strong>"Astrology is the mathematics of karma — the cosmic algorithm that reveals your soul's purpose."</strong></p>
            </div>
            
            <h4>Inside This E-Book:</h4>
            <div class="aps-features-grid">
              <div class="aps-feature-card">
                <span class="feature-icon">{{ 'icon-star.svg' | inline_asset_content }}</span>
                <h5>All About 12 Zodiac Signs</h5>
                <p>Understand the core energy, behavior, and characteristics of every Rashi</p>
              </div>
              <div class="aps-feature-card">
                <span class="feature-icon">{{ 'icon-star.svg' | inline_asset_content }}</span>
                <h5>Planetary Cabinet</h5>
                <p>Deep dive into planetary characteristics — Benefic, Malefic, and the crucial Gunas</p>
              </div>
              <div class="aps-feature-card">
                <span class="feature-icon">{{ 'icon-map-pin.svg' | inline_asset_content }}</span>
                <h5>The Motion of Planets</h5>
                <p>How speed and movement of celestial bodies impact your life's timing</p>
              </div>
              <div class="aps-feature-card">
                <span class="feature-icon">{{ 'icon-heart.svg' | inline_asset_content }}</span>
                <h5>Planetary Deities</h5>
                <p>Connect with divine energies (Devtas) associated with each planet</p>
              </div>
              <div class="aps-feature-card">
                <span class="feature-icon">{{ 'icon-clipboard.svg' | inline_asset_content }}</span>
                <h5>Grahon Ki Varnmala</h5>
                <p>Learn the language of governing planets in Vedic Jyotish</p>
              </div>
              <div class="aps-feature-card">
                <span class="feature-icon">{{ 'icon-box.svg' | inline_asset_content }}</span>
                <h5>Mastery of 12 Houses</h5>
                <p>Detailed analysis of how each house represents different areas of life — from wealth to relationships</p>
              </div>
              <div class="aps-feature-card">
                <span class="feature-icon">{{ 'icon-info.svg' | inline_asset_content }}</span>
                <h5>Nature, Merits, and Demerits</h5>
                <p>Evaluate strengths and weaknesses in a birth chart like a professional astrologer</p>
              </div>
            </div>
            
            <div style="background: var(--cream); padding: 24px; border-left: 4px solid var(--gold); margin: 28px 0;">
              <p style="margin: 0; font-weight: 500;"><strong>Why Choose This Book?</strong></p>
              <ul style="margin-top: 12px;">
                <li><strong>Scientific Approach:</strong> Logic and mathematics-based astrology lessons</li>
                <li><strong>Easy to Understand:</strong> Complex Vedic concepts explained in simple language</li>
                <li><strong>Instant Access:</strong> Buy karte hi aapko digital download link mil jayega</li>
                <li><strong>Digital Product:</strong> PDF format — read on phone, tablet, or laptop instantly</li>
              </ul>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
    
    <div class="aps-tab-content" data-tab-content="benefits">
      <h3>What You'll Learn</h3>
      <div class="aps-metafield-content">
        {%- assign benefits = product.metafields.custom.benefits -%}
        {%- if benefits != blank -%}
          {{ benefits }}
        {%- else -%}
          <div class="aps-learning-grid">
            <div class="aps-learning-section">
              <h4>Foundation of Jyotish</h4>
