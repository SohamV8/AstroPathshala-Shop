{% comment %}
  Astro PathShala — Gem Guide Page
  File: sections/astro-gem-guide.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.agg{font-family:var(--font-body);color:var(--black);background:transparent;}
.agg *{box-sizing:border-box;}

/* NAV */
.agg-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;min-height:80px;position:sticky;top:0;z-index:100;position:relative;}
.agg-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.agg-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.agg-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.agg-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.agg-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.agg-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.agg-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.agg-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.agg-nav-icon:hover{color:var(--black);}
.agg-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.agg-cart-btn:hover{background:var(--gold);}
.agg-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.agg-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.agg-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.agg-mob.open{display:block;}
.agg-mob ul{list-style:none;}
.agg-mob ul li{border-bottom:1px solid var(--border);}
.agg-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}

/* HERO */
.agg-hero{background:var(--dark);padding:80px 48px;text-align:center;}
.agg-hero-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:14px;display:block;}
.agg-hero-title{font-family:var(--font-heading);font-size:60px;font-weight:500;color:var(--gold-pale);line-height:1.08;margin-bottom:18px;}
.agg-hero-title em{font-style:italic;color:var(--gold);}
.agg-hero-desc{font-size:15px;color:var(--gold-lt);font-weight:300;line-height:1.8;max-width:580px;margin:0 auto 40px;}
.agg-hero-pills{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;}
.agg-hero-pill{padding:8px 20px;border:1px solid rgba(184,134,11,0.4);border-radius:20px;font-size:12px;color:var(--gold-lt);font-weight:400;}

/* WHAT ARE GEMSTONES */
.agg-intro{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid rgba(184,134,11,0.2);}
.agg-intro-img{background:var(--cream);min-height:440px;display:flex;align-items:center;justify-content:center;font-size:100px;}
.agg-intro-content{padding:64px 52px;display:flex;flex-direction:column;justify-content:center;}
.agg-intro-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:flex;align-items:center;gap:10px;}
.agg-intro-label::before{content:'';width:20px;height:1px;background:var(--gold);}
.agg-intro-title{font-family:var(--font-heading);font-size:40px;color:var(--black);font-weight:500;line-height:1.15;margin-bottom:18px;}
.agg-intro-text{font-size:14px;color:var(--muted);line-height:1.9;font-weight:300;margin-bottom:14px;}

/* HOW GEMSTONES WORK */
.agg-how{padding:72px 48px;background:var(--cream);border-top:1px solid var(--border);}
.agg-how-inner{max-width:1200px;margin:0 auto;}
.agg-how-hdr{text-align:center;margin-bottom:52px;}
.agg-how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
.agg-how-card{background:transparent;border:1px solid var(--border);border-radius:4px;padding:32px 24px;text-align:center;transition:border-color 0.2s,transform 0.2s;}
.agg-how-card:hover{border-color:var(--gold);transform:translateY(-4px);}
.agg-how-icon{width:68px;height:68px;border-radius:50%;background:var(--gold-pale);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 18px;}
.agg-how-title{font-family:var(--font-heading);font-size:20px;color:var(--black);font-weight:500;margin-bottom:12px;}
.agg-how-text{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;}

/* PLANET TABLE */
.agg-planets{padding:72px 48px;background:var(--dark);border-top:1px solid rgba(184,134,11,0.2);}
.agg-planets-inner{max-width:1200px;margin:0 auto;}
.agg-planets-hdr{text-align:center;margin-bottom:52px;}
.agg-planets-hdr-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block;}
.agg-planets-hdr-title{font-family:var(--font-heading);font-size:42px;color:var(--gold-pale);font-weight:500;}
.agg-planets-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.agg-planet-card{background:rgba(255,253,245,0.05);border:1px solid rgba(184,134,11,0.2);border-radius:4px;padding:26px 22px;transition:border-color 0.2s;}
.agg-planet-card:hover{border-color:var(--gold);}
.agg-planet-top{display:flex;align-items:center;gap:14px;margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid rgba(184,134,11,0.15);}
.agg-planet-icon{font-size:28px;flex-shrink:0;}
.agg-planet-name{font-family:var(--font-heading);font-size:20px;color:var(--gold-pale);font-weight:500;}
.agg-planet-gem{font-size:11px;color:var(--gold);font-weight:500;letter-spacing:0.8px;text-transform:uppercase;margin-top:2px;}
.agg-planet-rashi{font-size:12px;color:var(--gold-lt);font-weight:300;margin-bottom:10px;}
.agg-planet-benefits{list-style:none;}
.agg-planet-benefits li{font-size:12px;color:var(--gold-lt);font-weight:300;padding:3px 0;display:flex;gap:8px;}
.agg-planet-benefits li::before{content:'✦';color:var(--gold);font-size:8px;flex-shrink:0;margin-top:3px;}
.agg-planet-shop{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-size:11px;color:var(--gold);font-weight:500;letter-spacing:0.8px;text-transform:uppercase;text-decoration:none;border-bottom:1px solid rgba(184,134,11,0.3);padding-bottom:1px;}

/* RECOMMENDATION GUIDE */
.agg-guide{padding:72px 48px;background:transparent;border-top:1px solid var(--border);}
.agg-guide-inner{max-width:1100px;margin:0 auto;}
.agg-guide-hdr{text-align:center;margin-bottom:52px;}
.agg-guide-steps{display:flex;flex-direction:column;gap:0;}
.agg-guide-step{display:grid;grid-template-columns:80px 1fr;gap:28px;padding:32px 0;border-bottom:1px solid var(--border);align-items:start;}
.agg-guide-step:last-child{border-bottom:none;}
.agg-guide-num{width:56px;height:56px;border-radius:50%;background:var(--gold);color:var(--ivory);font-family:var(--font-heading);font-size:24px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.agg-guide-title{font-family:var(--font-heading);font-size:22px;color:var(--black);font-weight:500;margin-bottom:8px;}
.agg-guide-text{font-size:13px;color:var(--muted);line-height:1.85;font-weight:300;}

/* DOS AND DONTS */
.agg-rules{padding:72px 48px;background:var(--cream);border-top:1px solid var(--border);}
.agg-rules-inner{max-width:1100px;margin:0 auto;}
.agg-rules-hdr{text-align:center;margin-bottom:52px;}
.agg-rules-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;}
.agg-rules-col{background:transparent;border:1px solid var(--border);border-radius:4px;padding:36px 32px;}
.agg-rules-col-title{font-family:var(--font-heading);font-size:26px;color:var(--black);font-weight:500;margin-bottom:24px;display:flex;align-items:center;gap:12px;}
.agg-rules-col-title-icon{font-size:24px;}
.agg-rules-list{list-style:none;}
.agg-rules-list li{font-size:13px;color:var(--muted);font-weight:300;line-height:1.7;padding:10px 0;border-bottom:1px solid var(--border);display:flex;gap:12px;align-items:flex-start;}
.agg-rules-list li:last-child{border-bottom:none;}
.agg-rules-list li .agg-rules-ico{font-size:14px;flex-shrink:0;margin-top:1px;}
.agg-rules-list.do li .agg-rules-ico{color:#4CAF50;}
.agg-rules-list.dont li .agg-rules-ico{color:var(--saffron);}

/* ENERGIZATION */
.agg-energize{padding:72px 48px;background:var(--dark);border-top:1px solid rgba(184,134,11,0.2);}
.agg-energize-inner{max-width:1100px;margin:0 auto;}
.agg-energize-hdr{text-align:center;margin-bottom:52px;}
.agg-energize-hdr-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:12px;display:block;}
.agg-energize-hdr-title{font-family:var(--font-heading);font-size:42px;color:var(--gold-pale);font-weight:500;}
.agg-energize-hdr-sub{font-size:14px;color:var(--gold-lt);font-weight:300;margin-top:10px;}
.agg-energize-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.agg-energize-step{background:rgba(255,253,245,0.05);border:1px solid rgba(184,134,11,0.2);border-radius:4px;padding:28px 20px;text-align:center;}
.agg-energize-num{width:44px;height:44px;border-radius:50%;background:var(--gold);color:var(--ivory);font-family:var(--font-heading);font-size:20px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
.agg-energize-step-title{font-family:var(--font-heading);font-size:18px;color:var(--gold-pale);margin-bottom:10px;font-weight:500;}
.agg-energize-step-text{font-size:12px;color:var(--gold-lt);line-height:1.7;font-weight:300;}

/* FAQ */
.agg-faq{padding:72px 48px;background:transparent;border-top:1px solid var(--border);}
.agg-faq-inner{max-width:800px;margin:0 auto;}
.agg-faq-hdr{text-align:center;margin-bottom:48px;}
.agg-faq-item{border-bottom:1px solid var(--border);}
.agg-faq-q{display:flex;justify-content:space-between;align-items:center;padding:18px 0;cursor:pointer;user-select:none;}
.agg-faq-q-text{font-size:14px;font-weight:500;color:var(--black);}
.agg-faq-arrow{font-size:18px;color:var(--gold);transition:transform 0.2s;flex-shrink:0;}
.agg-faq-item.open .agg-faq-arrow{transform:rotate(45deg);}
.agg-faq-a{display:none;padding:0 0 18px;}
.agg-faq-item.open .agg-faq-a{display:block;}
.agg-faq-a p{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;}

/* CTA */
.agg-cta{padding:80px 48px;background:var(--dark);text-align:center;border-top:1px solid rgba(184,134,11,0.2);}
.agg-cta-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:block;}
.agg-cta-title{font-family:var(--font-heading);font-size:52px;color:var(--gold-pale);font-weight:500;margin-bottom:14px;}
.agg-cta-sub{font-size:15px;color:var(--gold-lt);font-weight:300;margin-bottom:36px;max-width:480px;margin-left:auto;margin-right:auto;line-height:1.7;}
.agg-cta-btn{padding:15px 40px;background:var(--gold);color:var(--ivory);border:none;font-size:12px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.agg-cta-btn:hover{background:var(--saffron);}

/* SHARED */
.agg-sec-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;display:block;}
.agg-sec-title{font-family:var(--font-heading);font-size:42px;font-weight:500;color:var(--black);}
.agg-sec-sub{font-size:14px;color:var(--muted);font-weight:300;line-height:1.8;margin-top:10px;}

/* FOOTER */
.agg-footer{background:var(--cream);}
.agg-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.agg-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.agg-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;}
.agg-footer-main{padding:56px 48px 40px;}
.agg-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.agg-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.agg-footer-social{display:flex;gap:10px;margin-top:20px;}
.agg-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.agg-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.agg-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.agg-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.agg-footer-col ul{list-style:none;}
.agg-footer-col ul li{margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.agg-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.6;}
.agg-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.agg-footer-col ul li a:hover{color:var(--gold);}
.agg-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.agg-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.agg-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.agg-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.agg-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.agg-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.agg-footer-legal{display:flex;gap:20px;}
.agg-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.agg-footer-legal a:hover{color:var(--gold);}

/* RESPONSIVE */
@media(max-width:1024px){
  .agg-nav,.agg-hero,.agg-how,.agg-planets,.agg-guide,.agg-rules,.agg-energize,.agg-faq,.agg-cta,.agg-footer-main,.agg-footer-topbar,.agg-footer-bottom{padding-left:28px;padding-right:28px;}
  .agg-intro-content{padding:48px 36px;}
  .agg-planets-grid{grid-template-columns:1fr 1fr;}
  .agg-footer-grid{grid-template-columns:1fr 1fr;gap:32px;}
}
@media(max-width:768px){
  .agg-nav{padding:0 20px;min-height:68px;}
  .agg-nav-links{display:none;}
  .agg-burger{display:flex;}
  .agg-logo img{height:54px;}
  .agg-mob{top:68px;}
  .agg-hero{padding:56px 20px;}
  .agg-hero-title{font-size:42px;}
  .agg-intro{grid-template-columns:1fr;}
  .agg-intro-img{min-height:260px;}
  .agg-intro-content{padding:40px 20px;}
  .agg-how,.agg-planets,.agg-guide,.agg-rules,.agg-energize,.agg-faq,.agg-cta{padding:52px 20px;}
  .agg-how-grid{grid-template-columns:1fr;}
  .agg-planets-grid{grid-template-columns:1fr;}
  .agg-rules-grid{grid-template-columns:1fr;}
  .agg-energize-steps{grid-template-columns:1fr 1fr;}
  .agg-guide-step{grid-template-columns:60px 1fr;gap:16px;}
  .agg-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .agg-footer-main,.agg-footer-topbar,.agg-footer-bottom{padding-left:20px;padding-right:20px;}
  .agg-footer-topbar{flex-direction:column;text-align:center;}
  .agg-footer-bottom{flex-direction:column;text-align:center;}
}
@media(max-width:480px){
  .agg-hero-title{font-size:34px;}
  .agg-cta-title{font-size:36px;}
  .agg-energize-steps{grid-template-columns:1fr;}
  .agg-footer-grid{grid-template-columns:1fr;}
}
</style>

<div class="agg">

{%- comment -%} HERO {%- endcomment -%}
<div class="agg-hero">
  <span class="agg-hero-label">Sacred Knowledge</span>
  <h1 class="agg-hero-title">The Complete <em>Gemstone</em> Guide</h1>
  <p class="agg-hero-desc">Everything you need to know about choosing, wearing and caring for astrological gemstones — written by our Vedic astrology experts.</p>
