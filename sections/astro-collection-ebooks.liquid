{% comment %}
  Astro PathShala — E-Books Collection Section
  File: sections/astro-collection-ebooks.liquid
{% endcomment %}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.aeb{font-family:var(--font-body);color:var(--black);background:transparent;}
.aeb *{box-sizing:border-box;}
.aeb-nav{display:flex;align-items:center;justify-content:space-between;padding:0 48px;border-bottom:1px solid var(--border);background:transparent;min-height:80px;position:sticky;top:0;z-index:100;position:relative;}
.aeb-logo{display:flex;align-items:center;text-decoration:none;flex-shrink:0;}
.aeb-logo img{height:68px;width:auto;display:block;object-fit:contain;}
.aeb-logo-text{font-family:var(--font-heading);font-size:22px;font-weight:500;color:var(--black);}
.aeb-nav-links{display:flex;gap:32px;list-style:none;margin:0 auto;}
.aeb-nav-links a{text-decoration:none;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;transition:color 0.2s;padding:28px 0;display:block;border-bottom:2px solid transparent;}
.aeb-nav-links a:hover{color:var(--black);border-bottom-color:var(--gold);}
.aeb-nav-right{display:flex;gap:16px;align-items:center;flex-shrink:0;}
.aeb-nav-icon{font-size:16px;color:var(--muted);cursor:pointer;text-decoration:none;transition:color 0.2s;}
.aeb-nav-icon:hover{color:var(--black);}
.aeb-cart-btn{background:var(--black);color:var(--ivory);border:none;padding:9px 20px;font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;cursor:pointer;border-radius:2px;font-family:var(--font-body);text-decoration:none;display:inline-block;transition:background 0.2s;}
.aeb-cart-btn:hover{background:var(--gold);}
.aeb-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.aeb-burger span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
.aeb-mob{display:none;position:absolute;top:80px;left:0;right:0;background:transparent;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:16px 24px;z-index:99;}
.aeb-mob.open{display:block;}
.aeb-mob ul{list-style:none;}
.aeb-mob ul li{border-bottom:1px solid var(--border);}
.aeb-mob ul li a{display:block;padding:13px 0;font-size:13px;color:var(--muted);text-decoration:none;letter-spacing:1px;text-transform:uppercase;}
.aeb-crumb{padding:14px 48px;background:var(--cream);border-bottom:1px solid var(--border);font-size:12px;color:var(--muted);display:flex;align-items:center;gap:8px;}
.aeb-crumb a{color:var(--muted);text-decoration:none;}
.aeb-crumb a:hover{color:var(--gold);}
.aeb-crumb-sep{color:var(--border);}
.aeb-crumb-cur{color:var(--gold);font-weight:500;}
.aeb-strip{background:var(--dark);padding:14px 48px;display:flex;align-items:center;justify-content:center;gap:40px;flex-wrap:wrap;}
.aeb-strip-item{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--gold-pale);letter-spacing:0.8px;font-weight:400;}
.aeb-strip-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0;}
.aeb-toolbar{display:flex;align-items:center;justify-content:space-between;padding:14px 48px;background:transparent;border-bottom:1px solid var(--border);}
.aeb-count{font-size:13px;color:var(--muted);font-weight:300;}
.aeb-count strong{color:var(--black);font-weight:500;}
.aeb-sort-wrap{display:flex;align-items:center;gap:10px;}
.aeb-sort-label{font-size:12px;color:var(--muted);}
.aeb-sort{padding:8px 14px;border:1px solid var(--border);background:transparent;font-size:12px;font-family:var(--font-body);color:var(--black);border-radius:2px;outline:none;cursor:pointer;}
.aeb-sort:focus{border-color:var(--gold);}
.aeb-grid-wrap{padding:48px;}
.aeb-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px;}
.aeb-card{text-decoration:none;display:flex;flex-direction:column;align-items:center;text-align:center;}
.aeb-card:hover .aeb-book-shadow{transform:translateY(-6px);box-shadow:0 16px 40px rgba(26,18,8,0.18);}
.aeb-card:hover .aeb-card-name{color:var(--gold);}
.aeb-book-wrap{width:100%;max-width:230px;margin-bottom:20px;position:relative;}
.aeb-book-shadow{aspect-ratio:4/5;display:flex;align-items:center;justify-content:center;border-radius:6px;overflow:hidden;transition:transform 0.3s,box-shadow 0.3s;box-shadow:none;position:relative;border:none;background:transparent;}
.aeb-book-cover{width:100%;height:auto;max-height:100%;object-fit:contain;display:block;background:transparent;mix-blend-mode:multiply;filter:drop-shadow(0 10px 20px rgba(0,0,0,0.12));}
.aeb-book-placeholder{width:100%;aspect-ratio:2/3;background:var(--cream);border:1px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:20px;}
.aeb-book-placeholder-icon{font-size:40px;line-height:1;}
.aeb-book-placeholder-title{font-family:var(--font-heading);font-size:14px;color:var(--muted);line-height:1.4;}
.aeb-badge{position:absolute;top:10px;left:10px;background:var(--gold);color:var(--ivory);font-size:9px;padding:3px 9px;border-radius:2px;letter-spacing:0.8px;text-transform:uppercase;font-weight:500;z-index:1;}
.aeb-badge.sale{background:var(--saffron);}
.aeb-badge.new{background:var(--black);}
.aeb-instant-tag{display:inline-flex;align-items:center;gap:5px;background:var(--cream);border:1px solid var(--border);border-radius:2px;padding:4px 10px;font-size:10px;color:var(--muted);font-weight:500;letter-spacing:0.5px;margin-bottom:10px;}
.aeb-card-info{width:100%;}
.aeb-card-type{font-size:9px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:6px;}
.aeb-card-name{font-family:var(--font-heading);font-size:20px;color:var(--black);font-weight:500;line-height:1.3;margin-bottom:6px;transition:color 0.2s;}
.aeb-card-author{font-size:12px;color:var(--muted);font-weight:300;margin-bottom:12px;font-style:italic;}
.aeb-card-footer{display:flex;align-items:center;justify-content:center;gap:14px;}
.aeb-price{font-family:var(--font-heading);font-size:20px;color:var(--saffron);font-weight:500;}
.aeb-compare{font-size:13px;color:#B0A060;text-decoration:line-through;font-weight:300;}
.aeb-info-link{font-size:11px;color:var(--gold);font-weight:500;letter-spacing:0.8px;text-decoration:none;display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--border);padding-bottom:1px;}
.aeb-empty{text-align:center;padding:80px 40px;}
.aeb-empty-icon{font-size:52px;margin-bottom:18px;}
.aeb-empty-title{font-family:var(--font-heading);font-size:26px;color:var(--black);margin-bottom:8px;}
.aeb-empty-desc{font-size:13px;color:var(--muted);font-weight:300;}
.aeb-pagination{display:flex;justify-content:center;gap:8px;padding:40px 48px;}
.aeb-page-link{padding:9px 16px;border:1px solid var(--border);color:var(--muted);text-decoration:none;font-size:12px;border-radius:2px;transition:all 0.2s;}
.aeb-page-link:hover{border-color:var(--gold);color:var(--gold);}
.aeb-page-current{padding:9px 16px;border:1px solid var(--gold);background:var(--gold);color:var(--ivory);font-size:12px;border-radius:2px;}
.aeb-footer{background:transparent;}
.aeb-footer-topbar{background:var(--black);padding:14px 48px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.aeb-footer-topbar p{font-size:13px;color:var(--gold-pale);font-weight:500;}
.aeb-footer-topbar a{font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;color:var(--black);background:var(--gold);padding:7px 18px;border-radius:2px;text-decoration:none;}
.aeb-footer-main{padding:56px 48px 40px;}
.aeb-footer-grid{display:grid;grid-template-columns:2.2fr 1fr 1fr 1fr;gap:52px;margin-bottom:48px;}
.aeb-footer-desc{font-size:13px;color:var(--muted);margin-top:14px;font-weight:300;line-height:1.8;max-width:240px;}
.aeb-footer-social{display:flex;gap:10px;margin-top:20px;}
.aeb-footer-social a{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);text-decoration:none;transition:border-color 0.2s,color 0.2s;}
.aeb-footer-social a:hover{border-color:var(--gold);color:var(--gold);}
.aeb-footer-divider{width:40px;height:2px;background:var(--gold);margin-bottom:20px;border-radius:1px;}
.aeb-footer-col h4{font-size:10px;font-weight:500;letter-spacing:2.5px;text-transform:uppercase;color:var(--black);margin-bottom:20px;}
.aeb-footer-col ul{list-style:none;}
.aeb-footer-col ul li{margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.aeb-footer-col ul li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--gold);flex-shrink:0;opacity:0.6;}
.aeb-footer-col ul li a{font-size:13px;color:var(--muted);text-decoration:none;font-weight:300;transition:color 0.2s;}
.aeb-footer-col ul li a:hover{color:var(--gold);}
.aeb-footer-contact p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;display:flex;align-items:flex-start;gap:8px;margin-bottom:10px;}
.aeb-footer-contact .lbl{color:var(--gold);font-weight:500;font-size:11px;min-width:20px;}
.aeb-footer-bottom{border-top:1px solid var(--border);padding:20px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
.aeb-footer-copy{font-size:12px;color:var(--muted);font-weight:300;}
.aeb-footer-india{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}
.aeb-footer-india::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--gold);}
.aeb-footer-legal{display:flex;gap:20px;}
.aeb-footer-legal a{font-size:12px;color:var(--muted);text-decoration:none;transition:color 0.2s;}
.aeb-footer-legal a:hover{color:var(--gold);}
@media(max-width:1024px){
  .aeb-crumb,.aeb-strip,.aeb-toolbar,.aeb-grid-wrap,.aeb-pagination,.aeb-footer-main,.aeb-footer-topbar,.aeb-footer-bottom{padding-left:28px;padding-right:28px;}
  .aeb-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;}
}
@media(max-width:768px){
  .aeb-nav{padding:0 20px;min-height:68px;}
  .aeb-nav-links{display:none;}
  .aeb-burger{display:flex;}
  .aeb-logo img{height:54px;}
  .aeb-mob{top:68px;}
  .aeb-crumb,.aeb-strip,.aeb-toolbar,.aeb-grid-wrap,.aeb-pagination,.aeb-footer-main,.aeb-footer-topbar,.aeb-footer-bottom{padding-left:20px;padding-right:20px;}
  .aeb-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;}
  .aeb-strip{gap:16px;}
  .aeb-footer-grid{grid-template-columns:1fr 1fr;gap:28px;}
  .aeb-footer-topbar{flex-direction:column;text-align:center;}
  .aeb-footer-bottom{flex-direction:column;text-align:center;}
}
@media(max-width:480px){
  .aeb-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;}
  .aeb-grid-wrap{padding:28px 20px;}
  .aeb-footer-grid{grid-template-columns:1fr;}
}
</style>

<div class="aeb">

{%- comment -%} NAV {%- endcomment -%}

{%- comment -%} BREADCRUMB {%- endcomment -%}
<div class="aeb-crumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span class="aeb-crumb-sep">›</span>
  <span class="aeb-crumb-cur">{{ collection.title | default: 'E-Books' }}</span>
</div>

{%- comment -%} STRIP {%- endcomment -%}
<div class="aeb-strip">
  <div class="aeb-strip-item"><span class="aeb-strip-dot"></span>Instant delivery to your email</div>
  <div class="aeb-strip-item"><span class="aeb-strip-dot"></span>PDF format — read on any device</div>
  <div class="aeb-strip-item"><span class="aeb-strip-dot"></span>Written by expert astrologers</div>
  <div class="aeb-strip-item"><span class="aeb-strip-dot"></span>Available in Hindi &amp; English</div>
</div>

{%- comment -%} TOOLBAR {%- endcomment -%}
<div class="aeb-toolbar">
  <div class="aeb-count"><strong>{{ collection.products_count }}</strong> e-books available</div>
  <div class="aeb-sort-wrap">
    <span class="aeb-sort-label">Sort by</span>
    <select class="aeb-sort" onchange="aebSort(this.value)">
      <option value="manual">Featured</option>
      <option value="price-asc">Price: Low to High</option>
      <option value="price-desc">Price: High to Low</option>
      <option value="title-asc">Name: A–Z</option>
      <option value="created-desc">Newest First</option>
    </select>
  </div>
</div>

{%- comment -%} BOOK GRID {%- endcomment -%}
<div class="aeb-grid-wrap">
  {%- if collection.products.size > 0 -%}
    <div class="aeb-grid" id="aeb-grid">
      {%- for product in collection.products -%}
        <a href="{{ product.url }}" class="aeb-card" data-price="{{ product.price }}" data-title="{{ product.title | downcase }}">
          <div class="aeb-book-wrap">
            <div class="aeb-book-shadow">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag: class: 'aeb-book-cover', loading: 'lazy', alt: product.featured_image.alt | default: product.title
                }}
              {%- else -%}
                <div class="aeb-book-placeholder">
                  <div class="aeb-book-placeholder-icon">&#128218;</div>
                  <div class="aeb-book-placeholder-title">{{ product.title }}</div>
                </div>
              {%- endif -%}
              {%- if product.tags contains 'bestseller' or product.tags contains 'Bestseller' -%}
                <div class="aeb-badge">Bestseller</div>
              {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
                <div class="aeb-badge new">New</div>
              {%- elsif product.compare_at_price > product.price -%}
                <div class="aeb-badge sale">Sale</div>
              {%- endif -%}
            </div>
          </div>
          <div class="aeb-card-info">
            <div class="aeb-instant-tag">&#9889; Instant Download</div>
            <div class="aeb-card-type">{{ product.product_type | default: 'E-Book' }}</div>
            <div class="aeb-card-name">{{ product.title }}</div>
            {%- if product.metafields.custom.author != blank -%}
              <div class="aeb-card-author">by {{ product.metafields.custom.author }}</div>
            {%- endif -%}
            <div class="aeb-card-footer">
              <span class="aeb-price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="aeb-compare">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
              <span class="aeb-info-link">More Information &#8594;</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="aeb-empty">
      <div class="aeb-empty-icon">&#128218;</div>
      <div class="aeb-empty-title">Coming Soon</div>
      <div class="aeb-empty-desc">We are adding our e-book collection. Please check back soon.</div>
    </div>
  {%- endif -%}
  {%- paginate collection.products by 18 -%}
    {%- if paginate.pages > 1 -%}
      <div class="aeb-pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="aeb-page-link">&#8592; Prev</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}" class="aeb-page-link">{{ part.title }}</a>
          {%- else -%}<span class="aeb-page-current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="aeb-page-link">Next &#8594;</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{%- comment -%} FOOTER {%- endcomment -%}

</div>

<script>
function aebSort(val){
  var g=document.getElementById('aeb-grid');
  if(!g)return;
  var cards=Array.from(g.querySelectorAll('.aeb-card'));
  cards.sort(function(a,b){
    if(val==='price-asc')return parseFloat(a.dataset.price)-parseFloat(b.dataset.price);
    if(val==='price-desc')return parseFloat(b.dataset.price)-parseFloat(a.dataset.price);
    if(val==='title-asc')return a.dataset.title.localeCompare(b.dataset.title);
    return 0;
  });
  cards.forEach(function(c){g.appendChild(c);});
}
</script>

{% schema %}
{
  "name": "E-Books Collection",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Navigation" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" }
  ],
  "presets": [{ "name": "E-Books Collection" }]
}
{% endschema %}



