        <a href="mailto:{{ section.settings.contact_email | default: 'support@astropathshala.com' }}" class="afq-contact-card-link">{{ section.settings.contact_email | default: 'support@astropathshala.com' }}</a>
      </div>
      <div class="afq-contact-card">
        <div class="afq-contact-card-icon">&#128221;</div>
        <div class="afq-contact-card-title">Contact Form</div>
        <div class="afq-contact-card-text">Fill in our contact form with your query and our team will get back to you promptly.</div>
        <a href="/pages/contact" class="afq-contact-card-link">Go to Contact Page &#8594;</a>
      </div>
    </div>
  </div>
</div>

</div>

<script>
function afqSearch(val) {
  var q = val.toLowerCase().trim();
  var items = document.querySelectorAll('.afq-acc');
  var sections = document.querySelectorAll('.afq-section');
  var noResults = document.getElementById('afq-no-results');
  var found = 0;
  sections.forEach(function(s){ s.style.display = 'block'; });
  items.forEach(function(item) {
    var text = item.textContent.toLowerCase();
    var show = !q || text.indexOf(q) !== -1;
    item.style.display = show ? 'block' : 'none';
    if (show && q) found++;
  });
  if (q) {
    sections.forEach(function(s) {
      var visible = Array.from(s.querySelectorAll('.afq-acc')).some(function(i){ return i.style.display !== 'none'; });
      s.style.display = visible ? 'block' : 'none';
    });
    noResults.style.display = found === 0 ? 'block' : 'none';
  } else {
    noResults.style.display = 'none';
  }
}
function afqFilterCategory(btn, cat) {
  document.querySelectorAll('.afq-tab-btn').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  var sections = document.querySelectorAll('.afq-section');
  sections.forEach(function(s) {
    s.style.display = (cat === 'all' || s.dataset.category === cat) ? 'block' : 'none';
  });
}
function afqScrollTo(id, button) {
  var el = document.getElementById(id);
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.querySelectorAll('.afq-sidebar-link').forEach(function(l){ l.classList.remove('active'); });
  if (button) button.classList.add('active');
}
function afqFeedback(helpful) {
  var btn = document.querySelector('.afq-helpful-yes');
  if (helpful) {
    btn.textContent = '✓ Thank you!';
    btn.style.background = 'var(--gold)';
    btn.disabled = true;
  } else {
    window.location.href = '/pages/contact';
  }
}
</script>

