{% render 'lux-academy-assets', load_js: false %}

{%- style -%}
  #LuxCombos-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #LuxCombos-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="academy-combos"
  class="lux-academy lux-academy--combos section-{{ section.id }}-padding"
  data-lux-academy
  data-academy-type="combos"
  aria-labelledby="LuxCombosHeading-{{ section.id }}"
>
  <div class="lux-academy__inner">
    <div class="lux-academy__panel" data-academy-reveal>
      <header class="lux-academy__panel-head">
        <div class="lux-academy__panel-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="lux-academy__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 id="LuxCombosHeading-{{ section.id }}" class="lux-academy__heading">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="lux-academy__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </header>

      {%- if section.settings.show_search -%}
        <div class="lux-academy__toolbar">
          <label class="lux-academy__search">
            <span class="visually-hidden">{{ section.settings.search_placeholder | escape }}</span>
            <svg class="lux-academy__search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"/>
              <path d="M14 14l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input
              type="search"
              class="lux-academy__search-input"
              data-academy-search
              placeholder="{{ section.settings.search_placeholder | escape }}"
              autocomplete="off"
              enterkeyhint="search"
            >
          </label>
        </div>
      {%- endif -%}
    </div>

    <div class="lux-academy__catalog" data-academy-catalog>
      {% render 'academy-combos-grid' %}
      <p class="lux-academy__empty" data-academy-empty hidden>No bundles match your search.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Combos catalog",
  "tag": "section",
  "class": "section-lux-combos-catalog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best value"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Course bundles"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated bundles for deeper learning — multiple programs, one enrollment, exceptional value."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search bundles"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Combos catalog"
    }
  ]
}
{% endschema %}
