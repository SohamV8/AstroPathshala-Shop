{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#FFFDF5;--black:#1A1208;--gold:#B8860B;--saffron:#D4860A;
  --gold-lt:#C9A84C;--gold-pale:#F5E6C8;--cream:#FDF8E8;--border:#E8D48A;
  --muted:#7A6535;--dark:rgba(44,32,5,0.65);
}
.abl{font-family:var(--font-body);color:var(--black);background:transparent;}
.abl *{box-sizing:border-box;}

@keyframes ablFadeUp{from{opacity:0;transform:translateY(28px);}to{opacity:1;transform:translateY(0);}}

/* ARTICLE HERO */
.abl-article-hero{position:relative;min-height:56vh;display:grid;place-items:center;overflow:hidden;background:var(--black);}
.abl-article-hero-media{position:absolute;inset:0;}
.abl-article-hero-media img{width:100%;height:100%;object-fit:cover;display:block;}
.abl-article-hero-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(26,18,8,0.78),rgba(26,18,8,0.28));}
.abl-article-hero-inner{position:relative;z-index:1;width:min(980px,100%);padding:92px 48px;text-align:center;animation:ablFadeUp 0.9s ease both;}
.abl-article-label{font-size:10px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:18px;display:block;}
.abl-article-title{font-family:var(--font-heading);font-size:64px;font-weight:500;color:var(--gold-pale);line-height:1.08;margin:0 0 18px;}
.abl-article-meta{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;align-items:center;color:rgba(201,168,76,0.9);font-size:12px;letter-spacing:1px;text-transform:uppercase;}
.abl-article-meta .dot{width:4px;height:4px;border-radius:50%;background:rgba(232,212,138,0.55);display:inline-block;}

/* LAYOUT */
.abl-article-wrap{width:min(1280px,100%);margin:0 auto;padding:46px 48px 10px;display:grid;grid-template-columns:280px minmax(0,900px);gap:42px;align-items:start;}
.abl-toc{position:sticky;top:96px;border:1px solid var(--border);border-radius:4px;background:var(--cream);padding:18px;}
.abl-toc h3{font-family:var(--font-heading);font-size:20px;color:var(--black);margin:0 0 12px;}
.abl-toc ul{list-style:none;display:grid;gap:10px;margin:0;padding:0;}
.abl-toc a{text-decoration:none;color:var(--muted);font-size:13px;line-height:1.5;}
.abl-toc a:hover{color:var(--black);text-decoration:underline;}
.abl-toc-toggle{display:none;width:100%;margin-bottom:12px;background:none;border:1px solid var(--border);padding:10px 12px;border-radius:4px;color:var(--muted);font-size:12px;letter-spacing:1px;text-transform:uppercase;cursor:pointer;font-family:var(--font-body);}
.abl-toc.is-open ul{display:grid;}

.abl-article-content{max-width:900px;}
.abl-article-content.rte{font-size:17px;line-height:1.95;color:var(--black);}
.abl-article-content.rte h2,.abl-article-content.rte h3{font-family:var(--font-heading);line-height:1.25;color:var(--black);margin-top:34px;}
.abl-article-content.rte h2{font-size:34px;font-weight:500;}
.abl-article-content.rte h3{font-size:24px;font-weight:500;}
.abl-article-content.rte p{margin:0 0 16px;}
.abl-article-content.rte p:first-of-type::first-letter{float:left;font-family:var(--font-heading);font-size:72px;line-height:0.9;color:var(--gold);padding-right:10px;margin-top:4px;}
.abl-article-content blockquote{margin:34px auto;max-width:720px;text-align:center;font-family:var(--font-heading);font-style:italic;color:var(--dark);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:22px 14px;background:rgba(253,248,232,0.65);}

/* SHARE */
.abl-share{margin-top:26px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
.abl-share-label{font-size:10px;font-weight:500;letter-spacing:3px;text-transform:uppercase;color:var(--muted);}
.abl-share a{width:38px;height:38px;border-radius:50%;border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;color:var(--muted);text-decoration:none;transition:transform 0.2s,border-color 0.2s,color 0.2s;}
.abl-share a:hover{transform:translateY(-1px);border-color:var(--gold);color:var(--gold);}

/* AUTHOR */
.abl-author{margin-top:28px;padding-top:18px;border-top:1px solid var(--border);}
.abl-author h3{font-family:var(--font-heading);font-size:22px;color:var(--black);margin:0 0 6px;}
.abl-author p{font-size:13px;color:var(--muted);font-weight:300;line-height:1.8;margin:0;}

/* RELATED */
.abl-related{width:min(1280px,100%);margin:0 auto;padding:22px 48px 24px;}
.abl-related h2{font-family:var(--font-heading);font-size:34px;color:var(--black);font-weight:500;margin:0 0 18px;}
.abl-related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;}
.abl-related-card{text-decoration:none;display:block;background:transparent;border:1px solid var(--border);border-radius:4px;overflow:hidden;transition:transform 0.24s ease,border-color 0.24s ease;}
.abl-related-card:hover{transform:translateY(-2px);border-color:var(--gold);}
.abl-related-media{aspect-ratio:16/10;overflow:hidden;background:var(--cream);}
.abl-related-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.4s ease;}
.abl-related-card:hover .abl-related-media img{transform:scale(1.04);}
.abl-related-body{padding:16px 16px 18px;}
.abl-related-title{font-family:var(--font-heading);font-size:22px;color:var(--black);font-weight:500;line-height:1.25;margin:0 0 10px;}
.abl-related-excerpt{font-size:13px;color:var(--muted);line-height:1.8;font-weight:300;margin:0;}

/* COMMENTS */
.abl-comments{width:min(980px,100%);margin:0 auto;padding:18px 48px 26px;}
.abl-comments h2{font-family:var(--font-heading);font-size:34px;color:var(--black);font-weight:500;margin:0 0 16px;}
.abl-comments .field__input,.abl-comments .text-area{border-width:1px;border-color:var(--border);}
.abl-comments .field__label,.abl-comments .form__label{color:var(--muted);}
.abl-comments .button{border-radius:2px;}

/* CTA */
.abl-cta{background:var(--black);padding:70px 48px;text-align:center;border-top:1px solid rgba(184,134,11,0.2);}
.abl-cta-label{font-size:10px;font-weight:500;letter-spacing:4px;text-transform:uppercase;color:var(--gold-lt);margin-bottom:16px;display:block;}
.abl-cta-title{font-family:var(--font-heading);font-size:44px;color:var(--gold-pale);font-weight:500;margin-bottom:10px;line-height:1.1;}
.abl-cta-sub{font-size:14px;color:var(--gold-lt);font-weight:300;margin:0 auto 26px;line-height:1.7;max-width:520px;}
.abl-cta-btn{display:inline-block;background:transparent;color:var(--gold-pale);border:1px solid rgba(201,168,76,0.55);padding:12px 22px;font-size:11px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;border-radius:2px;transition:border-color 0.2s,color 0.2s,background 0.2s;}
.abl-cta-btn:hover{border-color:var(--gold);color:var(--ivory);background:rgba(184,134,11,0.14);}

/* RESPONSIVE */
@media(max-width:1024px){
  .abl-article-wrap,.abl-related,.abl-comments,.abl-cta{padding-left:28px;padding-right:28px;}
  .abl-article-wrap{grid-template-columns:1fr;gap:26px;}
  .abl-toc{position:static;}
  .abl-related-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;}
  .abl-article-title{font-size:52px;}
}
@media(max-width:768px){
  .abl-article-hero-inner{padding:76px 20px;}
  .abl-article-title{font-size:40px;}
  .abl-article-wrap,.abl-related,.abl-comments,.abl-cta{padding-left:20px;padding-right:20px;}
  .abl-toc-toggle{display:block;}
  .abl-toc ul{display:none;}
  .abl-related-grid{grid-template-columns:1fr;}
}
@media(max-width:480px){
  .abl-article-title{font-size:34px;}
  .abl-cta-title{font-size:30px;}
}
</style>

{% assign share_url = request.origin | append: article.url %}
{% assign twitter_url = 'https://twitter.com/intent/tweet?url=' | append: share_url | append: '&text=' | append: article.title | url_encode %}
{% assign facebook_url = 'https://www.facebook.com/sharer/sharer.php?u=' | append: share_url %}
{% assign whatsapp_url = 'https://wa.me/?text=' | append: article.title | append: ' ' | append: share_url | url_encode %}

<article class="abl-article">
  <section class="abl-article-hero">
    {% if article.image %}
      <div class="abl-article-hero-media">
        {{
          article.image
          | image_url: width: 3000
          | image_tag: loading: 'eager', fetchpriority: 'high', alt: article.image.alt | escape
        }}
      </div>
    {% endif %}
    <div class="abl-article-hero-overlay"></div>
    <div class="abl-article-hero-inner">
      <span class="abl-article-label">{{ blog.title | default: 'Astro PathShala' }}</span>
      <h1 class="abl-article-title">{{ article.title | escape }}</h1>
      <div class="abl-article-meta">
        <span>{{ article.author }}</span><span class="dot"></span>
        <span>{{ article.published_at | time_tag: format: 'date' }}</span><span class="dot"></span>
        <span id="astro-reading-time">5 min read</span>
      </div>
    </div>
  </section>

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="page-width page-width--narrow" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <section class="abl-article-wrap">
    <aside class="abl-toc" id="astro-toc">
      <button type="button" class="abl-toc-toggle" id="astro-toc-toggle">Table of Contents</button>
      <h3>Table of Contents</h3>
      <ul id="astro-toc-list"></ul>
    </aside>

    <div>
      <div class="abl-article-content rte" id="astro-article-content">
        {{ article.content }}
      </div>

      <div class="abl-share">
        <span class="abl-share-label">{{ 'blogs.article.share' | t }}</span>
        <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.52 3.48A11.82 11.82 0 0 0 12.08 0C5.56 0 .23 5.33.22 11.87a11.8 11.8 0 0 0 1.6 5.96L0 24l6.32-1.65a11.84 11.84 0 0 0 5.73 1.47h.01c6.53 0 11.86-5.33 11.87-11.87a11.8 11.8 0 0 0-3.41-8.47Zm-8.46 18.34h-.01a9.8 9.8 0 0 1-4.98-1.36l-.36-.21-3.75.98 1-3.66-.23-.37a9.83 9.83 0 0 1-1.5-5.27c0-5.42 4.41-9.84 9.84-9.84a9.8 9.8 0 0 1 6.97 2.89 9.8 9.8 0 0 1 2.89 6.98c0 5.43-4.41 9.85-9.86 9.85Zm5.4-7.39c-.29-.15-1.73-.85-2-.95-.27-.1-.47-.15-.67.15-.19.29-.75.95-.92 1.14-.17.19-.34.22-.63.07-.29-.15-1.24-.46-2.36-1.46-.88-.78-1.47-1.75-1.64-2.04-.17-.29-.02-.45.13-.6.13-.13.29-.34.44-.51.15-.17.2-.29.29-.49.1-.19.05-.36-.02-.51-.08-.15-.67-1.61-.92-2.21-.24-.58-.48-.5-.66-.51h-.56c-.19 0-.5.07-.77.36-.27.29-1.02 1-1.02 2.45 0 1.44 1.05 2.83 1.2 3.02.14.2 2.06 3.14 5 4.4.7.3 1.24.48 1.67.61.7.22 1.33.19 1.83.12.56-.08 1.72-.7 1.96-1.37.24-.68.24-1.26.17-1.38-.07-.12-.26-.19-.55-.34Z"/></svg>
        </a>
        <a href="{{ twitter_url }}" target="_blank" rel="noopener" aria-label="Share on Twitter">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.27l-4.9-6.4L6.4 22H3.3l7.24-8.27L.8 2h6.43l4.43 5.84L18.9 2Zm-1.1 18h1.74L6.3 3.9H4.43L17.8 20Z"/></svg>
        </a>
        <a href="{{ facebook_url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
      </div>

      <div class="abl-author">
        <h3>{{ article.author }}</h3>
        <p>Astro Pathshala contributor sharing practical Vedic insights for modern spiritual life.</p>
      </div>
    </div>
  </section>

  <section class="abl-related">
    <h2>Related Articles</h2>
    <div class="abl-related-grid">
      {% assign related_count = 0 %}
      {% for related_article in blog.articles %}
        {% if related_article.id != article.id %}
          <a class="abl-related-card" href="{{ related_article.url }}">
            <div class="abl-related-media">
              {% if related_article.image %}
                {{
                  related_article.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', alt: related_article.title | escape
                }}
              {% endif %}
            </div>
            <div class="abl-related-body">
              <h3 class="abl-related-title">{{ related_article.title | escape }}</h3>
              <p class="abl-related-excerpt">{{ related_article.excerpt_or_content | strip_html | truncate: 100 }}</p>
            </div>
          </a>
          {% assign related_count = related_count | plus: 1 %}
          {% if related_count == 3 %}
            {% break %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </section>

  {%- if blog.comments_enabled? -%}
    <section class="abl-comments">
      <div id="comments">
        {%- if article.comments_count > 0 -%}
          {%- assign anchor_id = '#Comments-' | append: article.id -%}
          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>

          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                    <span class="caption-with-letter-spacing">{{ comment.created_at | time_tag: format: 'date' }}</span>
                  </footer>
                </article>
              {%- endfor -%}

              {% render 'pagination', paginate: paginate, anchor: anchor_id %}
            </div>
          {% endpaginate %}
        {%- endif -%}

        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}

          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>

          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">{{ 'icon-success.svg' | inline_asset_content }}</span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div {% if blog.moderated? == false %}class="article-template__comments-fields"{% endif %}>
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{ 'blogs.article.name' | t }} <span aria-hidden="true">*</span>
                </label>
              </div>

              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  class="field__input"
                  autocomplete="email"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{ 'blogs.article.email' | t }} <span aria-hidden="true">*</span>
                </label>
              </div>
            </div>

            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{ 'blogs.article.message' | t }} <span aria-hidden="true">*</span>
              </label>
            </div>
          </div>

          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </section>
  {%- endif -%}

  <section class="abl-cta">
    <span class="abl-cta-label">Join Astro Pathshala</span>
    <h2 class="abl-cta-title">Receive Sacred Guidance</h2>
    <p class="abl-cta-sub">Timeless wisdom, practical remedies, and spiritual insights—delivered with care.</p>
    <a class="abl-cta-btn" href="{{ routes.account_register_url }}">Begin Your Journey</a>
  </section>

</article>

<script>
  (function () {
    var content = document.getElementById('astro-article-content');
    if (!content) return;

    var text = content.innerText || '';
    var words = text.trim().split(/\s+/).filter(Boolean).length;
    var minutes = Math.max(1, Math.ceil(words / 220));
    var readEl = document.getElementById('astro-reading-time');
    if (readEl) readEl.textContent = minutes + ' min read';

    var tocList = document.getElementById('astro-toc-list');
    var headings = content.querySelectorAll('h2');
    headings.forEach(function (heading, idx) {
      if (!heading.id) heading.id = 'astro-h2-' + (idx + 1);
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + heading.id;
      a.textContent = heading.textContent || 'Section ' + (idx + 1);
      li.appendChild(a);
      tocList.appendChild(li);
    });

    if (!headings.length) {
      var toc = document.getElementById('astro-toc');
      if (toc) toc.style.display = 'none';
    }

    var tocToggle = document.getElementById('astro-toc-toggle');
    var tocEl = document.getElementById('astro-toc');
    if (tocToggle && tocEl) {
      tocToggle.addEventListener('click', function () {
        tocEl.classList.toggle('is-open');
      });
    }
  })();
</script>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "featured_image",
      "name": "t:sections.main-article.blocks.featured_image.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "image_height",
          "options": [
            { "value": "adapt", "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__1.label" },
            { "value": "small", "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__2.label" },
            { "value": "medium", "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__3.label" },
            { "value": "large", "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__4.label" }
          ],
          "default": "adapt",
          "label": "t:sections.main-article.blocks.featured_image.settings.image_height.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-article.blocks.title.name",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "blog_show_date", "default": true, "label": "t:sections.main-article.blocks.title.settings.blog_show_date.label" },
        { "type": "checkbox", "id": "blog_show_author", "default": false, "label": "t:sections.main-article.blocks.title.settings.blog_show_author.label" }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.main-article.blocks.content.name",
      "limit": 1
    },
