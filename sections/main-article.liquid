{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{{ 'blog-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wc = article.content | strip_html | split: ' ' | size
  assign read_mins = wc | divided_by: 200
  if read_mins < 1
    assign read_mins = 1
  endif

  assign faq_entities = ''
  assign faq_first_schema = true
  for block in section.blocks
    if block.type == 'faq_pair' and block.settings.question != blank and block.settings.answer != blank
      assign q_json = block.settings.question | strip_html | strip | truncate: 490 | json
      assign a_json = block.settings.answer | strip_html | strip | truncate: 4000 | json
      unless faq_first_schema
        assign faq_entities = faq_entities | append: ','
      endunless
      assign faq_entities = faq_entities | append: '{"@type":"Question","name":' | append: q_json | append: ',"acceptedAnswer":{"@type":"Answer","text":' | append: a_json | append: '}}'
      assign faq_first_schema = false
    endif
  endfor
-%}

<article
  class="article-editorial{% unless section.settings.enable_toc %} article-editorial--no-toc{% endunless %}"
  {% if section.settings.hide_reading_progress %}
    data-hide-reading-progress
  {% endif %}
>
  <div class="article-editorial__progress motion-reduce" data-article-progress aria-hidden="true"></div>

  <nav class="article-editorial__breadcrumb page-width" aria-label="Breadcrumb">
    <ol itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ routes.root_url }}" itemprop="item"><span itemprop="name">Home</span></a>
        <meta itemprop="position" content="1">
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ blog.url }}" itemprop="item"><span itemprop="name">{{ blog.title | escape }}</span></a>
        <meta itemprop="position" content="2">
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
        <span itemprop="name">{{ article.title | truncate: 64 | escape }}</span>
        <meta itemprop="position" content="3">
      </li>
    </ol>
  </nav>

  {%- for block in section.blocks -%}
    {%- if block.type == 'featured_image' and article.image -%}
      <div
        class="article-editorial__hero article-template__hero-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
        {{ block.shopify_attributes }}
      >
        <div
          class="article-template__hero-{{ block.settings.image_height }} media"
          {% if block.settings.image_height == 'adapt' and article.image %}
            style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"
          {% endif %}
        >
          <img
            srcset="
              {% if article.image.width >= 400 %}{{ article.image | image_url: width: 400 }} 400w,{% endif %}
              {% if article.image.width >= 700 %}{{ article.image | image_url: width: 700 }} 700w,{% endif %}
              {% if article.image.width >= 1000 %}{{ article.image | image_url: width: 1000 }} 1000w,{% endif %}
              {% if article.image.width >= 1400 %}{{ article.image | image_url: width: 1400 }} 1400w,{% endif %}
              {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
              {{ article.image | image_url }} {{ article.image.width }}w
            "
            sizes="(min-width: 1200px) min(1180px, 92vw), 100vw"
            src="{{ article.image | image_url: width: 1400 }}"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
            alt="{%- if article.image.alt != blank -%}{{ article.image.alt | escape }}{%- else -%}{{ article.title | escape }}{%- endif -%}"
          >
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="article-editorial__shell" data-editorial-article>
    <div class="article-editorial__layout{% if section.settings.enable_toc == false %} article-editorial__layout--no-toc{% endif %}">
      <aside class="article-editorial__aside" aria-hidden="false">
        <nav
          class="article-editorial__toc is-empty"
          data-editorial-toc-root
          aria-label="{{ section.settings.toc_heading | escape }}"
          id="ArticleTocNav"
        >
          <h3 class="article-editorial__toc-title">{{ section.settings.toc_heading | escape }}</h3>
          <ul data-toc-list role="list"></ul>
        </nav>
      </aside>

      <div class="article-editorial__article">
        {%- assign faq_render_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="rte page-width page-width--narrow editorial-app-block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                {% render block %}
              </div>

            {%- when 'featured_image' -%}
              {% comment %} Rendered above {% endcomment %}

            {%- when 'title' -%}
              <header
                class="article-editorial__header editorial-block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
                {{ block.shopify_attributes }}
              >
                <h1 class="article-editorial__title article-template__title" id="article-heading-{{ article.id }}">
                  {{ article.title | escape }}
                </h1>
                <div class="article-editorial__byline">
                  {%- if block.settings.blog_show_date -%}
                    <span>{{ article.published_at | time_tag: format: 'date' }}</span>
                  {%- endif -%}
                  <span>{{ read_mins }} min read</span>
                  {%- if section.settings.enable_read_time_label -%}
                    <span class="visually-hidden">Estimated reading time</span>
                  {%- endif -%}
                  {%- if block.settings.blog_show_author and article.author != blank -%}
                    <span class="circle-divider caption-with-letter-spacing">{{ article.author | escape }}</span>
                  {%- endif -%}
                </div>

                {%- if section.settings.show_author_card and article.author != blank -%}
                  <aside class="article-editorial__author-block" aria-label="{{ section.settings.author_label | escape }}">
                    <p class="article-editorial__author-name">{{ article.author | escape }}</p>
                    {% if section.settings.author_role != blank %}
                      <p class="article-editorial__author-role">{{ section.settings.author_role | escape }}</p>
                    {% endif %}
                  </aside>
                {%- endif -%}
              </header>

            {%- when 'content' -%}
              <div
                class="article-template__content rte page-width page-width--narrow article-editorial__rte editorial-block {% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}"
                data-editorial-prose
                {{ block.shopify_attributes }}
              >
                {{ article.content }}
              </div>

            {%- when 'share' -%}
              {% assign share_url = request.origin | append: article.url %}
              <div
                class="article-editorial__share article-template__social-sharing editorial-block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
              >
                {% render 'share-button', block: block, share_link: share_url %}
              </div>

            {%- when 'faq_pair' -%}
              {%- if block.settings.question != blank and block.settings.answer != blank -%}
                {%- assign faq_render_index = faq_render_index | plus: 1 -%}
                <div class="article-editorial__faq-item editorial-block" {{ block.shopify_attributes }}>
                  <details
                    {% if section.settings.expand_first_faq and faq_render_index == 1 %}
                      open
                    {% endif %}
                  >
                    <summary>{{ block.settings.question | escape }}</summary>
                    <div class="rte article-editorial__faq-body">{{ block.settings.answer }}</div>
                  </details>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {% if section.settings.cta_heading != blank and section.settings.cta_url != blank %}
      <aside class="page-width editorial-cta-slot">
        <div class="article-editorial__cta">
          <h3>{{ section.settings.cta_heading | escape }}</h3>
          {% if section.settings.cta_text != blank %}
            <p>{{ section.settings.cta_text | escape }}</p>
          {% endif %}
          <a href="{{ section.settings.cta_url }}" class="button">{{ section.settings.cta_button | escape }}</a>
        </div>
      </aside>
    {% endif %}

    {% if section.settings.show_related %}
      {% assign rc = section.settings.related_count %}
      {% assign related_idx = 0 %}
      <section class="page-width article-editorial__related editorial-related" aria-labelledby="RelatedHeading-{{ section.id }}">
        <h2 class="article-editorial__related-title" id="RelatedHeading-{{ section.id }}">
          {{ section.settings.related_heading | escape }}
        </h2>
        <div class="article-editorial__related-grid">
          {% for related in blog.articles limit: 48 %}
            {% if related.id == article.id %}
              {% continue %}
            {% endif %}
            {% if related_idx >= rc %}
              {% break %}
            {% endif %}
            {% assign related_idx = related_idx | plus: 1 %}
            {% render 'article-card',
              blog: blog,
              article: related,
              media_height: section.settings.related_image_ratio,
              show_image: true,
              show_date: section.settings.related_show_date,
              show_author: false,
              show_excerpt: true,
              lazy_load: true,
              image_sizes: '(min-width: 1000px) min(340px, 28vw), (min-width: 700px) 45vw, calc(100vw - 3rem)'
            %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <div class="article-editorial__back">
      <a href="{{ blog.url }}" class="article-editorial__back-link">
        <span class="svg-wrapper" aria-hidden="true">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        {{ 'blogs.article.back_to_blog' | t: title: blog.title | escape }}
      </a>
    </div>
  </div>

  {%- if blog.comments_enabled? -%}
    <div class="article-editorial__comments article-template__comment-wrapper background-secondary">
      <div
        id="comments"
        class="page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span
                    ><span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span></label
              >
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script src="{{ 'blog-editorial.js' | asset_url }}" defer></script>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ shop.name | json }},
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ blog.title | json }},
        "item": {{ request.origin | append: blog.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ article.title | json }},
        "item": {{ request.origin | append: article.url | json }}
      }
    ]
  }
</script>

{%- if faq_entities != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {{- faq_entities -}}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_toc",
      "default": true,
      "label": "Sticky table of contents (from headings)"
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "TOC title",
      "default": "In this guide"
    },
    {
      "type": "checkbox",
      "id": "hide_reading_progress",
      "default": false,
      "label": "Hide reading progress bar"
    },
    {
      "type": "checkbox",
      "id": "show_author_card",
      "default": true,
      "label": "Show author card"
    },
    {
      "type": "text",
      "id": "author_label",
      "default": "Author",
      "label": "Author card label"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Author role line",
      "default": "Astro Pathshala — Vedic & Lal Kitab guidance"
    },
    {
      "type": "checkbox",
      "id": "enable_read_time_label",
      "default": false,
      "label": "Show screen-reader reading time label"
    },
    {
      "type": "header",
      "content": "Related posts"
    },
    {
      "type": "checkbox",
      "id": "show_related",
      "default": true,
      "label": "Show related posts"
    },
    {
      "type": "text",
      "id": "related_heading",
      "default": "Continue reading",
      "label": "Related heading"
    },
    {
      "type": "range",
      "id": "related_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of related posts"
    },
    {
      "type": "checkbox",
      "id": "related_show_date",
      "default": true,
      "label": "Show date on related cards"
    },
    {
      "type": "select",
      "id": "related_image_ratio",
      "label": "Related card image height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Book a consultation"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Personalised Vedic & Lal Kitab guidance from Astro Pathshala, Gurugram."
    },
    {
      "type": "text",
      "id": "cta_button",
      "label": "CTA button",
      "default": "View services"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "FAQ blocks"
    },
    {
      "type": "checkbox",
      "id": "expand_first_faq",
      "default": false,
      "label": "Open first FAQ by default"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "featured_image",
      "name": "t:sections.main-article.blocks.featured_image.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "image_height",
          "options": [
            {
              "value": "adapt",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__1.label"
            },
            {
              "value": "small",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__2.label"
            },
            {
              "value": "medium",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__3.label"
            },
            {
              "value": "large",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__4.label"
            }
          ],
          "default": "adapt",
          "label": "t:sections.main-article.blocks.featured_image.settings.image_height.label"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-article.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "blog_show_date",
          "default": true,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_date.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_author",
          "default": true,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_author.label"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.main-article.blocks.content.name",
      "limit": 1
    },
    {
      "type": "share",
      "name": "t:sections.main-article.blocks.share.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "t:sections.main-article.blocks.share.settings.text.label",
          "default": "t:sections.main-article.blocks.share.settings.text.default"
        }
      ]
    },
    {
      "type": "faq_pair",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ]
}
{% endschema %}
