{{ 'section-product-banners.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ProductBanners-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #ProductBanners-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if template.name == 'product' -%}
  {%- capture banner_bundle -%}
    {%- render 'product-banner-manager', debug: section.settings.debug_mode -%}
  {%- endcapture -%}
  {%- assign banner_bundle = banner_bundle | strip -%}
  {%- assign bundle_parts = banner_bundle | split: '~~~' -%}
  {%- assign banner_paths_raw = bundle_parts[0] | strip -%}
  {%- assign banner_source = bundle_parts[1] | strip -%}
  {%- assign banner_count = bundle_parts[2] | default: 0 | plus: 0 -%}

  {%- if banner_count > 0 -%}
    <section
      id="ProductBanners-{{ section.id }}"
      class="product-banners-section section-{{ section.id }}-padding"
      aria-label="{{ section.settings.accessibility_label | default: 'Product information banners' | escape }}"
      data-product-banner-section
      data-banner-source="{{ banner_source }}"
      data-banner-count="{{ banner_count }}"
    >
      {%- if section.settings.show_heading and section.settings.heading != blank -%}
        <div class="page-width product-banners-section__head">
          <h2 class="product-banners-section__title">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="product-banners-section__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- render 'product-banner-gallery',
        banner_bundle: banner_bundle,
        lazy_after: section.settings.eager_count,
        debug: section.settings.debug_mode
      -%}
    </section>
  {%- elsif section.settings.debug_mode -%}
    <!-- product-banner-debug: no banners for {{ product.handle }} bundle={{ banner_bundle | escape }} -->
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product banners (auto)",
  "tag": "section",
  "class": "section-product-dynamic-banners",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "debug_mode",
      "label": "Debug mode (HTML comments in page source)",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Product information banners"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show section heading",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product highlights"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "eager_count",
      "min": 0,
      "max": 5,
      "step": 1,
      "label": "Eager-load first images",
      "default": 1
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Product banners (auto)"
    }
  ]
}
{% endschema %}
