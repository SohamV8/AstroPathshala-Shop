{%- liquid
  assign product_title_downcase = product.title | downcase
  assign product_type_downcase = product.type | downcase
  assign product_tags_joined = product.tags | join: ',' | downcase
  assign product_lookup_text = product_title_downcase | append: ' ' | append: product_type_downcase | append: ' ' | append: product_tags_joined

  assign gem_key = 'all'
  if product_lookup_text contains 'zircon'
    assign gem_key = 'zircon'
  elsif product_lookup_text contains 'tourmaline'
    assign gem_key = 'tourmaline'
  elsif product_lookup_text contains 'tiger eye' or product_lookup_text contains 'tigereye'
    assign gem_key = 'tiger eye'
  elsif product_lookup_text contains 'sunela' or product_lookup_text contains 'citrine'
    assign gem_key = 'sunela'
  elsif product_lookup_text contains 'sulemani'
    assign gem_key = 'sulemani hakik'
  elsif product_lookup_text contains 'peridot'
    assign gem_key = 'peridot'
  elsif product_lookup_text contains 'moonstone'
    assign gem_key = 'moonstone'
  elsif product_lookup_text contains 'mahe mariam'
    assign gem_key = 'mahe mariam'
  elsif product_lookup_text contains 'lapis'
    assign gem_key = 'lapis lazuli'
  elsif product_lookup_text contains 'kaka neeli'
    assign gem_key = 'kaka neeli'
  elsif product_lookup_text contains 'firoza' or product_lookup_text contains 'turquoise'
    assign gem_key = 'firoza'
  elsif product_lookup_text contains 'amethyst'
    assign gem_key = 'amethyst'
  endif
-%}

<section
  id="GemsFaq-{{ section.id }}"
  class="gems-faq section-{{ section.id }}"
  style="
    --faq-bg: {{ section.settings.background_color }};
    --faq-card-bg: {{ section.settings.card_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-muted: {{ section.settings.muted_text_color }};
    --faq-accent: {{ section.settings.accent_color }};
    --faq-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="gems-faq__container page-width">
    <div class="gems-faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gems-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="gems-faq__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="gems-faq__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="gems-faq__accordion" role="list">
      {%- assign rendered_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign show_block = true -%}
        {%- if block.settings.gemstone != 'all' -%}
          {%- assign show_block = false -%}
          {%- assign gemstone_key = block.settings.gemstone | downcase -%}
          {%- if product_title_downcase contains gemstone_key or product_type_downcase contains gemstone_key or product_tags_joined contains gemstone_key -%}
            {%- assign show_block = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if show_block -%}
          <details
            class="gems-faq__item"
            {% if forloop.first and section.settings.first_open %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="gems-faq__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="gems-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="gems-faq__answer rte">
              {{ block.settings.answer }}
            </div>
          </details>
          {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if rendered_count == 0 -%}
        {%- case gem_key -%}
          {%- when 'zircon' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}>
              <summary class="gems-faq__question"><span>What are the benefits of Zircon stone for love and wealth?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary>
              <div class="gems-faq__answer rte"><p>Zircon is known for its astrological and spiritual significance. It is often worn to support relationship harmony, positivity, confidence, and financial growth through Venus-related energy.</p></div>
            </details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Zircon stone help attract love?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Many people wear Zircon for love attraction because it is believed to improve emotional bonding, romance, charm, and relationship balance.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Does Zircon stone attract money and success?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Zircon is associated with prosperity and opportunities in Vedic traditions, and is commonly chosen by people seeking abundance and material comfort.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>What is the best day to wear a Zircon stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Friday is generally considered the best day for wearing Zircon, often after cleansing and spiritual preparation.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How long does Zircon stone take to show results?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Results vary by individual. Some people notice changes in a few weeks, while others experience gradual shifts over time.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I identify an original Zircon stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>An original Zircon typically has natural brilliance and subtle unique characteristics. Always buy from a trusted source.</p></div></details>
          {%- when 'tourmaline' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>What are the benefits of Tourmaline stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Tourmaline is valued for emotional protection, energetic cleansing, focus, and spiritual grounding in daily life.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>What is Tourmaline stone used for?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>People commonly use Tourmaline for protection from negativity, mental calmness, and positive energy support.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Tourmaline protect from negative energy?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Yes, Tourmaline is widely considered a protection stone and is often used as a shield against stress and unwanted emotional influence.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Who should wear Tourmaline stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>It is commonly preferred by people seeking emotional balance, stress relief, confidence, and cleaner personal energy.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How long does Tourmaline take to show results?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Some users feel calmness quickly, while others report gradual improvements over time.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I know if Tourmaline is original?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Original Tourmaline usually shows natural color variation and texture. Buy from a reliable seller for authenticity.</p></div></details>
          {%- when 'tiger eye' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>Can Tiger Eye stone attract success and money?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Tiger Eye is often used for confidence, focus, and decision-making, which many people connect to career and financial progress.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How does Tiger Eye help with focus?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>It is associated with concentration and mental clarity, helping reduce distractions and improve productivity.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Is Tiger Eye good for emotional balance?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Many people use Tiger Eye to stabilize emotions and build inner strength during stressful phases.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Tiger Eye protect from negative energy?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Tiger Eye is commonly carried as a grounding and protective crystal against negative thoughts and emotional heaviness.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Tiger Eye be worn every day?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Yes, Tiger Eye jewelry is generally durable and suitable for regular wear.</p></div></details>
          {%- when 'sunela' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>Why is Citrine called the "wealth and success crystal"?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Citrine is popularly associated with abundance, prosperity, motivation, and opportunities for growth.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>What are the benefits of Citrine stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Citrine is often linked to confidence, positivity, creativity, emotional balance, and a success-oriented mindset.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Citrine attract money and financial growth?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Many people use Citrine as a money-attraction crystal connected to optimism and purposeful action.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I identify original Citrine stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Original Citrine generally has warm yellow to golden tones with natural clarity variations and texture differences.</p></div></details>
          {%- when 'sulemani hakik' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>What are the benefits of Sulemani Hakik stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Sulemani Hakik is commonly worn for Rahu Shanti, Nazar protection, emotional balance, and spiritual grounding.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Sulemani Hakik protect from Nazar (evil eye)?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Yes, it is widely considered an evil-eye protection stone in traditional spiritual practices.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Sulemani Hakik remove negative energy?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Many users choose Sulemani Hakik to reduce negativity, emotional instability, and overthinking.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I know if Sulemani Hakik is original?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Original stones usually show natural layered patterns and authentic texture variations.</p></div></details>
          {%- when 'peridot' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>What makes Peridot different from other gemstones?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Peridot is often linked with mental freshness, clarity, and renewed motivation for forward movement in life.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Is Peridot useful for career growth?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Many professionals and entrepreneurs choose Peridot for confidence, focus, and goal-driven energy.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Peridot help with overthinking?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Peridot is often used for mental clarity and calmer decision-making when thoughts feel cluttered.</p></div></details>
          {%- when 'moonstone' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>What are the benefits of Moonstone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Moonstone is linked to emotional healing, calmness, intuition, positivity, and inner peace.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Moonstone help with emotional balance?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Many wearers use Moonstone to ease emotional ups and downs and reduce overthinking.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I identify original Moonstone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Original Moonstone often shows natural shimmer or flash with unique surface variation.</p></div></details>
          {%- when 'mahe mariam' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>What makes Mahe Mariam special?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Mahe Mariam is often chosen for emotional release, self-healing, and greater inner clarity.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Is Mahe Mariam good for emotional stability?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Yes, many users prefer it for emotional grounding and calmer daily routines.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I identify original Mahe Mariam stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Original pieces usually carry natural textures, patterns, and color differences that feel unique.</p></div></details>
          {%- when 'lapis lazuli' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>How can Lapis Lazuli help in daily life?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Lapis Lazuli is associated with confidence, communication, mental clarity, and intuitive decision-making.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Why is Lapis Lazuli popular among professionals?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Writers, students, and professionals often use it to support focus, communication, and creative thinking.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I identify original Lapis Lazuli?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Original Lapis Lazuli usually has rich royal-blue tones with natural golden or white mineral patterns.</p></div></details>
          {%- when 'kaka neeli' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>Why are people curious about Kaka Neeli stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>It is often associated with protection, positivity, emotional support, and energetic balance.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Can Kaka Neeli protect from negativity?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Traditional belief connects Kaka Neeli with reducing negative influence and improving calmness.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>Is Kaka Neeli suitable for daily use?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Yes, many users include it in daily life as a reminder of strength, stability, and positivity.</p></div></details>
          {%- when 'firoza' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>Why do many people wear Firoza stone?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Firoza is often worn for positivity, protection, confidence, and emotional balance in everyday life.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How can Firoza be used daily?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>You can wear Firoza as jewelry or keep it near a workspace or meditation area for uplifting energy.</p></div></details>
            <details class="gems-faq__item"><summary class="gems-faq__question"><span>How do I identify original Firoza?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Original Firoza typically has natural sky-blue or green-blue shades with visible natural variation.</p></div></details>
          {%- when 'amethyst' -%}
            <details class="gems-faq__item" {% if section.settings.first_open %}open{% endif %}><summary class="gems-faq__question"><span>Why is Amethyst one of the most loved healing stones?</span><span class="gems-faq__icon" aria-hidden="true"></span></summary><div class="gems-faq__answer rte"><p>Amethyst is known for calming energy and is often used to support mindfulness, emotional balance, and peace.</p></div></details>
