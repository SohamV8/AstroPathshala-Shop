{% stylesheet %}
  .gems-faq {
    background: var(--faq-bg);
    color: var(--faq-text);
    padding: clamp(48px, 7vw, 110px) 0;
  }

  .gems-faq__container {
    max-width: 900px;
    margin: 0 auto;
  }

  .gems-faq__header {
    text-align: center;
    margin-bottom: clamp(24px, 4.8vw, 44px);
  }

  .gems-faq__eyebrow {
    margin: 0 0 10px;
    color: var(--faq-accent);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .gems-faq__heading {
    margin: 0;
    font-size: clamp(1.55rem, 3.2vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .gems-faq__subheading {
    margin: 14px auto 0;
    max-width: 660px;
    color: var(--faq-muted);
    font-size: clamp(0.96rem, 1.6vw, 1.06rem);
    line-height: 1.68;
    letter-spacing: -0.01em;
  }

  .gems-faq__accordion {
    display: grid;
    gap: 10px;
  }

  .gems-faq__item {
    border-radius: var(--faq-radius);
    border: 1px solid color-mix(in srgb, var(--faq-text) 10%, transparent);
    background: var(--faq-card-bg);
    box-shadow: 0 2px 8px rgba(17, 24, 39, 0.03);
    overflow: hidden;
    transition: border-color 0.28s ease, box-shadow 0.28s ease, background-color 0.28s ease;
  }

  .gems-faq__item:hover {
    border-color: color-mix(in srgb, var(--faq-accent) 22%, transparent);
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.06);
  }

  .gems-faq__item[open] {
    border-color: color-mix(in srgb, var(--faq-accent) 26%, transparent);
    box-shadow: 0 10px 26px rgba(17, 24, 39, 0.07);
  }

  .gems-faq__question {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    width: 100%;
    padding: clamp(15px, 2.2vw, 21px) clamp(16px, 2.4vw, 24px);
    font-size: clamp(0.98rem, 1.3vw, 1.07rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .gems-faq__question::-webkit-details-marker {
    display: none;
  }

  .gems-faq__icon {
    position: relative;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--faq-text) 22%, transparent);
    transition: border-color 0.24s ease, background-color 0.24s ease;
  }

  .gems-faq__icon::before,
  .gems-faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 1.4px;
    border-radius: 2px;
    background: var(--faq-accent);
    transform: translate(-50%, -50%);
    transition: transform 0.26s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gems-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .gems-faq__item[open] .gems-faq__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .gems-faq__item[open] .gems-faq__icon {
    border-color: color-mix(in srgb, var(--faq-accent) 35%, transparent);
    background: color-mix(in srgb, var(--faq-accent) 7%, transparent);
  }

  .gems-faq__answer {
    color: var(--faq-muted);
    line-height: 1.72;
    font-size: 0.95rem;
    letter-spacing: -0.005em;
    padding: 0 clamp(16px, 2.4vw, 24px) clamp(16px, 2.4vw, 22px);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.34s ease, transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gems-faq__item[open] .gems-faq__answer {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (max-width: 749px) {
    .gems-faq {
      padding: 38px 0 52px;
    }

    .gems-faq__accordion {
      gap: 9px;
    }

    .gems-faq__question {
      padding: 14px 15px;
    }

    .gems-faq__answer {
      padding: 0 15px 15px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const sections = document.querySelectorAll('.gems-faq');
    sections.forEach((section) => {
      const items = section.querySelectorAll('.gems-faq__item');

      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          items.forEach((other) => {
            if (other !== item) other.open = false;
          });
        });
      });
    });
  })();
{% endjavascript %}

